        // Load danh sách nhân viên cho lịch làm việc
        function loadEmployeesForSchedule() {
            $.get('@Url.Action("GetAvailableEmployees", "VehicleShift", new { area = "Admin" })', 
                function(data) {
                    let options = '<option value="">-- Tất cả nhân viên --</option>';
                    let addOptions = '<option value="">-- Chọn nhân viên --</option>';
                    
                    data.forEach(emp => {
                        options += `<option value="${emp.maNhanVien}">${emp.hoTen} - ${emp.chucVu}</option>`;
                        addOptions += `<option value="${emp.maNhanVien}">${emp.hoTen} - ${emp.chucVu}</option>`;
                    });
                    
                    $('#scheduleEmployeeFilter').html(options);
