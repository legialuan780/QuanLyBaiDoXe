@model QuanLyBaiDoXe.Areas.Admin.ViewModels.VehicleMoneyViewModel
@{
    ViewData["Title"] = ViewBag.PageTitle;
}

@section Styles {
    <link rel="stylesheet" href="~/css/vehicle-money.css" />
}

<!-- Page Header -->
<div class="page-header">
    <div>
        <h1 class="page-title">@ViewBag.PageTitle</h1>
        <div class="breadcrumb">
            <a href="#">Trang chủ</a>
            <span>/</span>
            <span>Báo cáo doanh thu</span>
            <span>/</span>
            <span>Theo ngày</span>
        </div>
    </div>
    <div>
        <button class="btn-secondary-admin" onclick="window.location.reload()">
            <i class="fas fa-sync-alt"></i>
            Làm mới
        </button>
        <button class="btn-primary-admin" onclick="window.print()">
            <i class="fas fa-print"></i>
            In báo cáo
        </button>
    </div>
</div>

<!-- Filter Section -->
<div class="admin-card mb-3">
    <div class="admin-card-body">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-6">
                <label for="ngay" class="form-label">Chọn ngày</label>
                <input type="date" class="form-control" id="ngay" name="ngay" value="@ViewBag.SelectedDate">
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn-primary-admin w-100">
                    <i class="fas fa-search"></i>
                    Xem báo cáo
                </button>
            </div>
            <div class="col-md-3">
                <button type="button" class="btn-secondary-admin w-100" onclick="location.href='@Url.Action("Daily", new { ngay = DateTime.Now.ToString("yyyy-MM-dd") })'">
                    <i class="fas fa-calendar-day"></i>
                    Hôm nay
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Stat Cards -->
<div class="stat-cards mb-4">
    <div class="stat-card">
        <div class="stat-card-icon teal">
            <i class="fas fa-dollar-sign"></i>
        </div>
        <div class="stat-card-info">
            <h3>@Model.TongDoanhThu.ToString("N0") đ</h3>
            <p>Tổng doanh thu</p>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-card-icon green">
            <i class="fas fa-car"></i>
        </div>
        <div class="stat-card-info">
            <h3>@Model.DoanhThuLuotGui.ToString("N0") đ</h3>
            <p>Lượt gửi xe (@Model.TongLuotGui lượt)</p>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-card-icon orange">
            <i class="fas fa-id-card"></i>
        </div>
        <div class="stat-card-info">
            <h3>@Model.DoanhThuTheThang.ToString("N0") đ</h3>
            <p>Thẻ tháng (@Model.TongTheThang thẻ)</p>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-card-icon blue">
            <i class="fas fa-percentage"></i>
        </div>
        <div class="stat-card-info">
            <h3>@((Model.TongDoanhThu > 0 ? (Model.DoanhThuLuotGui / Model.TongDoanhThu * 100) : 0).ToString("N1"))%</h3>
            <p>Tỷ lệ lượt gửi</p>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="admin-card">
            <div class="admin-card-header">
                <h3 class="admin-card-title">
                    <i class="fas fa-chart-pie"></i>
                    Chi tiết doanh thu ngày @DateTime.Parse(ViewBag.SelectedDate).ToString("dd/MM/yyyy")
                </h3>
            </div>
            <div class="admin-card-body">
                <div class="row">
                    <div class="col-md-6">
                        <div class="p-3 border-end">
                            <h5 class="mb-3"><i class="fas fa-car text-primary"></i> Lượt gửi xe</h5>
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span>Số lượt:</span>
                                <strong class="text-primary">@Model.TongLuotGui lượt</strong>
                            </div>
                            <div class="d-flex justify-content-between align-items-center">
                                <span>Doanh thu:</span>
                                <strong class="text-success">@Model.DoanhThuLuotGui.ToString("N0") đ</strong>
                            </div>
                            <div class="mt-3">
                                <small class="text-muted">
                                    Trung bình: @((Model.TongLuotGui > 0 ? Model.DoanhThuLuotGui / Model.TongLuotGui : 0).ToString("N0")) đ/lượt
                                </small>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="p-3">
                            <h5 class="mb-3"><i class="fas fa-id-card text-warning"></i> Thẻ tháng</h5>
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span>Số thẻ đăng ký:</span>
                                <strong class="text-warning">@Model.TongTheThang thẻ</strong>
                            </div>
                            <div class="d-flex justify-content-between align-items-center">
                                <span>Doanh thu:</span>
                                <strong class="text-success">@Model.DoanhThuTheThang.ToString("N0") đ</strong>
                            </div>
                            <div class="mt-3">
                                <small class="text-muted">
                                    Trung bình: @((Model.TongTheThang > 0 ? Model.DoanhThuTheThang / Model.TongTheThang : 0).ToString("N0")) đ/thẻ
                                </small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Quick date selection
        document.addEventListener('DOMContentLoaded', function() {
            const dateInput = document.getElementById('ngay');
            
            // Format date to yyyy-MM-dd
            const formatDate = (date) => {
                return date.toISOString().split('T')[0];
            };
        });
    </script>
}
