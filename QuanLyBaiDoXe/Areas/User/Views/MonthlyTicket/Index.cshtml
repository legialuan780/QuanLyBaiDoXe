@model IEnumerable<QuanLyBaiDoXe.Models.Entities.TheThang>
@{
    ViewData["Title"] = "Thẻ tháng của tôi";
    Layout = "~/Areas/User/Views/Shared/_UserLayout.cshtml";
}

@section Styles {
<style>
    .page-header {
        margin-bottom: 30px;
    }

    .page-title {
        font-size: 32px;
        font-weight: 700;
        color: #1a202c;
        margin-bottom: 8px;
    }

    .page-subtitle {
        color: #718096;
        font-size: 16px;
    }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 20px;
        margin-bottom: 30px;
    }

    .stat-card {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border-radius: 12px;
        padding: 24px;
        color: white;
        box-shadow: 0 4px 6px rgba(102, 126, 234, 0.25);
        transition: transform 0.3s ease;
    }

    .stat-card:hover {
        transform: translateY(-5px);
    }

    .stat-card.success {
        background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
    }

    .stat-card.warning {
        background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
    }

    .stat-card.info {
        background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);
    }

    .stat-icon {
        font-size: 36px;
        margin-bottom: 12px;
        opacity: 0.9;
    }

    .stat-label {
        font-size: 14px;
        opacity: 0.9;
        margin-bottom: 8px;
    }

    .stat-value {
        font-size: 32px;
        font-weight: 700;
    }

    .action-buttons {
        display: flex;
        gap: 12px;
        margin-bottom: 30px;
    }

    .btn-custom {
        padding: 12px 24px;
        border-radius: 8px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: all 0.3s;
        border: none;
    }

    .btn-primary-custom {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
    }

    .btn-primary-custom:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(102, 126, 234, 0.4);
    }

    .tickets-grid {
        display: grid;
        gap: 20px;
    }

    .ticket-card {
        background: white;
        border-radius: 12px;
        padding: 24px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
        border-left: 4px solid #667eea;
        transition: all 0.3s;
    }

    .ticket-card:hover {
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.12);
        transform: translateY(-2px);
    }

    .ticket-card.expired {
        border-left-color: #e53e3e;
        opacity: 0.7;
    }

    .ticket-card.active {
        border-left-color: #48bb78;
    }

    .ticket-header {
        display: flex;
        justify-content: space-between;
        align-items: start;
        margin-bottom: 20px;
    }

    .ticket-info {
        flex: 1;
    }

    .ticket-status {
        padding: 6px 16px;
        border-radius: 20px;
        font-size: 13px;
        font-weight: 600;
    }

    .status-active {
        background: #c6f6d5;
        color: #22543d;
    }

    .status-expired {
        background: #fed7d7;
        color: #742a2a;
    }

    .ticket-id {
        font-size: 24px;
        font-weight: 700;
        color: #1a202c;
        margin-bottom: 8px;
        font-family: 'Courier New', monospace;
    }

    .ticket-type {
        color: #718096;
        font-size: 14px;
        margin-bottom: 4px;
    }

    .ticket-details {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 16px;
        margin-top: 20px;
        padding-top: 20px;
        border-top: 1px solid #e2e8f0;
    }

    .detail-item {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .detail-icon {
        width: 40px;
        height: 40px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
    }

    .detail-icon.blue {
        background: #ebf8ff;
        color: #2b6cb0;
    }

    .detail-icon.green {
        background: #c6f6d5;
        color: #22543d;
    }

    .detail-icon.purple {
        background: #e9d8fd;
        color: #553c9a;
    }

    .detail-icon.red {
        background: #fed7d7;
        color: #c53030;
    }

    .detail-icon.yellow {
        background: #fef5e7;
        color: #d69e2e;
    }

    .detail-content {
        flex: 1;
    }

    .detail-label {
        font-size: 12px;
        color: #718096;
        margin-bottom: 2px;
    }

    .detail-value {
        font-size: 14px;
        font-weight: 600;
        color: #1a202c;
    }

    .empty-state {
        text-align: center;
        padding: 60px 20px;
        background: white;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    }

    .empty-icon {
        font-size: 64px;
        color: #cbd5e0;
        margin-bottom: 20px;
    }

    .empty-title {
        font-size: 20px;
        font-weight: 600;
        color: #2d3748;
        margin-bottom: 12px;
    }

    .empty-subtitle {
        color: #718096;
        margin-bottom: 24px;
    }

    .ticket-actions {
        display: flex;
        gap: 8px;
        margin-top: 16px;
        padding-top: 16px;
        border-top: 1px solid #e2e8f0;
    }

    .btn-action {
        padding: 8px 16px;
        border-radius: 6px;
        font-size: 13px;
        font-weight: 600;
        border: none;
        cursor: pointer;
        transition: all 0.3s;
    }

    .btn-extend {
        background: #4299e1;
        color: white;
    }

    .btn-extend:hover {
        background: #3182ce;
    }

    .btn-details {
        background: #edf2f7;
        color: #2d3748;
    }

    .btn-details:hover {
        background: #e2e8f0;
    }

    .card-custom {
        background: white;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
        padding: 24px;
        margin-bottom: 24px;
    }

    .card-header-custom {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
    }

    .card-title-custom {
        font-size: 20px;
        font-weight: 700;
        color: #1a202c;
        display: flex;
        align-items: center;
        gap: 8px;
        margin: 0;
    }
</style>
}

<div class="page-header">
    <h1 class="page-title">Thẻ tháng của tôi</h1>
    <p class="page-subtitle">Quản lý thẻ gửi xe tháng của bạn</p>
</div>

<!-- Statistics -->
<div class="stats-grid">
    <div class="stat-card success">
        <div class="stat-icon">
            <i class="fas fa-check-circle"></i>
        </div>
        <div class="stat-label">Thẻ đang hoạt động</div>
        <div class="stat-value">@Model.Count(t => t.TrangThai == true && t.NgayHetHan >= DateOnly.FromDateTime(DateTime.Now))</div>
    </div>
    <div class="stat-card warning">
        <div class="stat-icon">
            <i class="fas fa-clock"></i>
        </div>
        <div class="stat-label">Thẻ hết hạn</div>
        <div class="stat-value">@Model.Count(t => t.NgayHetHan < DateOnly.FromDateTime(DateTime.Now))</div>
    </div>
    <div class="stat-card info">
        <div class="stat-icon">
            <i class="fas fa-ticket-alt"></i>
        </div>
        <div class="stat-label">Tổng số thẻ</div>
        <div class="stat-value">@Model.Count()</div>
    </div>
</div>

<!-- Action Buttons -->
<div class="action-buttons">
    <button class="btn btn-custom btn-primary-custom" onclick="showRegisterModal()">
        <i class="fas fa-plus"></i>
        Đăng ký thẻ mới
    </button>
</div>

<!-- Tickets List -->
@if (Model.Any())
{
    <div class="card-custom">
        <div class="card-header-custom">
            <h5 class="card-title-custom">
                <i class="fas fa-list"></i>
                Danh sách thẻ tháng
            </h5>
        </div>
        <div class="tickets-grid">
            @foreach (var ticket in Model)
            {
                var isExpired = ticket.NgayHetHan < DateOnly.FromDateTime(DateTime.Now);
                var daysRemaining = (ticket.NgayHetHan!.Value.ToDateTime(TimeOnly.MinValue) - DateTime.Now).Days;
                
                <div class="ticket-card @(isExpired ? "expired" : "active")">
                    <div class="ticket-header">
                        <div class="ticket-info">
                            <div class="ticket-id">@ticket.MaThe</div>
                            <div class="ticket-type">
                                <i class="fas fa-car"></i>
                                @ticket.MaTheNavigation?.MaLoaiXeNavigation?.TenLoaiXe
                            </div>
                        </div>
                        <span class="ticket-status @(isExpired ? "status-expired" : "status-active")">
                            @(isExpired ? "Hết hạn" : "Đang hoạt động")
                        </span>
                    </div>

                    <div class="ticket-details">
                        <div class="detail-item">
                            <div class="detail-icon green">
                                <i class="fas fa-calendar-plus"></i>
                            </div>
                            <div class="detail-content">
                                <div class="detail-label">Ngày bắt đầu</div>
                                <div class="detail-value">@ticket.NgayBatDau?.ToString("dd/MM/yyyy")</div>
                            </div>
                        </div>
                        <div class="detail-item">
                            <div class="detail-icon @(isExpired ? "red" : "blue")">
                                <i class="fas fa-calendar-times"></i>
                            </div>
                            <div class="detail-content">
                                <div class="detail-label">Ngày hết hạn</div>
                                <div class="detail-value">@ticket.NgayHetHan?.ToString("dd/MM/yyyy")</div>
                            </div>
                        </div>
                        <div class="detail-item">
                            <div class="detail-icon purple">
                                <i class="fas fa-money-bill-wave"></i>
                            </div>
                            <div class="detail-content">
                                <div class="detail-label">Số tiền đóng</div>
                                <div class="detail-value">@ticket.SoTienDong?.ToString("N0") VNĐ</div>
                            </div>
                        </div>
                        @if (!isExpired)
                        {
                            <div class="detail-item">
                                <div class="detail-icon yellow">
                                    <i class="fas fa-hourglass-half"></i>
                                </div>
                                <div class="detail-content">
                                    <div class="detail-label">Còn lại</div>
                                    <div class="detail-value">@daysRemaining ngày</div>
                                </div>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(ticket.BienSoXe))
                        {
                            <div class="detail-item">
                                <div class="detail-icon blue">
                                    <i class="fas fa-car"></i>
                                </div>
                                <div class="detail-content">
                                    <div class="detail-label">Biển số xe</div>
                                    <div class="detail-value">@ticket.BienSoXe</div>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="ticket-actions">
                        @if (!isExpired)
                        {
                            <button class="btn-action btn-extend" onclick="extendTicket(@ticket.MaTheThang)">
                                <i class="fas fa-sync-alt"></i> Gia hạn
                            </button>
                        }
                        <button class="btn-action btn-details" onclick="viewHistory(@ticket.MaTheThang)">
                            <i class="fas fa-history"></i> Lịch sử
                        </button>
                    </div>
                </div>
            }
        </div>
    </div>
}
else
{
    <div class="empty-state">
        <div class="empty-icon">
            <i class="fas fa-ticket-alt"></i>
        </div>
        <div class="empty-title">Chưa có thẻ tháng nào</div>
        <div class="empty-subtitle">Bạn chưa đăng ký thẻ tháng. Hãy đăng ký ngay để tiết kiệm chi phí!</div>
        <button class="btn btn-custom btn-primary-custom" onclick="showRegisterModal()">
            <i class="fas fa-plus"></i>
            Đăng ký thẻ tháng ngay
        </button>
    </div>
}

<!-- Register Modal -->
<div class="modal fade" id="registerModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="fas fa-ticket-alt text-primary me-2"></i>
                    Đăng ký thẻ tháng
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="registerForm">
                    <div class="mb-3">
                        <label class="form-label">Chọn loại thẻ</label>
                        <select class="form-select" id="cardSelect" required>
                            <option value="">-- Chọn loại thẻ --</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Số tháng đăng ký</label>
                        <input type="number" class="form-control" id="monthCount" min="1" max="12" value="1" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Biển số xe (Tùy chọn)</label>
                        <input type="text" class="form-control" id="licensePlate" placeholder="VD: 29A-12345">
                    </div>
                    <div id="priceInfo" class="alert alert-info" style="display: none;">
                        <strong>Tổng tiền:</strong> <span id="totalPrice">0</span> VNĐ
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-primary" onclick="registerTicket()">
                    <i class="fas fa-check"></i> Đăng ký
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    let availableCards = [];

    $(document).ready(function() {
        loadAvailableCards();

        $('#cardSelect, #monthCount').on('change', updatePriceInfo);
    });

    function loadAvailableCards() {
        $.ajax({
            url: '@Url.Action("GetAvailableCards", "MonthlyTicket", new { area = "User" })',
            type: 'GET',
            success: function(response) {
                if (response.success) {
                    availableCards = response.data;
                    const select = $('#cardSelect');
                    select.empty();
                    select.append('<option value="">-- Chọn loại thẻ --</option>');
                    
                    response.data.forEach(card => {
                        select.append(`
                            <option value="${card.maThe}" data-price="${card.giaThang}">
                                ${card.tenLoaiXe} - ${card.giaThang.toLocaleString('vi-VN')} VNĐ/tháng
                            </option>
                        `);
                    });
                }
            },
            error: function() {
                Swal.fire('Lỗi!', 'Không thể tải danh sách thẻ', 'error');
            }
        });
    }

    function updatePriceInfo() {
        const selectedCard = $('#cardSelect option:selected');
        const monthCount = parseInt($('#monthCount').val()) || 1;
        const pricePerMonth = parseFloat(selectedCard.data('price')) || 0;
        
        if (pricePerMonth > 0) {
            const totalPrice = pricePerMonth * monthCount;
            $('#totalPrice').text(totalPrice.toLocaleString('vi-VN'));
            $('#priceInfo').show();
        } else {
            $('#priceInfo').hide();
        }
    }

    function showRegisterModal() {
        $('#registerModal').modal('show');
    }

    function registerTicket() {
        const maThe = $('#cardSelect').val();
        const soThang = parseInt($('#monthCount').val());
        const bienSoXe = $('#licensePlate').val();

        if (!maThe) {
            Swal.fire('Cảnh báo!', 'Vui lòng chọn loại thẻ', 'warning');
            return;
        }

        if (soThang < 1 || soThang > 12) {
            Swal.fire('Cảnh báo!', 'Số tháng phải từ 1 đến 12', 'warning');
            return;
        }

        $.ajax({
            url: '@Url.Action("Register", "MonthlyTicket", new { area = "User" })',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify({
                maThe: maThe,
                soThang: soThang,
                bienSoXe: bienSoXe
            }),
            success: function(response) {
                if (response.success) {
                    Swal.fire({
                        icon: 'success',
                        title: 'Thành công!',
                        text: response.message,
                        showConfirmButton: false,
                        timer: 1500
                    }).then(() => {
                        location.reload();
                    });
                    $('#registerModal').modal('hide');
                } else {
                    Swal.fire('Lỗi!', response.message, 'error');
                }
            },
            error: function() {
                Swal.fire('Lỗi!', 'Có lỗi xảy ra, vui lòng thử lại', 'error');
            }
        });
    }

    function extendTicket(maTheThang) {
        Swal.fire({
            title: 'Gia hạn thẻ tháng',
            html: '<input id="extendMonths" type="number" class="swal2-input" placeholder="Số tháng gia hạn" min="1" max="12" value="1">',
            showCancelButton: true,
            confirmButtonText: 'Gia hạn',
            cancelButtonText: 'Hủy',
            preConfirm: () => {
                const months = document.getElementById('extendMonths').value;
                if (!months || months < 1 || months > 12) {
                    Swal.showValidationMessage('Số tháng phải từ 1 đến 12');
                }
                return months;
            }
        }).then((result) => {
            if (result.isConfirmed) {
                // TODO: Implement extend functionality
                Swal.fire('Thông báo', 'Chức năng đang được phát triển', 'info');
            }
        });
    }

    function viewHistory(maTheThang) {
        // TODO: Implement view history functionality
        Swal.fire('Thông báo', 'Chức năng đang được phát triển', 'info');
    }
</script>
}
