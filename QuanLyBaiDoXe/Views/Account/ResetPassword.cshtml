@model QuanLyBaiDoXe.ViewModels.ResetPasswordViewModel
@{
    ViewData["Title"] = "Đặt lại mật khẩu";
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/login.css" />
</head>
<body>
    <div class="login-wrapper">
        <div class="login-left">
            <div class="overlay">
            </div>
        </div>
        <div class="login-right">
            <div class="content">
                <div class="text-center mb-4">
                    <i class="fas fa-check-circle fa-3x text-success"></i>
                </div>
                <h2 class="welcome">Đặt lại mật khẩu</h2>
                <p class="hint">Xác thực thành công! Nhập mật khẩu mới cho tài khoản</p>

                <div class="alert alert-success mb-3">
                    <i class="fas fa-envelope me-2"></i>
                    Tài khoản: <strong>@Model.Email</strong>
                </div>

                <form asp-action="ResetPassword" asp-controller="Account" method="post" class="login-form">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Token" />
                    <input type="hidden" asp-for="Email" />
                    
                    <div class="mb-3">
                        <label class="form-label">Mật khẩu mới</label>
                        <div class="input d-flex align-items-center">
                            <span class="icon">🔒</span>
                            <input asp-for="NewPassword" class="form-control border-0" type="password" placeholder="Nhập mật khẩu mới" autofocus />
                        </div>
                        <span asp-validation-for="NewPassword" class="text-danger"></span>
                        <small class="text-muted">Mật khẩu phải có ít nhất 6 ký tự</small>
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label">Xác nhận mật khẩu</label>
                        <div class="input d-flex align-items-center">
                            <span class="icon">🔒</span>
                            <input asp-for="ConfirmPassword" class="form-control border-0" type="password" placeholder="Nhập lại mật khẩu mới" />
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                    </div>
                    
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="fas fa-save me-2"></i>Đặt lại mật khẩu
                    </button>

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger mt-3" role="alert">
                            @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                            {
                                <div>@err.ErrorMessage</div>
                            }
                        </div>
                    }
                </form>

                <div class="text-center mt-3">
                    <small class="text-muted">
                        Hệ thống Quản lý Bãi Đỗ Xe - &copy; 2024
                    </small>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
