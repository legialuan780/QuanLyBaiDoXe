    // ===== QUẦY TÍNH TIỀN - REAL-TIME STATUS =====
    
    // Lấy data từ server-side (ViewBag)
    const serverCountersData = @Html.Raw(Json.Serialize(ViewBag.CountersStatus ?? new List<object>()));
    
    // Load trạng thái quầy từ server data
    function loadCountersStatus() {
        console.log('Loading counters status from server data...');
        
        if (!serverCountersData || serverCountersData.length === 0) {
            console.log('No server data - fetching from API...');
            fetchCountersStatusFromAPI();
            return;
        }
        
        console.log('Server Data:', serverCountersData);
        
        // Render từ server data
        serverCountersData.forEach(counterData => {
            console.log(`Rendering counter ${counterData.counter}:`, counterData);
            updateCounterDisplay({
                counter: counterData.counter,
                isActive: counterData.isActive,
                employee: counterData.isActive ? {
                    hoTen: counterData.employeeName,
                    maNhanVienFormatted: counterData.employeeCode
                } : null,
                shift: counterData.isActive ? {
                    soGioLam: counterData.shiftHours
                } : null,
                revenue: counterData.revenue,
                revenueFormatted: counterData.revenueFormatted
            });
        });
    }
    
    // Fallback: Fetch từ API nếu không có server data
    function fetchCountersStatusFromAPI() {
        fetch('@Url.Action("GetAllCountersStatus", "VehicleShift", new { area = "Admin" })')
            .then(response => response.json())
            .then(data => {
                console.log('API Response:', data);
                
                if (data.success && data.data && data.data.length > 0) {
                    data.data.forEach(counterData => {
                        updateCounterDisplay(counterData);
                    });
                } else {
                    // Không có data - hiển thị tất cả quầy ĐÓNG
                    for (let i = 1; i <= 3; i++) {
                        updateCounterDisplay({
                            counter: i,
                            isActive: false,
                            employee: null,
                            shift: null,
                            revenue: 0,
                            revenueFormatted: '0 VNĐ'
                        });
                    }
                }
            })
            .catch(error => {
                console.error('Error fetching counters status:', error);
                // Nếu API lỗi - hiển thị tất cả quầy ĐÓNG
                for (let i = 1; i <= 3; i++) {
                    updateCounterDisplay({
                        counter: i,
                        isActive: false,
                        employee: null,
                        shift: null,
                        revenue: 0,
                        revenueFormatted: '0 VNĐ'
                    });
                }
            });
    }

    // Cập nhật hiển thị quầy
    function updateCounterDisplay(counterData) {
        const counterId = counterData.counter;
        
        // Lấy các elements
        const staffElement = document.getElementById(`counter-${counterId}-staff`);
        const revenueElement = document.getElementById(`counter-${counterId}-revenue`);
        const iconElement = document.getElementById(`counter-${counterId}-icon`);
        const indicatorElement = document.getElementById(`counter-${counterId}-indicator`);
        const textElement = document.getElementById(`counter-${counterId}-text`);
        const buttonElement = document.getElementById(`btn-counter-${counterId}`);
        const shiftInfoElement = document.getElementById(`shift-info-${counterId}`);
        const advancedActionsElement = document.getElementById(`advanced-actions-${counterId}`);

        if (counterData.isActive && counterData.employee) {
            // Quầy đang hoạt động
            iconElement.className = 'counter-icon active';
            staffElement.innerHTML = `<strong>NV: ${counterData.employee.hoTen}</strong>`;
            revenueElement.textContent = counterData.revenueFormatted;
            indicatorElement.className = 'status-indicator online';
            textElement.textContent = 'Đang hoạt động';
            
            // Cập nhật nút đóng quầy
            buttonElement.className = 'btn btn-sm btn-outline-danger';
            buttonElement.title = 'Đóng quầy và chốt ca';
            buttonElement.innerHTML = '<i class="fas fa-times-circle"></i>';
            buttonElement.disabled = false;
            buttonElement.onclick = () => closeCounterConfirm(counterId);
            
            // Hiển thị thông tin ca làm việc
            if (counterData.shift && counterData.shift.soGioLam) {
                staffElement.innerHTML = `<strong>NV: ${counterData.employee.hoTen}</strong><br>
                    <small style="color: #6c757d;">Ca: ${counterData.shift.soGioLam.toFixed(1)}h</small>`;
            }
            
            // Hiển thị shift info quick
            if (shiftInfoElement) {
                shiftInfoElement.style.display = 'flex';
                
                // Khởi động timer nếu chưa có
                if (!window[`shiftTimer${counterId}`]) {
                    startShiftTimer(counterId, counterData.shift);
                }
                
                // Cập nhật số giao dịch (giả lập - thực tế lấy từ API)
                const transactionsElement = document.getElementById(`shift-transactions-${counterId}`);
                if (transactionsElement) {
                    const transactionCount = Math.floor(Math.random() * 50) + 10; // Giả lập
                    transactionsElement.textContent = `${transactionCount} giao dịch`;
                }
                
                // Cập nhật progress bar mục tiêu
                updateShiftProgress(counterId, counterData.revenue, 2000000); // Mục tiêu 2M
            }
            
            // Hiển thị advanced actions
            if (advancedActionsElement) {
                advancedActionsElement.style.display = 'flex';
            }
        } else {
            // Quầy không hoạt động
            iconElement.className = 'counter-icon inactive';
            staffElement.innerHTML = '<span style="color: #95a5a6;">NV: Chưa phân công</span>';
            revenueElement.textContent = counterData.revenueFormatted || '0 VNĐ';
            indicatorElement.className = 'status-indicator offline';
            textElement.textContent = 'Không hoạt động';
            
            // Cập nhật nút phân công
            buttonElement.className = 'btn btn-sm btn-outline-success';
            buttonElement.title = 'Phân công nhân viên';
            buttonElement.innerHTML = '<i class="fas fa-user-plus"></i>';
            buttonElement.disabled = false;
            buttonElement.onclick = () => openAssignModal(counterId);
            
            // Ẩn shift info và advanced actions
            if (shiftInfoElement) {
                shiftInfoElement.style.display = 'none';
            }
            if (advancedActionsElement) {
                advancedActionsElement.style.display = 'none';
            }
            
            // Dừng timer nếu đang chạy
            if (window[`shiftTimer${counterId}`]) {
                clearInterval(window[`shiftTimer${counterId}`]);
                window[`shiftTimer${counterId}`] = null;
            }
        }

        // Cập nhật trạng thái cũ (compatibility)
        if (!counterStatus[`counter-${counterId}`]) {
            counterStatus[`counter-${counterId}`] = {};
        }
        counterStatus[`counter-${counterId}`].isActive = counterData.isActive;
    }

    // Đóng quầy với confirm
    function closeCounterConfirm(counterNumber) {
        if (confirm(`Bạn có chắc chắn muốn đóng Quầy ${counterNumber}?`)) {
            const tienMat = prompt('Nhập số tiền mặt bàn giao (VNĐ):', '0');
            if (tienMat === null) return;

            const ghiChu = prompt('Ghi chú:', '') || '';

            closeCounterAPI(counterNumber, parseFloat(tienMat) || 0, ghiChu);
        }
    }

    // API đóng quầy
    function closeCounterAPI(counterNumber, tienMat, ghiChu) {
        $.ajax({
            url: '@Url.Action("CloseCounter", "VehicleShift", new { area = "Admin" })',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify({
                Counter: counterNumber,
                TienMatBanGiao: tienMat,
                GhiChu: ghiChu
            }),
            success: function(response) {
                if (response.success) {
                    showNotification('success', `Đã đóng Quầy ${counterNumber}`, 
                        `Doanh thu: ${(response.revenue / 1000000).toFixed(1)}M VNĐ`);
                    loadCountersStatus();
                } else {
                    showNotification('error', 'Lỗi', response.message);
                }
            },
            error: function(xhr, status, error) {
                showNotification('error', 'Lỗi', 'Không thể đóng quầy: ' + error);
            }
        });
    }

