@{
    ViewData["Title"] = ViewBag.PageTitle;
    var doanhThuTheoCaVao = ViewBag.DoanhThuTheoCaVao as List<dynamic>;
    var doanhThuTheoCaRa = ViewBag.DoanhThuTheoCaRa as List<dynamic>;
    var tongDoanhThu = ViewBag.TongDoanhThu as decimal?;
    var tongLuotGui = ViewBag.TongLuotGui as int?;
}

@section Styles {
    <link rel="stylesheet" href="~/css/vehicle-money.css" />
}

<!-- Page Header -->
<div class="page-header">
    <div>
        <h1 class="page-title">@ViewBag.PageTitle</h1>
        <div class="breadcrumb">
            <a href="#">Trang chủ</a>
            <span>/</span>
            <span>Báo cáo doanh thu</span>
            <span>/</span>
            <span>Theo cổng</span>
        </div>
    </div>
    <div>
        <button class="btn-secondary-admin" onclick="window.location.reload()">
            <i class="fas fa-sync-alt"></i>
            Làm mới
        </button>
        <button class="btn-primary-admin" onclick="window.print()">
            <i class="fas fa-print"></i>
            In báo cáo
        </button>
    </div>
</div>

<!-- Filter Section -->
<div class="admin-card mb-3">
    <div class="admin-card-body">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-4">
                <label for="tuNgay" class="form-label">Từ ngày</label>
                <input type="date" class="form-control" id="tuNgay" name="tuNgay" value="@ViewBag.TuNgay">
            </div>
            <div class="col-md-4">
                <label for="denNgay" class="form-label">Đến ngày</label>
                <input type="date" class="form-control" id="denNgay" name="denNgay" value="@ViewBag.DenNgay">
            </div>
            <div class="col-md-4">
                <button type="submit" class="btn-primary-admin w-100">
                    <i class="fas fa-filter"></i>
                    Lọc dữ liệu
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Stat Cards -->
<div class="stat-cards mb-4">
    <div class="stat-card">
        <div class="stat-card-icon teal">
            <i class="fas fa-dollar-sign"></i>
        </div>
        <div class="stat-card-info">
            <h3>@((tongDoanhThu ?? 0).ToString("N0")) đ</h3>
            <p>Tổng doanh thu</p>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-card-icon green">
            <i class="fas fa-car"></i>
        </div>
        <div class="stat-card-info">
            <h3>@(tongLuotGui ?? 0)</h3>
            <p>Tổng lượt gửi</p>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-card-icon blue">
            <i class="fas fa-door-open"></i>
        </div>
        <div class="stat-card-info">
            <h3>@(doanhThuTheoCaVao?.Count ?? 0)</h3>
            <p>Số ca vào</p>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-card-icon orange">
            <i class="fas fa-door-closed"></i>
        </div>
        <div class="stat-card-info">
            <h3>@(doanhThuTheoCaRa?.Count ?? 0)</h3>
            <p>Số ca ra</p>
        </div>
    </div>
</div>

<div class="row">
    <!-- Doanh thu theo ca vào -->
    <div class="col-lg-6 mb-4">
        <div class="admin-card">
            <div class="admin-card-header">
                <h3 class="admin-card-title">
                    <i class="fas fa-sign-in-alt text-success"></i>
                    Doanh thu theo ca vào (Cổng vào)
                </h3>
            </div>
            <div class="admin-card-body">
                <div class="table-responsive">
                    <table class="admin-table">
                        <thead>
                            <tr>
                                <th>Ca làm việc</th>
                                <th class="text-center">Số lượt</th>
                                <th class="text-end">Doanh thu</th>
                                <th class="text-center">Tỷ lệ</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (doanhThuTheoCaVao != null && doanhThuTheoCaVao.Any())
                            {
                                @foreach (var item in doanhThuTheoCaVao)
                                {
                                    var tyLe = tongDoanhThu > 0 ? (item.TongTien / tongDoanhThu * 100) : 0;
                                    <tr>
                                        <td><strong>@item.TenCa</strong></td>
                                        <td class="text-center">
                                            <span class="badge badge-info">@item.SoLuong</span>
                                        </td>
                                        <td class="text-end">
                                            <strong class="text-success">@item.TongTien.ToString("N0") đ</strong>
                                        </td>
                                        <td class="text-center">
                                            <span class="badge badge-primary">@tyLe.ToString("N1")%</span>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" class="text-center text-muted py-4">
                                        <i class="fas fa-inbox fa-2x mb-2"></i>
                                        <p>Không có dữ liệu</p>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (doanhThuTheoCaVao != null && doanhThuTheoCaVao.Any())
                {
                    <div style="height: 300px; padding: 20px;">
                        <canvas id="caVaoChart"></canvas>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Doanh thu theo ca ra -->
    <div class="col-lg-6 mb-4">
        <div class="admin-card">
            <div class="admin-card-header">
                <h3 class="admin-card-title">
                    <i class="fas fa-sign-out-alt text-danger"></i>
                    Doanh thu theo ca ra (Cổng ra)
                </h3>
            </div>
            <div class="admin-card-body">
                <div class="table-responsive">
                    <table class="admin-table">
                        <thead>
                            <tr>
                                <th>Ca làm việc</th>
                                <th class="text-center">Số lượt</th>
                                <th class="text-end">Doanh thu</th>
                                <th class="text-center">Tỷ lệ</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (doanhThuTheoCaRa != null && doanhThuTheoCaRa.Any())
                            {
                                @foreach (var item in doanhThuTheoCaRa)
                                {
                                    var tyLe = tongDoanhThu > 0 ? (item.TongTien / tongDoanhThu * 100) : 0;
                                    <tr>
                                        <td><strong>@item.TenCa</strong></td>
                                        <td class="text-center">
                                            <span class="badge badge-warning">@item.SoLuong</span>
                                        </td>
                                        <td class="text-end">
                                            <strong class="text-success">@item.TongTien.ToString("N0") đ</strong>
                                        </td>
                                        <td class="text-center">
                                            <span class="badge badge-primary">@tyLe.ToString("N1")%</span>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" class="text-center text-muted py-4">
                                        <i class="fas fa-inbox fa-2x mb-2"></i>
                                        <p>Không có dữ liệu</p>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (doanhThuTheoCaRa != null && doanhThuTheoCaRa.Any())
                {
                    <div style="height: 300px; padding: 20px;">
                        <canvas id="caRaChart"></canvas>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        @if (doanhThuTheoCaVao != null && doanhThuTheoCaVao.Any())
        {
            <text>
            const caVaoData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(doanhThuTheoCaVao));
            const ctxCaVao = document.getElementById('caVaoChart').getContext('2d');
            new Chart(ctxCaVao, {
                type: 'bar',
                data: {
                    labels: caVaoData.map(d => d.tenCa),
                    datasets: [{
                        label: 'Doanh thu',
                        data: caVaoData.map(d => d.tongTien),
                        backgroundColor: 'rgba(40, 167, 69, 0.7)',
                        borderColor: 'rgba(40, 167, 69, 1)',
                        borderWidth: 1
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: {
                                callback: function(value) {
                                    return value.toLocaleString('vi-VN') + ' đ';
                                }
                            }
                        }
                    },
                    plugins: {
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    return 'Doanh thu: ' + context.parsed.y.toLocaleString('vi-VN') + ' đ';
                                }
                            }
                        },
                        legend: {
                            display: false
                        }
                    }
                }
            });
            </text>
        }

        @if (doanhThuTheoCaRa != null && doanhThuTheoCaRa.Any())
        {
            <text>
            const caRaData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(doanhThuTheoCaRa));
            const ctxCaRa = document.getElementById('caRaChart').getContext('2d');
            new Chart(ctxCaRa, {
                type: 'bar',
                data: {
                    labels: caRaData.map(d => d.tenCa),
                    datasets: [{
                        label: 'Doanh thu',
                        data: caRaData.map(d => d.tongTien),
                        backgroundColor: 'rgba(220, 53, 69, 0.7)',
                        borderColor: 'rgba(220, 53, 69, 1)',
                        borderWidth: 1
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: {
                                callback: function(value) {
                                    return value.toLocaleString('vi-VN') + ' đ';
                                }
                            }
                        }
                    },
                    plugins: {
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    return 'Doanh thu: ' + context.parsed.y.toLocaleString('vi-VN') + ' đ';
                                }
                            }
                        },
                        legend: {
                            display: false
                        }
                    }
                }
            });
            </text>
        }
    </script>
}
