@model QuanLyBaiDoXe.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Register";
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/login.css" />
    <style>
        .form-control.is-invalid { border-color: #dc3545; }
        .form-control.is-valid { border-color: #28a745; }
        
        .validation-icon {
            position: absolute;
            right: 10px;
            top: 50%;
            transform: translateY(-50%);
            display: none;
            font-size: 14px;
        }
        
        .input-wrapper { position: relative; }
        .spinner-border-sm { width: 0.9rem; height: 0.9rem; }

        .info-box {
            background: #e7f3ff;
            border-left: 4px solid #2196F3;
            padding: 12px 15px;
            margin-bottom: 20px;
            border-radius: 4px;
        }

        .info-box p {
            margin: 0;
            font-size: 13px;
            color: #0d47a1;
        }
    </style>
</head>
<body>
    <div class="login-wrapper">
        <div class="login-left">
            <div class="overlay">
             
            </div>
        </div>
        <div class="login-right register-right">
            <div class="content">
                <br />
                <h2 class="welcome">Đăng ký tài khoản</h2>
                <p class="hint">Tạo tài khoản khách hàng mới</p>

                <div class="info-box">
                    <p>👤 Bạn đang đăng ký tài khoản <strong>KHÁCH HÀNG</strong> để sử dụng dịch vụ gửi xe</p>
                </div>

                <form asp-action="Register" asp-controller="Account" method="post" class="login-form" id="registerForm">
                    @Html.AntiForgeryToken()

                    <div class="row">
                        <!-- Tên đăng nhập -->
                        <div class="col-12 mb-3">
                            <label asp-for="Username" class="form-label">Tên đăng nhập <span class="text-danger">*</span></label>
                            <div class="input-wrapper">
                                <div class="input d-flex align-items-center">
                                    <span class="icon">👤</span>
                                    <input asp-for="Username" class="form-control border-0" placeholder="Nhập tên đăng nhập" />
                                    <span class="validation-icon" id="usernameIcon"></span>
                                </div>
                            </div>
                            <span asp-validation-for="Username" class="text-danger small"></span>
                        </div>

                        <!-- Email -->
                        <div class="col-12 mb-3">
                            <label asp-for="Email" class="form-label">Email <span class="text-danger">*</span></label>
                            <div class="input-wrapper">
                                <div class="input d-flex align-items-center">
                                    <span class="icon">📧</span>
                                    <input asp-for="Email" class="form-control border-0" type="email" placeholder="example@email.com" />
                                    
                                </div>
                            </div>
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <!-- Mật khẩu -->
                        <div class="col-md-6 mb-3">
                            <label asp-for="Password" class="form-label">Mật khẩu <span class="text-danger">*</span></label>
                            <div class="input d-flex align-items-center position-relative">
                                <span class="icon">🔒</span>
                                <input asp-for="Password" class="form-control border-0" type="password" placeholder="********" id="passwordField" />
                                <button type="button" class="btn btn-link btn-sm position-absolute" style="right: 5px; text-decoration: none;" onclick="togglePasswordVisibility('passwordField', 'passwordToggleIcon')">
                                    <i class="fas fa-eye" id="passwordToggleIcon"></i>
                                </button>
                            </div>
                            <span asp-validation-for="Password" class="text-danger small"></span>
                            
                            <!-- Password strength indicator -->
                            <div class="mt-2">
                                <div class="progress" style="height: 4px;">
                                    <div id="passwordStrengthBar" class="progress-bar" role="progressbar" style="width: 0%"></div>
                                </div>
                                <small id="passwordStrengthText" class="text-muted"></small>
                            </div>
                            
                            <!-- Password requirements -->
                            @* <div class="mt-2 small">
                                <div class="text-muted mb-1"><strong>Mật khẩu phải có:</strong></div>
                                <div id="req-length" class="text-muted">
                                    <i class="fas fa-circle" style="font-size: 6px;"></i> Ít nhất 8 ký tự
                                </div>
                                <div id="req-uppercase" class="text-muted">
                                    <i class="fas fa-circle" style="font-size: 6px;"></i> Ít nhất 1 chữ in hoa (A-Z)
                                </div>
                                <div id="req-lowercase" class="text-muted">
                                    <i class="fas fa-circle" style="font-size: 6px;"></i> Ít nhất 1 chữ thường (a-z)
                                </div>
                                <div id="req-number" class="text-muted">
                                    <i class="fas fa-circle" style="font-size: 6px;"></i> Ít nhất 1 chữ số (0-9)
                                </div>
                                <div id="req-special" class="text-muted">
                                    <i class="fas fa-circle" style="font-size: 6px;"></i> Ít nhất 1 ký tự đặc biệt (@@$!%*?&amp;#...)
                                </div>
                            </div> *@
                        </div>

                        <!-- Xác nhận mật khẩu -->
                        <div class="col-md-6 mb-3">
                            <label asp-for="ConfirmPassword" class="form-label">Xác nhận mật khẩu <span class="text-danger">*</span></label>
                            <div class="input d-flex align-items-center position-relative">
                                <span class="icon">🔒</span>
                                <input asp-for="ConfirmPassword" class="form-control border-0" type="password" placeholder="********" id="confirmPasswordField" />
                                <button type="button" class="btn btn-link btn-sm position-absolute" style="right: 5px; text-decoration: none;" onclick="togglePasswordVisibility('confirmPasswordField', 'confirmPasswordToggleIcon')">
                                    <i class="fas fa-eye" id="confirmPasswordToggleIcon"></i>
                                </button>
                            </div>
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                            <div id="passwordMatch" class="mt-2"></div>
                        </div>

                        <!-- Họ tên -->
                        <div class="col-12 mb-3">
                            <label asp-for="FullName" class="form-label">Họ và tên <span class="text-danger">*</span></label>
                            <div class="input d-flex align-items-center">
                                <span class="icon">📝</span>
                                <input asp-for="FullName" class="form-control border-0" placeholder="Nguyễn Văn A" />
                            </div>
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>

                        <!-- Số điện thoại -->
                        <div class="col-md-6 mb-3">
                            <label asp-for="PhoneNumber" class="form-label">Số điện thoại <span class="text-danger">*</span></label>
                            <div class="input-wrapper">
                                <div class="input d-flex align-items-center">
                                    <span class="icon">📱</span>
                                    <input asp-for="PhoneNumber" class="form-control border-0" placeholder="0912345678" />
                                    <span class="validation-icon" id="phoneIcon"></span>
                                </div>
                            </div>
                            <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                        </div>

                        <!-- CCCD -->
                        <div class="col-md-6 mb-3">
                            <label asp-for="CCCD" class="form-label">CCCD/CMND</label>
                            <div class="input-wrapper">
                                <div class="input d-flex align-items-center">
                                    <span class="icon">🪪</span>
                                    <input asp-for="CCCD" class="form-control border-0" placeholder="001234567890" />
                                    <span class="validation-icon" id="cccdIcon"></span>
                                </div>
                            </div>
                            <span asp-validation-for="CCCD" class="text-danger small"></span>
                        </div>

                        <!-- Địa chỉ -->
                        <div class="col-12 mb-3">
                            <label asp-for="Address" class="form-label">Địa chỉ</label>
                            <div class="input d-flex align-items-center">
                                <span class="icon">🏠</span>
                                <input asp-for="Address" class="form-control border-0" placeholder="123 Đường ABC, Quận XYZ" />
                            </div>
                            <span asp-validation-for="Address" class="text-danger small"></span>
                        </div>

                        <!-- Biển số xe -->
                        <div class="col-12 mb-3">
                            <label asp-for="LicensePlate" class="form-label">Biển số xe mặc định</label>
                            <div class="input d-flex align-items-center">
                                <span class="icon">🚗</span>
                                <input asp-for="LicensePlate" class="form-control border-0" placeholder="29A-12345" />
                            </div>
                            <span asp-validation-for="LicensePlate" class="text-danger small"></span>
                            <small class="text-muted d-block mt-1" style="font-size: 11px;">Có thể để trống và cập nhật sau</small>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary w-100" id="submitBtn">ĐĂNG KÝ</button>

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger mt-2" role="alert">
                            @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                            {
                                <div>@err.ErrorMessage</div>
                            }
                        </div>
                    }
                </form>

                <div class="register text-center">
                    Đã có tài khoản? <a asp-controller="Account" asp-action="Login">Đăng nhập ngay</a>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>

    <script>
        $(document).ready(function () {
            let usernameTimeout;
            let emailTimeout;
            let phoneTimeout;
            let cccdTimeout;

            // Password validation functions
            function checkPasswordRequirements(password) {
                const requirements = {
                    length: password.length >= 8,
                    uppercase: /[A-Z]/.test(password),
                    lowercase: /[a-z]/.test(password),
                    number: /\d/.test(password),
                    special: /[@@$!%*?&#^()_\-+=~`{}\[\]:;"'<>,.\/\\|]/.test(password)
                };

                // Update requirement indicators
                updateRequirement('req-length', requirements.length);
                updateRequirement('req-uppercase', requirements.uppercase);
                updateRequirement('req-lowercase', requirements.lowercase);
                updateRequirement('req-number', requirements.number);
                updateRequirement('req-special', requirements.special);

                // Calculate strength
                const metCount = Object.values(requirements).filter(Boolean).length;
                let strength = 0;
                let strengthText = '';
                let strengthColor = '';

                if (metCount === 5) {
                    strength = 100;
                    strengthText = 'Mạnh';
                    strengthColor = '#28a745';
                } else if (metCount === 4) {
                    strength = 75;
                    strengthText = 'Khá tốt';
                    strengthColor = '#87DF2C';
                } else if (metCount === 3) {
                    strength = 50;
                    strengthText = 'Trung bình';
                    strengthColor = '#ffc107';
                } else if (metCount > 0) {
                    strength = 25;
                    strengthText = 'Yếu';
                    strengthColor = '#dc3545';
                }

                $('#passwordStrengthBar').css('width', strength + '%').css('background-color', strengthColor);
                $('#passwordStrengthText').text(strengthText).css('color', strengthColor);

                return Object.values(requirements).every(Boolean);
            }

            function updateRequirement(id, met) {
                const element = $('#' + id);
                if (met) {
                    element.removeClass('text-muted').addClass('text-success');
                    element.find('i').removeClass('fa-circle').addClass('fa-check-circle');
                } else {
                    element.removeClass('text-success').addClass('text-muted');
                    element.find('i').removeClass('fa-check-circle').addClass('fa-circle');
                }
            }

            function checkPasswordMatch() {
                const password = $('#passwordField').val();
                const confirmPassword = $('#confirmPasswordField').val();
                const matchDiv = $('#passwordMatch');

                if (confirmPassword.length > 0) {
                    if (password === confirmPassword) {
                        matchDiv.html('<small class="text-success"><i class="fas fa-check-circle"></i> Mật khẩu khớp</small>');
                    } else {
                        matchDiv.html('<small class="text-danger"><i class="fas fa-times-circle"></i> Mật khẩu không khớp</small>');
                    }
                } else {
                    matchDiv.html('');
                }
            }

            // Password field validation
            $('#passwordField').on('input', function () {
                const password = $(this).val();
                checkPasswordRequirements(password);
                checkPasswordMatch();
            });

            $('#confirmPasswordField').on('input', function () {
                checkPasswordMatch();
            });

            // Kiểm tra tên đăng nhập
            $('#Username').on('input', function () {
                clearTimeout(usernameTimeout);
                const username = $(this).val().trim();
                const icon = $('#usernameIcon');

                if (username.length < 3) {
                    icon.hide();
                    return;
                }

                icon.html('<span class="spinner-border spinner-border-sm text-primary"></span>').show();

                usernameTimeout = setTimeout(function () {
                    $.ajax({
                        url: '@Url.Action("CheckUsername", "Account")',
                        type: 'GET',
                        data: { username: username },
                        success: function (response) {
                            if (response.available) {
                                icon.html('<span class="text-success">✓</span>');
                                $('#Username').removeClass('is-invalid').addClass('is-valid');
                            } else {
                                icon.html('<span class="text-danger">✗</span>');
                                $('#Username').removeClass('is-valid').addClass('is-invalid');
                            }
                        },
                        error: function () {
                            icon.hide();
                        }
                    });
                }, 500);
            });

            // Kiểm tra email
            $('#Email').on('input', function () {
                clearTimeout(emailTimeout);
                const email = $(this).val().trim();
                const icon = $('#emailIcon');

                // Check if email field is valid using HTML5 validation
                if (!this.validity.valid || email.length < 5) {
                    icon.hide();
                    return;
                }

                icon.html('<span class="spinner-border spinner-border-sm text-primary"></span>').show();

                emailTimeout = setTimeout(function () {
                    $.ajax({
                        url: '@Url.Action("CheckEmail", "Account")',
                        type: 'GET',
                        data: { email: email },
                        success: function (response) {
                            if (response.available) {
                                icon.html('<span class="text-success">✓</span>');
                                $('#Email').removeClass('is-invalid').addClass('is-valid');
                            } else {
                                icon.html('<span class="text-danger">✗</span>');
                                $('#Email').removeClass('is-valid').addClass('is-invalid');
                            }
                        },
                        error: function () {
                            icon.hide();
                        }
                    });
                }, 500);
            });

            // Kiểm tra số điện thoại
            $('#PhoneNumber').on('input', function () {
                clearTimeout(phoneTimeout);
                const phone = $(this).val().trim();
                const icon = $('#phoneIcon');

                if (phone.length < 10) {
                    icon.hide();
                    return;
                }

                icon.html('<span class="spinner-border spinner-border-sm text-primary"></span>').show();

                phoneTimeout = setTimeout(function () {
                    $.ajax({
                        url: '@Url.Action("CheckPhoneNumber", "Account")',
                        type: 'GET',
                        data: { phoneNumber: phone },
                        success: function (response) {
                            if (response.available) {
                                icon.html('<span class="text-success">✓</span>');
                                $('#PhoneNumber').removeClass('is-invalid').addClass('is-valid');
                            } else {
                                icon.html('<span class="text-danger">✗</span>');
                                $('#PhoneNumber').removeClass('is-valid').addClass('is-invalid');
                            }
                        },
                        error: function () {
                            icon.hide();
                        }
                    });
                }, 500);
            });

            // Kiểm tra CCCD
            $('#CCCD').on('input', function () {
                clearTimeout(cccdTimeout);
                const cccd = $(this).val().trim();
                const icon = $('#cccdIcon');

                if (cccd.length < 9) {
                    icon.hide();
                    return;
                }

                icon.html('<span class="spinner-border spinner-border-sm text-primary"></span>').show();

                cccdTimeout = setTimeout(function () {
                    $.ajax({
                        url: '@Url.Action("CheckCCCD", "Account")',
                        type: 'GET',
                        data: { cccd: cccd },
                        success: function (response) {
                            if (response.available) {
                                icon.html('<span class="text-success">✓</span>');
                                $('#CCCD').removeClass('is-invalid').addClass('is-valid');
                            } else {
                                icon.html('<span class="text-danger">✗</span>');
                                $('#CCCD').removeClass('is-valid').addClass('is-invalid');
                            }
                        },
                        error: function () {
                            icon.hide();
                        }
                    });
                }, 500);
            });

            // Chuyển biển số xe thành chữ hoa
            $('#LicensePlate').on('input', function () {
                $(this).val($(this).val().toUpperCase());
            });

            // Form validation
            $('#registerForm').on('submit', function (e) {
                const password = $('#passwordField').val();
                const confirmPassword = $('#confirmPasswordField').val();

                // Check password requirements
                if (!checkPasswordRequirements(password)) {
                    e.preventDefault();
                    alert('Mật khẩu chưa đáp ứng đủ các yêu cầu. Vui lòng kiểm tra lại.');
                    return false;
                }

                // Check password match
                if (password !== confirmPassword) {
                    e.preventDefault();
                    alert('Mật khẩu xác nhận không khớp. Vui lòng kiểm tra lại.');
                    return false;
                }

                if (!$(this).valid()) {
                    e.preventDefault();
                    return false;
                }

                $('#submitBtn').prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-2"></span>Đang xử lý...');
            });
        });

        // Toggle password visibility function
        function togglePasswordVisibility(fieldId, iconId) {
            const field = document.getElementById(fieldId);
            const icon = document.getElementById(iconId);
            
            if (field.type === 'password') {
                field.type = 'text';
                icon.classList.remove('fa-eye');
                icon.classList.add('fa-eye-slash');
            } else {
                field.type = 'password';
                icon.classList.remove('fa-eye-slash');
                icon.classList.add('fa-eye');
            }
        }
    </script>
</body>
</html>
