@using System.Security.Claims
@{
    ViewData["Title"] = "Truy cập bị từ chối";
    Layout = "_Layout";
    var userRole = User.FindFirst(ClaimTypes.Role)?.Value;
    var userName = User.Identity?.Name ?? "Người dùng";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-lg border-0">
                <div class="card-body p-5 text-center">
                    <div class="mb-4">
                        <i class="fas fa-ban text-danger" style="font-size: 5rem;"></i>
                    </div>
                    <h1 class="text-danger mb-3">Truy cập bị từ chối</h1>
                    <p class="lead text-muted mb-4">
                        Bạn không có quyền truy cập vào trang này.
                    </p>
                    
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <div class="alert alert-info">
                            <i class="fas fa-info-circle"></i>
                            Bạn đang đăng nhập với quyền: <strong>@(userRole == "Employee" ? "Nhân viên" : userRole)</strong>
                        </div>
                        
                        <p class="text-muted mb-4">
                            Trang này yêu cầu quyền cao hơn để truy cập. <br />
                            Vui lòng liên hệ quản trị viên nếu bạn cho rằng đây là lỗi.
                        </p>
                        
                        <div class="d-grid gap-2 d-md-flex justify-content-md-center">
                            <a href="@Url.Action("Index", "Dashboard", new { area = userRole == "Admin" || userRole == "Employee" ? "Admin" : "User" })" class="btn btn-primary btn-lg">
                                <i class="fas fa-home"></i> Về trang chủ
                            </a>
                            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                <button type="submit" class="btn btn-outline-secondary btn-lg">
                                    <i class="fas fa-sign-out-alt"></i> Đăng xuất
                                </button>
                            </form>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted mb-4">
                            Bạn cần đăng nhập để truy cập trang này.
                        </p>
                        
                        <div class="d-grid gap-2 d-md-flex justify-content-md-center">
                            <a href="@Url.Action("Login", "Account")" class="btn btn-primary btn-lg">
                                <i class="fas fa-sign-in-alt"></i> Đăng nhập
                            </a>
                            <a href="@Url.Action("Index", "Home")" class="btn btn-outline-secondary btn-lg">
                                <i class="fas fa-home"></i> Về trang chủ
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .card {
        border-radius: 15px;
    }
    
    .btn-lg {
        padding: 12px 30px;
        font-size: 1rem;
    }
</style>

