@model List<QuanLyBaiDoXe.Areas.Admin.ViewModels.EmployeeViewModel>

@{
    ViewData["Title"] = "Danh sách nhân viên";
}

<!-- Page Header -->
<div class="page-header">
    <div>
        <h1 class="page-title">
            <i class="fas fa-users"></i>
            Danh sách nhân viên
        </h1>
        <div class="breadcrumb">
            <a href="@Url.Action("Index", "Dashboard", new { area = "Admin" })">Trang chủ</a>
            <span>/</span>
            <a href="@Url.Action("Index", "VehicleShift", new { area = "Admin" })">Ca làm việc</a>
            <span>/</span>
            <span>Nhân viên</span>
        </div>
    </div>
    <div class="page-header-actions">
        <button class="btn-secondary-admin" onclick="location.href='@Url.Action("Schedule", "VehicleShift", new { area = "Admin" })'">
            <i class="fas fa-calendar-alt"></i>
            Xem lịch làm việc
        </button>
        <button class="btn-primary-admin" data-bs-toggle="modal" data-bs-target="#addEmployeeModal">
            <i class="fas fa-plus"></i>
            Thêm nhân viên
        </button>
    </div>
</div>

<!-- Stats Cards -->
<div class="stat-cards">
    <div class="stat-card">
        <div class="stat-card-icon teal">
            <i class="fas fa-users"></i>
        </div>
        <div class="stat-card-info">
            <h3>@Model.Count</h3>
            <p>Tổng nhân viên</p>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-card-icon green">
            <i class="fas fa-user-check"></i>
        </div>
        <div class="stat-card-info">
            <h3>@Model.Count(e => e.TrangThaiLamViec)</h3>
            <p>Đang làm việc</p>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-card-icon orange">
            <i class="fas fa-user-times"></i>
        </div>
        <div class="stat-card-info">
            <h3>@Model.Count(e => !e.TrangThaiLamViec)</h3>
            <p>Đã nghỉ việc</p>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-card-icon teal">
            <i class="fas fa-user-tie"></i>
        </div>
        <div class="stat-card-info">
            <h3>@Model.Count(e => e.ChucVu >= 3)</h3>
            <p>Quản lý</p>
        </div>
    </div>
</div>

<!-- Filters -->
<div class="admin-card">
    <div class="admin-card-header">
        <h3 class="admin-card-title">Danh sách nhân viên</h3>
    </div>
    
    <!-- Filter Row -->
    <div class="filter-row">
        <select class="form-select" id="filterPosition" onchange="filterEmployees()">
            <option value="">Tất cả chức vụ</option>
            <option value="1">Bảo vệ</option>
            <option value="2">Thu ngân</option>
            <option value="3">Giám sát</option>
            <option value="4">Quản lý</option>
        </select>
        <select class="form-select" id="filterStatus" onchange="filterEmployees()">
            <option value="">Tất cả trạng thái</option>
            <option value="true">Đang làm việc</option>
            <option value="false">Đã nghỉ việc</option>
        </select>
        <div class="input-group search-box">
            <span class="input-group-text"><i class="fas fa-search"></i></span>
            <input type="text" class="form-control" id="searchEmployee" placeholder="Tìm theo tên, SĐT..." onkeyup="searchEmployees()">
        </div>
    </div>

    <!-- Employee Cards Grid -->
    <div class="employee-grid">
        @if (Model.Any())
        {
            @foreach (var emp in Model)
            {
                <div class="employee-card" data-position="@emp.ChucVu" data-status="@emp.TrangThaiLamViec.ToString().ToLower()" data-search="@emp.HoTen.ToLower() @emp.SoDienThoai">
                    <div class="employee-card-header">
                        <div class="employee-avatar-large">
                            @emp.HoTen.Substring(0, 1)
                        </div>
                        <div class="employee-status">
                            @if (emp.TrangThaiLamViec)
                            {
                                <span class="badge badge-success">
                                    <i class="fas fa-circle"></i>
                                    Đang làm việc
                                </span>
                            }
                            else
                            {
                                <span class="badge badge-secondary">
                                    <i class="fas fa-circle"></i>
                                    Đã nghỉ việc
                                </span>
                            }
                        </div>
                    </div>
                    <div class="employee-card-body">
                        <h5 class="employee-card-name">@emp.HoTen</h5>
                        <p class="employee-card-id">Mã NV: <strong>@("NV" + emp.MaNhanVien.ToString("D4"))</strong></p>
                        
                        <div class="employee-info-grid">
                            <div class="info-item">
                                <i class="fas fa-briefcase"></i>
                                <span>@emp.ChucVuText</span>
                            </div>
                            <div class="info-item">
                                <i class="fas fa-phone"></i>
                                <span>@(emp.SoDienThoai ?? "Chưa có")</span>
                            </div>
                            <div class="info-item">
                                <i class="fas fa-birthday-cake"></i>
                                <span>@emp.Tuoi tuổi</span>
                            </div>
                            <div class="info-item">
                                <i class="fas fa-calendar"></i>
                                <span>Vào làm: @emp.NgayVaoLam?.ToString("dd/MM/yyyy")</span>
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(emp.DiaChi))
                        {
                            <div class="employee-address">
                                <i class="fas fa-map-marker-alt"></i>
                                <span>@emp.DiaChi</span>
                            </div>
                        }
                    </div>
                    <div class="employee-card-footer">
                        <button class="btn-sm btn-secondary-admin" onclick="viewEmployeeDetail(@emp.MaNhanVien)">
                            <i class="fas fa-eye"></i>
                            Xem chi tiết
                        </button>
                        <button class="btn-sm btn-primary-admin" onclick="viewEmployeeSchedule(@emp.MaNhanVien)">
                            <i class="fas fa-calendar-alt"></i>
                            Lịch làm việc
                        </button>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12">
                <div class="empty-state">
                    <i class="fas fa-users-slash"></i>
                    <p>Chưa có nhân viên nào</p>
                </div>
            </div>
        }
    </div>
</div>

<!-- Employee Detail Modal -->
<div class="modal fade" id="employeeDetailModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Thông tin nhân viên</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="employeeDetailContent">
                <!-- Content will be loaded dynamically -->
            </div>
            <div class="modal-footer">
                <button type="button" class="btn-secondary-admin" data-bs-dismiss="modal">Đóng</button>
                <button type="button" class="btn-primary-admin" onclick="editEmployee()">
                    <i class="fas fa-edit"></i>
                    Chỉnh sửa
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Add Employee Modal -->
<div class="modal fade" id="addEmployeeModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="fas fa-user-plus"></i>
                    Thêm nhân viên mới
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="addEmployeeForm">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Họ và tên <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" id="addHoTen" name="HoTen" required>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Chức vụ <span class="text-danger">*</span></label>
                                <select class="form-select" id="addChucVu" name="ChucVu" required>
                                    <option value="">-- Chọn chức vụ --</option>
                                    <option value="0">Admin</option>
                                    <option value="1">Quản lý</option>
                                    <option value="2">Bảo vệ</option>
                                    <option value="3">Kỹ thuật</option>
                                    <option value="4">Nhân viên</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Giới tính</label>
                                <select class="form-select" id="addGioiTinh" name="GioiTinh">
                                    <option value="">Chọn giới tính</option>
                                    <option value="Nam">Nam</option>
                                    <option value="Nữ">Nữ</option>
                                    <option value="Khác">Khác</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Ngày sinh</label>
                                <input type="date" class="form-control" id="addNgaySinh" name="NgaySinh">
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Số điện thoại</label>
                                <input type="tel" class="form-control" id="addSoDienThoai" name="SoDienThoai" pattern="[0-9]{10,11}" placeholder="0123456789">
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Ngày vào làm</label>
                                <input type="date" class="form-control" id="addNgayVaoLam" name="NgayVaoLam">
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Địa chỉ</label>
                        <textarea class="form-control" id="addDiaChi" name="DiaChi" rows="2" placeholder="Nhập địa chỉ nhân viên"></textarea>
                    </div>

                    <div class="mb-3">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="addTrangThaiLamViec" name="TrangThaiLamViec" checked>
                            <label class="form-check-label" for="addTrangThaiLamViec">
                                Đang làm việc
                            </label>
                        </div>
                    </div>

                    <div class="alert alert-info">
                        <i class="fas fa-info-circle"></i>
                        <strong>Lưu ý:</strong> Nhân viên mới sẽ được tạo với trạng thái "Đang làm việc" và có thể được phân ca ngay sau khi thêm.
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn-secondary-admin" data-bs-dismiss="modal">
                    <i class="fas fa-times"></i>
                    Hủy
                </button>
                <button type="button" class="btn-primary-admin" onclick="createEmployee()">
                    <i class="fas fa-check"></i>
                    Thêm nhân viên
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Edit Employee Modal -->
<div class="modal fade" id="editEmployeeModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="fas fa-user-edit"></i>
                    Chỉnh sửa thông tin nhân viên
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="editEmployeeForm">
                    <input type="hidden" id="editMaNhanVien" name="MaNhanVien">
                    
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Họ và tên <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" id="editHoTen" name="HoTen" required>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Chức vụ <span class="text-danger">*</span></label>
                                <select class="form-select" id="editChucVu" name="ChucVu" required>
                                    <option value="0">Admin</option>
                                    <option value="1">Quản lý</option>
                                    <option value="2">Bảo vệ</option>
                                    <option value="3">Kỹ thuật</option>
                                    <option value="4">Nhân viên</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Giới tính</label>
                                <select class="form-select" id="editGioiTinh" name="GioiTinh">
                                    <option value="">Chọn giới tính</option>
                                    <option value="Nam">Nam</option>
                                    <option value="Nữ">Nữ</option>
                                    <option value="Khác">Khác</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Ngày sinh</label>
                                <input type="date" class="form-control" id="editNgaySinh" name="NgaySinh">
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Số điện thoại</label>
                                <input type="tel" class="form-control" id="editSoDienThoai" name="SoDienThoai" pattern="[0-9]{10,11}">
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Ngày vào làm</label>
                                <input type="date" class="form-control" id="editNgayVaoLam" name="NgayVaoLam">
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Địa chỉ</label>
                        <textarea class="form-control" id="editDiaChi" name="DiaChi" rows="2"></textarea>
                    </div>

                    <div class="mb-3">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="editTrangThaiLamViec" name="TrangThaiLamViec">
                            <label class="form-check-label" for="editTrangThaiLamViec">
                                Đang làm việc
                            </label>
                        </div>
                    </div>

                    <div class="alert alert-warning">
                        <i class="fas fa-exclamation-triangle"></i>
                        <strong>Lưu ý:</strong> Thay đổi chức vụ hoặc trạng thái sẽ ảnh hưởng đến quyền truy cập và phân ca của nhân viên.
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn-secondary-admin" data-bs-dismiss="modal">
                    <i class="fas fa-times"></i>
                    Hủy
                </button>
                <button type="button" class="btn-primary-admin" onclick="saveEmployeeChanges()">
                    <i class="fas fa-save"></i>
                    Lưu thay đổi
                </button>
            </div>
        </div>
    </div>
</div>

<link rel="stylesheet" href="~/css/vehicle-shift.css" />

@section Scripts {
<script>
    // Reset form khi mở modal thêm nhân viên
    $('#addEmployeeModal').on('show.bs.modal', function() {
        $('#addEmployeeForm')[0].reset();
        $('#addTrangThaiLamViec').prop('checked', true);
    });

    function filterEmployees() {
            const position = $('#filterPosition').val();
            const status = $('#filterStatus').val();
            
            $('.employee-card').each(function() {
                const cardPosition = $(this).data('position').toString();
                const cardStatus = $(this).data('status');
                
                let showCard = true;
                
                if (position && cardPosition !== position) {
                    showCard = false;
                }
                
                if (status && cardStatus !== status) {
                    showCard = false;
                }
                
                if (showCard) {
                    $(this).show();
                } else {
                    $(this).hide();
                }
            });
        }

        function searchEmployees() {
            const searchText = $('#searchEmployee').val().toLowerCase();
            
            $('.employee-card').each(function() {
                const searchData = $(this).data('search');
                
                if (searchData.includes(searchText)) {
                    $(this).show();
                } else {
                    $(this).hide();
                }
            });
        }

        // Thêm nhân viên mới
        function createEmployee() {
            // Validate form
            if (!$('#addEmployeeForm')[0].checkValidity()) {
                $('#addEmployeeForm')[0].reportValidity();
                return;
            }

            // Prepare data
            const formData = {
                HoTen: $('#addHoTen').val().trim(),
                ChucVu: parseInt($('#addChucVu').val()),
                GioiTinh: $('#addGioiTinh').val() || null,
                SoDienThoai: $('#addSoDienThoai').val() || null,
                DiaChi: $('#addDiaChi').val() || null,
                NgaySinh: $('#addNgaySinh').val() || null,
                NgayVaoLam: $('#addNgayVaoLam').val() || null,
                TrangThaiLamViec: $('#addTrangThaiLamViec').is(':checked')
            };

            // Validate required fields
            if (!formData.HoTen) {
                alert('Vui lòng nhập họ tên nhân viên!');
                return;
            }

            if (!formData.ChucVu && formData.ChucVu !== 0) {
                alert('Vui lòng chọn chức vụ!');
                return;
            }

            // Confirm before save
            if (!confirm('Bạn có chắc chắn muốn thêm nhân viên này?')) {
                return;
            }

            // Show loading
            const saveBtn = $('button[onclick="createEmployee()"]');
            const originalText = saveBtn.html();
            saveBtn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Đang thêm...');

            // Send AJAX request
            $.ajax({
                url: '@Url.Action("CreateEmployee", "VehicleShift", new { area = "Admin" })',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(formData),
                success: function(response) {
                    saveBtn.prop('disabled', false).html(originalText);
                    
                    if (response.success) {
                        alert(response.message);
                        $('#addEmployeeModal').modal('hide');
                        location.reload(); // Reload để cập nhật danh sách
                    } else {
                        alert('Lỗi: ' + response.message);
                    }
                },
                error: function(xhr, status, error) {
                    saveBtn.prop('disabled', false).html(originalText);
                    alert('Có lỗi xảy ra khi thêm nhân viên: ' + error);
                }
            });
        }

        let currentEmployeeId = 0;

        function viewEmployeeDetail(employeeId) {
            currentEmployeeId = employeeId;
            $('#employeeDetailModal').modal('show');
            $('#employeeDetailContent').html(`
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Đang tải...</span>
                    </div>
                    <p class="mt-3">Đang tải thông tin nhân viên...</p>
                </div>
            `);
            
            // Load employee detail via AJAX
            $.get('@Url.Action("GetEmployeeDetail", "VehicleShift", new { area = "Admin" })', { id: employeeId }, function(response) {
                if (response.success) {
                    const data = response.data;
                    const emp = data.employee;
                    const stats = data.stats;
                    const shifts = data.recentShifts;

                    const gioiTinhText = emp.gioiTinh === 'Nam' ? 'Nam' : emp.gioiTinh === 'Nữ' ? 'Nữ' : 'Khác';
                    const ngaySinhText = emp.ngaySinh ? new Date(emp.ngaySinh).toLocaleDateString('vi-VN') : 'Chưa có';
                    const ngayVaoLamText = emp.ngayVaoLam ? new Date(emp.ngayVaoLam).toLocaleDateString('vi-VN') : 'Chưa có';

                    let shiftsHtml = '';
                    if (shifts && shifts.length > 0) {
                        shifts.forEach(shift => {
                            const statusClass = shift.trangThaiCa === 0 ? 'success' : 'info';
                            const statusText = shift.trangThaiCa === 0 ? 'Đang trực' : 'Đã chốt';
                            const thoiGianNhanCa = shift.thoiGianNhanCa ? new Date(shift.thoiGianNhanCa).toLocaleString('vi-VN') : '-';
                            const thoiGianGiaoCa = shift.thoiGianGiaoCa ? new Date(shift.thoiGianGiaoCa).toLocaleString('vi-VN') : '-';
                            
                            shiftsHtml += `
                                <tr>
                                    <td><strong>#${shift.maCa}</strong></td>
                                    <td>${thoiGianNhanCa}</td>
                                    <td>${thoiGianGiaoCa}</td>
                                    <td>${shift.soGioLam.toFixed(1)}h</td>
                                    <td>${shift.tongTienHeThong.toLocaleString('vi-VN')} đ</td>
                                    <td><span class="badge badge-${statusClass}">${statusText}</span></td>
                                </tr>
                            `;
                        });
                    } else {
                        shiftsHtml = '<tr><td colspan="6" class="text-center">Chưa có ca làm việc nào</td></tr>';
                    }

                    const html = `
                        <div class="employee-detail-container">
                            <!-- Employee Info Section -->
                            <div class="row mb-4">
                                <div class="col-md-4 text-center">
                                    <div class="employee-avatar-xlarge mb-3">
                                        ${emp.hoTen.substring(0, 1)}
                                    </div>
                                    <h4 class="mb-1">${emp.hoTen}</h4>
                                    <p class="text-muted">Mã NV: <strong>NV${emp.maNhanVien.toString().padStart(4, '0')}</strong></p>
                                    <span class="badge badge-${emp.trangThaiLamViec ? 'success' : 'secondary'} mb-3">
                                        ${emp.trangThaiLamViec ? 'Đang làm việc' : 'Đã nghỉ việc'}
                                    </span>
                                </div>
                                <div class="col-md-8">
                                    <h5 class="mb-3"><i class="fas fa-user-circle"></i> Thông tin cá nhân</h5>
                                    <div class="row">
                                        <div class="col-md-6">
                                            <div class="detail-item">
                                                <label><i class="fas fa-briefcase"></i> Chức vụ:</label>
                                                <strong>${emp.chucVuText}</strong>
                                            </div>
                                            <div class="detail-item">
                                                <label><i class="fas fa-venus-mars"></i> Giới tính:</label>
                                                <span>${gioiTinhText}</span>
                                            </div>
                                            <div class="detail-item">
                                                <label><i class="fas fa-birthday-cake"></i> Ngày sinh:</label>
                                                <span>${ngaySinhText} (${emp.tuoi} tuổi)</span>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="detail-item">
                                                <label><i class="fas fa-phone"></i> Số điện thoại:</label>
                                                <span>${emp.soDienThoai || 'Chưa có'}</span>
                                            </div>
                                            <div class="detail-item">
                                                <label><i class="fas fa-calendar-plus"></i> Ngày vào làm:</label>
                                                <span>${ngayVaoLamText}</span>
                                            </div>
                                            <div class="detail-item">
