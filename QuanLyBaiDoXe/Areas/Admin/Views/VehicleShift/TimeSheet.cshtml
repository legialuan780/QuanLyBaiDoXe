                    let managerOptions = '<option value="">-- Chọn nhân viên quản lý --</option>';
                    
                    data.forEach(emp => {
                        options += `<option value="${emp.maNhanVien}">${emp.hoTen} - ${emp.chucVu}</option>`;
                        managerOptions += `<option value="${emp.maNhanVien}">${emp.hoTen} - ${emp.chucVu}</option>`;
