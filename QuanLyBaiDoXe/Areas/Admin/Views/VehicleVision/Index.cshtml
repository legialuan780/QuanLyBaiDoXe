    // ===== SHIFT TIMER FUNCTIONS =====
    
    function startShiftTimer(counterId, shiftData) {
        // Tính thời gian đã làm (giả sử có thời gian bắt đầu)
        const durationElement = document.getElementById(`shift-duration-${counterId}`);
        if (!durationElement) return;
        
        let elapsedSeconds = 0;
        
        // Nếu có shift data với thời gian bắt đầu, tính elapsed time
        if (shiftData && shiftData.soGioLam) {
            elapsedSeconds = Math.floor(shiftData.soGioLam * 3600);
        }
        
        // Cập nhật mỗi giây
        window[`shiftTimer${counterId}`] = setInterval(() => {
            elapsedSeconds++;
            
            const hours = Math.floor(elapsedSeconds / 3600);
            const minutes = Math.floor((elapsedSeconds % 3600) / 60);
            const seconds = elapsedSeconds % 60;
            
            durationElement.textContent = 
                `${String(hours).padStart(2, '0')}:${String(minutes).padStart(2, '0')}:${String(seconds).padStart(2, '0')}`;
        }, 1000);
    }
    
    function updateShiftProgress(counterId, currentRevenue, targetRevenue) {
        const progressElement = document.getElementById(`shift-progress-${counterId}`);
        const targetElement = document.getElementById(`shift-target-${counterId}`);
        
        if (progressElement && targetElement) {
            const percentage = Math.min((currentRevenue / targetRevenue) * 100, 100);
            progressElement.style.width = `${percentage}%`;
            
            // Cập nhật target display
            targetElement.textContent = `${(targetRevenue / 1000000).toFixed(1)}M`;
            
            // Đổi màu progress bar dựa vào tỷ lệ
            if (percentage >= 100) {
                progressElement.style.background = 'linear-gradient(90deg, #87DF2C 0%, #76c91e 100%)';
            } else if (percentage >= 75) {
                progressElement.style.background = 'linear-gradient(90deg, #87DF2C 0%, #21A691 100%)';
            } else if (percentage >= 50) {
                progressElement.style.background = 'linear-gradient(90deg, #ffa500 0%, #ff9800 100%)';
            } else {
                progressElement.style.background = 'linear-gradient(90deg, #ff6b6b 0%, #ff5252 100%)';
            }
        }
    }

