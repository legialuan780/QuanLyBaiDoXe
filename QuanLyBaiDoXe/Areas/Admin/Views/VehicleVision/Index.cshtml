    function openReportModal() {
        // Set default dates
        const today = new Date();
        document.getElementById('reportEndDate').value = today.toISOString().split('T')[0];
        document.getElementById('reportStartDate').value = today.toISOString().split('T')[0];
        
        // Update summary
        updateReportSummary();
        
