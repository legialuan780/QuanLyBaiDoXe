# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

# All files
[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

# Code files
[*.{cs,cshtml,razor}]
charset = utf-8-bom
indent_style = space
indent_size = 4

# JSON files
[*.json]
charset = utf-8
indent_style = space
indent_size = 2

# JavaScript files
[*.js]
charset = utf-8
indent_style = space
indent_size = 4

# CSS files
[*.css]
charset = utf-8
indent_style = space
indent_size = 4

# SQL files
[*.sql]
charset = utf-8
indent_style = space
indent_size = 4
