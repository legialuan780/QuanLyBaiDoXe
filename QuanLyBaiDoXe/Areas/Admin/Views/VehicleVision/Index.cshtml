@model QuanLyBaiDoXe.Areas.Admin.ViewModels.VehicleVisionViewModel
@{
    ViewData["Title"] = "Giám sát bãi đỗ xe";
}

<!-- Chart.js Library -->
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>

<!-- Page Header -->
<div class="page-header">
    <div>
        <h1 class="page-title">Giám sát bãi đỗ xe</h1>
        <div class="breadcrumb">
            <a href="@Url.Action("Index", "Dashboard", new { area = "Admin" })">Trang chủ</a>
            <span>/</span>
            <span>Giám sát bãi</span>
        </div>
    </div>
    <div>
        <button class="btn-secondary-admin" onclick="openReportModal()">
            <i class="fas fa-file-chart-line"></i>
            Tạo báo cáo
        </button>
        <button class="btn-secondary-admin" onclick="openAllCameras()">
            <i class="fas fa-video"></i>
            Camera
        </button>
        <button class="btn-secondary-admin" onclick="showOverviewMap()">
            <i class="fas fa-map-marked-alt"></i>
            Map tổng quan
        </button>
        <button class="btn-secondary-admin" onclick="refreshParkingLot()">
            <i class="fas fa-sync-alt"></i>
            Làm mới
        </button>
        <button class="btn-primary-admin" id="fullscreenBtn" onclick="toggleFullscreenMode()">
            <i class="fas fa-expand-arrows-alt" id="fullscreenIcon"></i>
            <span id="fullscreenText">Toàn màn hình</span>
        </button>
    </div>
</div>

<!-- Stat Cards -->
<div class="stat-cards">
    <div class="stat-card">
        <div class="stat-card-icon teal">
            <i class="fas fa-parking"></i>
        </div>
        <div class="stat-card-info">
            <h3 id="totalSlots">@Model.TotalSlots</h3>
            <p>Tổng chỗ đỗ</p>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-card-icon green">
            <i class="fas fa-check-circle"></i>
        </div>
        <div class="stat-card-info">
            <h3 id="availableSlots">@Model.AvailableSlots</h3>
            <p>Chỗ trống</p>
        </div>
        <div class="stat-card-trend up">
            <i class="fas fa-arrow-up"></i>
            @Model.AvailablePercent%
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-card-icon orange">
            <i class="fas fa-car"></i>
        </div>
        <div class="stat-card-info">
            <h3 id="occupiedSlots">@Model.OccupiedSlots</h3>
            <p>Đang sử dụng</p>
        </div>
        <div class="stat-card-trend">
            <i class="fas fa-minus"></i>
            @Model.OccupiedPercent%
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-card-icon red">
            <i class="fas fa-exclamation-triangle"></i>
        </div>
        <div class="stat-card-info">
            <h3 id="reservedSlots">@(Model.ReservedSlots + Model.MaintenanceSlots)</h3>
            <p>Đã đặt / Bảo trì</p>
        </div>
    </div>
</div>

<div class="row">
    <!-- Parking Lot Map -->
    <div class="col-lg-8">
        <div class="admin-card">
            <div class="admin-card-header">
                <h3 class="admin-card-title">Sơ đồ bãi đỗ xe</h3>
                <div>
                    <button class="btn-secondary-admin btn-sm" id="viewModeToggle" onclick="toggleViewMode()">
                        <i class="fas fa-compress-alt" id="viewModeIcon"></i>
                        <span id="viewModeText">Chế độ rút gọn</span>
                    </button>
                </div>
            </div>
            <div class="parking-map-container">
                <!-- Legend -->
                <div class="parking-legend mb-3">
                    <div class="legend-item">
                        <span class="legend-color available"></span>
                        <span>Trống</span>
                    </div>
                    <div class="legend-item">
                        <span class="legend-color occupied"></span>
                        <span>Đang đỗ</span>
                    </div>
                    <div class="legend-item">
                        <span class="legend-color reserved"></span>
                        <span>Đã đặt</span>
                    </div>
                    <div class="legend-item">
                        <span class="legend-color maintenance"></span>
                        <span>Bảo trì</span>
                    </div>
                </div>

                <!-- Compact View Mode -->
                <div id="compactView" class="compact-view" style="display: none;">
                    <div class="compact-sections">
                        @foreach (var zone in Model.Zones)
                        {
                            var isEmployeeZone = zone.VehicleTypeClass == "employee" || zone.MoTaLoaiXe.ToLower().Contains("nhân viên");
                            <div class="compact-section @(isEmployeeZone ? "employee-section" : "")" id="section-@zone.ZoneCode.ToLower()" onclick="toggleCompactSection('section-@zone.ZoneCode.ToLower()', event)">
                                <div class="compact-section-header">
                                    <div class="compact-section-icon @(zone.VehicleTypeClass)-icon">
                                        <i class="fas @zone.IconClass"></i>
                                    </div>
                                    <div class="compact-section-info">
                                        <h4 class="compact-section-title">
                                            @zone.TenKhuVuc - @zone.MoTaLoaiXe
                                            @if (isEmployeeZone)
                                            {
                                                <span class="vip-badge">VIP</span>
                                            }
                                        </h4>
                                        <div class="compact-section-stats">
                                            <span class="stat-badge available-badge">@zone.AvailableSlots trống</span>
                                            <span class="stat-badge occupied-badge">@zone.OccupiedSlots đỗ</span>
                                            @if (zone.ReservedSlots > 0)
                                            {
                                                <span class="stat-badge reserved-badge">@zone.ReservedSlots đặt</span>
                                            }
                                            @if (zone.MaintenanceSlots > 0)
                                            {
                                                <span class="stat-badge maintenance-badge">@zone.MaintenanceSlots bảo trì</span>
                                            }
                                        </div>
                                    </div>
                                    <div class="compact-section-summary">
                                        <div class="summary-percentage">@zone.OccupiedPercent%</div>
                                        <div class="summary-total">@zone.TotalSlots chỗ</div>
                                    </div>
                                    <button class="compact-expand-btn">
                                        <i class="fas fa-chevron-down"></i>
                                    </button>
                                </div>
                                <div class="compact-progress-bar">
                                    <div class="compact-progress-fill occupied-fill @(isEmployeeZone ? "employee-fill" : "")" style="width: @zone.OccupiedPercent%"></div>
                                    @if (zone.ReservedSlots > 0)
                                    {
                                        <div class="compact-progress-fill reserved-fill" style="width: @zone.ReservedPercent%"></div>
                                    }
                                    @if (zone.MaintenanceSlots > 0)
                                    {
                                        <div class="compact-progress-fill maintenance-fill" style="width: @zone.MaintenancePercent%"></div>
                                    }
                                </div>
                                
                                <!-- Expanded Content -->
                                <div class="compact-section-expanded" style="display: none;">
                                    <div class="expanded-grid @zone.GridClass">
                                        @foreach (var slot in zone.Slots)
                                        {
                                            <div class="parking-slot @slot.VehicleTypeClass @slot.TrangThaiText" 
                                                 data-slot="@slot.SlotCode" 
                                                 data-mavitri="@slot.MaViTri"
                                                 onclick="viewSlotDetails(@slot.MaViTri, '@slot.SlotCode'); event.stopPropagation();">
                                                <span class="slot-number">@slot.SlotCode</span>
                                                @if (slot.TrangThai == 1)
                                                {
                                                    <i class="fas @slot.IconClass"></i>
                                                }
                                                else if (slot.TrangThai == 2)
                                                {
                                                    <i class="fas fa-clock"></i>
                                                }
                                                else if (slot.TrangThai == 3)
                                                {
                                                    <i class="fas fa-tools"></i>
                                                }
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <!-- Parking Map Grid (Detail View) -->
                <div class="parking-map" id="detailView">
                    @foreach (var zone in Model.Zones)
                    {
                        var isEmployeeZone = zone.VehicleTypeClass == "employee" || zone.MoTaLoaiXe.ToLower().Contains("nhân viên");
                        <div class="parking-section">
                            <div class="section-header @(isEmployeeZone ? "employee-header" : "")">
                                <i class="fas @zone.IconClass"></i>
                                @zone.TenKhuVuc - @zone.MoTaLoaiXe (@zone.TotalSlots chỗ)
                                @if (isEmployeeZone)
                                {
                                    <span class="employee-badge">VIP</span>
                                }
                            </div>
                            <div class="parking-grid @zone.GridClass">
                                @foreach (var slot in zone.Slots)
                                {
                                    <div class="parking-slot @slot.VehicleTypeClass @slot.TrangThaiText" 
                                         data-slot="@slot.SlotCode" 
                                         data-mavitri="@slot.MaViTri"
                                         onclick="viewSlotDetails(@slot.MaViTri, '@slot.SlotCode')">
                                        <span class="slot-number">@slot.SlotCode</span>
                                        @if (slot.TrangThai == 1)
                                        {
                                            <i class="fas @slot.IconClass"></i>
                                        }
                                        else if (slot.TrangThai == 2)
                                        {
                                            <i class="fas fa-clock"></i>
                                        }
                                        else if (slot.TrangThai == 3)
                                        {
                                            <i class="fas fa-tools"></i>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Right Sidebar -->
    <div class="col-lg-4">
        <!-- Gate Status -->
        <div class="admin-card">
            <div class="admin-card-header">
                <h3 class="admin-card-title">Trạng thái cổng</h3>
            </div>
            <div class="gate-status-list">
                <div class="gate-status-item">
                    <div class="gate-info">
                        <div class="gate-icon active" id="gate-in-a-icon">
                            <i class="fas fa-sign-in-alt"></i>
                        </div>
                        <div>
                            <div class="gate-name">Cổng vào A</div>
                            <div class="gate-stats">
                                <span class="badge badge-success" id="gate-in-a-status">Đang mở</span>
                                <span class="gate-count">124 xe/ngày</span>
                            </div>
                        </div>
                    </div>
                    <div class="gate-actions">
                        <button class="btn btn-sm btn-outline-primary" onclick="viewGateCamera('gate-in-a')" title="Xem camera">
                            <i class="fas fa-video"></i>
                        </button>
                        <button class="btn btn-sm btn-outline-danger" id="btn-gate-in-a" onclick="toggleGate('gate-in-a', 'Cổng vào A')" title="Đóng cổng">
                            <i class="fas fa-lock"></i>
                        </button>
                        <button class="btn btn-sm btn-outline-warning" onclick="maintenanceGate('gate-in-a', 'Cổng vào A')" title="Bảo trì">
                            <i class="fas fa-tools"></i>
                        </button>
                    </div>
                </div>

                <div class="gate-status-item">
                    <div class="gate-info">
                        <div class="gate-icon active" id="gate-in-b-icon">
                            <i class="fas fa-sign-in-alt"></i>
                        </div>
                        <div>
                            <div class="gate-name">Cổng vào B</div>
                            <div class="gate-stats">
                                <span class="badge badge-success" id="gate-in-b-status">Đang mở</span>
                                <span class="gate-count">98 xe/ngày</span>
                            </div>
                        </div>
                    </div>
                    <div class="gate-actions">
                        <button class="btn btn-sm btn-outline-primary" onclick="viewGateCamera('gate-in-b')" title="Xem camera">
                            <i class="fas fa-video"></i>
                        </button>
                        <button class="btn btn-sm btn-outline-danger" id="btn-gate-in-b" onclick="toggleGate('gate-in-b', 'Cổng vào B')" title="Đóng cổng">
                            <i class="fas fa-lock"></i>
                        </button>
                        <button class="btn btn-sm btn-outline-warning" onclick="maintenanceGate('gate-in-b', 'Cổng vào B')" title="Bảo trì">
                            <i class="fas fa-tools"></i>
                        </button>
                    </div>
                </div>

                <div class="gate-status-item">
                    <div class="gate-info">
                        <div class="gate-icon active" id="gate-out-a-icon">
                            <i class="fas fa-sign-out-alt"></i>
                        </div>
                        <div>
                            <div class="gate-name">Cổng ra A</div>
                            <div class="gate-stats">
                                <span class="badge badge-success" id="gate-out-a-status">Đang mở</span>
                                <span class="gate-count">112 xe/ngày</span>
                            </div>
                        </div>
                    </div>
                    <div class="gate-actions">
                        <button class="btn btn-sm btn-outline-primary" onclick="viewGateCamera('gate-out-a')" title="Xem camera">
                            <i class="fas fa-video"></i>
                        </button>
                        <button class="btn btn-sm btn-outline-danger" id="btn-gate-out-a" onclick="toggleGate('gate-out-a', 'Cổng ra A')" title="Đóng cổng">
                            <i class="fas fa-lock"></i>
                        </button>
                        <button class="btn btn-sm btn-outline-warning" onclick="maintenanceGate('gate-out-a', 'Cổng ra A')" title="Bảo trì">
                            <i class="fas fa-tools"></i>
                        </button>
                    </div>
                </div>

                <div class="gate-status-item">
                    <div class="gate-info">
                        <div class="gate-icon active" id="gate-out-b-icon">
                            <i class="fas fa-sign-out-alt"></i>
                        </div>
                        <div>
                            <div class="gate-name">Cổng ra B</div>
                            <div class="gate-stats">
                                <span class="badge badge-success" id="gate-out-b-status">Đang mở</span>
                                <span class="gate-count">95 xe/ngày</span>
                            </div>
                        </div>
                    </div>
                    <div class="gate-actions">
                        <button class="btn btn-sm btn-outline-primary" onclick="viewGateCamera('gate-out-b')" title="Xem camera">
                            <i class="fas fa-video"></i>
                        </button>
                        <button class="btn btn-sm btn-outline-danger" id="btn-gate-out-b" onclick="toggleGate('gate-out-b', 'Cổng ra B')" title="Đóng cổng">
                            <i class="fas fa-lock"></i>
                        </button>
                        <button class="btn btn-sm btn-outline-warning" onclick="maintenanceGate('gate-out-b', 'Cổng ra B')" title="Bảo trì">
                            <i class="fas fa-tools"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Payment Counter Status -->
        <div class="admin-card">
            <div class="admin-card-header">
                <h3 class="admin-card-title">Chốt thu phí</h3>
            </div>
            <div class="counter-status-list">
                <div class="counter-status-item">
                    <div class="counter-icon inactive" id="counter-1-icon">
                        <i class="fas fa-cash-register"></i>
                    </div>
                    <div class="counter-info">
                        <div class="counter-name">Quầy 1</div>
                        <div class="counter-staff" id="counter-1-staff">
                            <i class="fas fa-spinner fa-spin"></i> Đang tải...
                        </div>
                        <div class="counter-revenue" id="counter-1-revenue">-- VNĐ</div>
                        
                        <!-- Enhanced Info -->
                        <div class="shift-info-quick" id="shift-info-1" style="display: none;">
                            <div class="shift-timer">
                                <i class="fas fa-clock"></i>
                                <span id="shift-duration-1">00:00:00</span>
                            </div>
                            <div class="shift-transactions">
                                <i class="fas fa-receipt"></i>
                                <span id="shift-transactions-1">0 giao dịch</span>
                            </div>
                            <div class="shift-target">
                                <i class="fas fa-bullseye"></i>
                                <span>Mục tiêu: <strong id="shift-target-1">2M</strong></span>
                                <div class="progress-bar-mini">
                                    <div class="progress-fill-mini" id="shift-progress-1" style="width: 0%"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="counter-status">
                        <span class="status-indicator offline" id="counter-1-indicator"></span>
                        <span class="status-text" id="counter-1-text">Đang tải...</span>
                    </div>
                    <div class="counter-actions">
                        <button class="btn btn-sm btn-outline-secondary" id="btn-counter-1" disabled title="Đang tải...">
                            <i class="fas fa-spinner fa-spin"></i>
                        </button>
                    </div>
                </div>
                
                <!-- Advanced Actions for Active Counter -->
                <div class="counter-advanced-actions" id="advanced-actions-1" style="display: none;">
                    <button class="btn btn-sm btn-info" onclick="viewShiftDetails(1)" title="Xem chi tiết ca">
                        <i class="fas fa-chart-line"></i> Chi tiết ca
                    </button>
                    <button class="btn btn-sm btn-warning" onclick="pauseShift(1)" title="Tạm nghỉ">
                        <i class="fas fa-pause"></i> Tạm nghỉ
                    </button>
                    <button class="btn btn-sm btn-primary" onclick="handoverShift(1)" title="Chuyển ca">
                        <i class="fas fa-exchange-alt"></i> Chuyển ca
                    </button>
                </div>

                <div class="counter-status-item">
                    <div class="counter-icon inactive" id="counter-2-icon">
                        <i class="fas fa-cash-register"></i>
                    </div>
                    <div class="counter-info">
                        <div class="counter-name">Quầy 2</div>
                        <div class="counter-staff" id="counter-2-staff">
                            <i class="fas fa-spinner fa-spin"></i> Đang tải...
                        </div>
                        <div class="counter-revenue" id="counter-2-revenue">-- VNĐ</div>
                        
                        <!-- Enhanced Info -->
                        <div class="shift-info-quick" id="shift-info-2" style="display: none;">
                            <div class="shift-timer">
                                <i class="fas fa-clock"></i>
                                <span id="shift-duration-2">00:00:00</span>
                            </div>
                            <div class="shift-transactions">
                                <i class="fas fa-receipt"></i>
                                <span id="shift-transactions-2">0 giao dịch</span>
                            </div>
                            <div class="shift-target">
                                <i class="fas fa-bullseye"></i>
                                <span>Mục tiêu: <strong id="shift-target-2">2M</strong></span>
                                <div class="progress-bar-mini">
                                    <div class="progress-fill-mini" id="shift-progress-2" style="width: 0%"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="counter-status">
                        <span class="status-indicator offline" id="counter-2-indicator"></span>
                        <span class="status-text" id="counter-2-text">Đang tải...</span>
                    </div>
                    <div class="counter-actions">
                        <button class="btn btn-sm btn-outline-secondary" id="btn-counter-2" disabled title="Đang tải...">
                            <i class="fas fa-spinner fa-spin"></i>
                        </button>
                    </div>
                </div>
                
                <!-- Advanced Actions for Active Counter -->
                <div class="counter-advanced-actions" id="advanced-actions-2" style="display: none;">
                    <button class="btn btn-sm btn-info" onclick="viewShiftDetails(2)" title="Xem chi tiết ca">
                        <i class="fas fa-chart-line"></i> Chi tiết ca
                    </button>
                    <button class="btn btn-sm btn-warning" onclick="pauseShift(2)" title="Tạm nghỉ">
                        <i class="fas fa-pause"></i> Tạm nghỉ
                    </button>
                    <button class="btn btn-sm btn-primary" onclick="handoverShift(2)" title="Chuyển ca">
                        <i class="fas fa-exchange-alt"></i> Chuyển ca
                    </button>
                </div>

                <div class="counter-status-item">
                    <div class="counter-icon inactive" id="counter-3-icon">
                        <i class="fas fa-cash-register"></i>
                    </div>
                    <div class="counter-info">
                        <div class="counter-name">Quầy 3</div>
                        <div class="counter-staff" id="counter-3-staff">
                            <i class="fas fa-spinner fa-spin"></i> Đang tải...
                        </div>
                        <div class="counter-revenue" id="counter-3-revenue">-- VNĐ</div>
                        
                        <!-- Enhanced Info -->
                        <div class="shift-info-quick" id="shift-info-3" style="display: none;">
                            <div class="shift-timer">
                                <i class="fas fa-clock"></i>
                                <span id="shift-duration-3">00:00:00</span>
                            </div>
                            <div class="shift-transactions">
                                <i class="fas fa-receipt"></i>
                                <span id="shift-transactions-3">0 giao dịch</span>
                            </div>
                            <div class="shift-target">
                                <i class="fas fa-bullseye"></i>
                                <span>Mục tiêu: <strong id="shift-target-3">2M</strong></span>
                                <div class="progress-bar-mini">
                                    <div class="progress-fill-mini" id="shift-progress-3" style="width: 0%"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="counter-status">
                        <span class="status-indicator offline" id="counter-3-indicator"></span>
                        <span class="status-text" id="counter-3-text">Đang tải...</span>
                    </div>
                    <div class="counter-actions">
                        <button class="btn btn-sm btn-outline-secondary" id="btn-counter-3" disabled title="Đang tải...">
                            <i class="fas fa-spinner fa-spin"></i>
                        </button>
                    </div>
                </div>
                
                <!-- Advanced Actions for Active Counter -->
                <div class="counter-advanced-actions" id="advanced-actions-3" style="display: none;">
                    <button class="btn btn-sm btn-info" onclick="viewShiftDetails(3)" title="Xem chi tiết ca">
                        <i class="fas fa-chart-line"></i> Chi tiết ca
                    </button>
                    <button class="btn btn-sm btn-warning" onclick="pauseShift(3)" title="Tạm nghỉ">
                        <i class="fas fa-pause"></i> Tạm nghỉ
                    </button>
                    <button class="btn btn-sm btn-primary" onclick="handoverShift(3)" title="Chuyển ca">
                        <i class="fas fa-exchange-alt"></i> Chuyển ca
                    </button>
                </div>
            </div>
        </div>

        <!-- Real-time Activity -->
        <div class="admin-card">
            <div class="admin-card-header">
                <h3 class="admin-card-title">Hoạt động trực tiếp</h3>
            </div>
            <div class="activity-list" id="activityList">
                @if (Model.RecentActivities != null && Model.RecentActivities.Any())
                {
                    @foreach (var activity in Model.RecentActivities.Take(10))
                    {
                        <div class="activity-item">
                            <div class="activity-icon @activity.ActivityClass">
                                <i class="fas @activity.IconClass"></i>
                            </div>
                            <div class="activity-details">
                                @if (activity.ActivityType == "entry")
                                {
                                    <div class="activity-title">Xe vào: <strong>@activity.BienSo</strong></div>
                                }
                                else if (activity.ActivityType == "exit")
                                {
                                    <div class="activity-title">Xe ra: <strong>@activity.BienSo</strong></div>
                                }
                                else if (activity.ActivityType == "payment")
                                {
                                    <div class="activity-title">Thanh toán: <strong>@(activity.SoTien?.ToString("N0") ?? "0") VNĐ</strong></div>
                                }
                                <div class="activity-time">@activity.TimeAgo</div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="text-center text-muted py-4">
                        <i class="fas fa-inbox fa-2x mb-2"></i>
                        <p>Chưa có hoạt động nào</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Peak Hours Chart -->
<div class="row mt-4">
    <div class="col-12">
        <div class="admin-card">
            <div class="admin-card-header">
                <h3 class="admin-card-title">
                    <i class="fas fa-chart-line"></i>
                    Biểu đồ giờ cao điểm đỗ xe
                </h3>
                <div>
                    <select class="form-select form-select-sm" id="chartTimeRange" onchange="updatePeakHoursChart()" style="width: 150px;">
                        <option value="today">Hôm nay</option>
                        <option value="yesterday">Hôm qua</option>
                        <option value="week">7 ngày qua</option>
                        <option value="month">30 ngày qua</option>
                    </select>
                </div>
            </div>
            <div class="admin-card-body">
                <div class="chart-container">
                    <canvas id="peakHoursChart"></canvas>
                </div>
                
                <!-- Chart Statistics -->
                <div class="chart-stats mt-4">
                    <div class="row">
                        <div class="col-md-3">
                            <div class="stat-box">
                                <div class="stat-icon peak-entry">
                                    <i class="fas fa-arrow-up"></i>
                                </div>
                                <div class="stat-info">
                                    <div class="stat-label">Giờ cao điểm vào</div>
                                    <div class="stat-value" id="peakEntryTime">08:00 - 09:00</div>
                                    <div class="stat-detail" id="peakEntryCount">124 xe</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="stat-box">
                                <div class="stat-icon peak-exit">
                                    <i class="fas fa-arrow-down"></i>
                                </div>
                                <div class="stat-info">
                                    <div class="stat-label">Giờ cao điểm ra</div>
                                    <div class="stat-value" id="peakExitTime">17:00 - 18:00</div>
                                    <div class="stat-detail" id="peakExitCount">156 xe</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="stat-box">
                                <div class="stat-icon avg-occupancy">
                                    <i class="fas fa-chart-bar"></i>
                                </div>
                                <div class="stat-info">
                                    <div class="stat-label">Công suất TB</div>
                                    <div class="stat-value" id="avgOccupancy">62%</div>
                                    <div class="stat-detail">Trong ngày</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="stat-box">
                                <div class="stat-icon total-vehicles">
                                    <i class="fas fa-car-side"></i>
                                </div>
                                <div class="stat-info">
                                    <div class="stat-label">Tổng lượt xe</div>
                                    <div class="stat-value" id="totalVehicles">429</div>
                                    <div class="stat-detail">Lượt vào/ra</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

