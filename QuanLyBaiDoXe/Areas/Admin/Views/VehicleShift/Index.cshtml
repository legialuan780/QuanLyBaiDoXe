@model List<QuanLyBaiDoXe.Areas.Admin.ViewModels.ShiftViewModel>

@{
    ViewData["Title"] = "Quản lý ca làm việc";
}

<!-- Page Header -->
<div class="page-header">
    <div>
        <h1 class="page-title">
            <i class="fas fa-clock"></i>
            Quản lý ca làm việc
        </h1>
        <div class="breadcrumb">
            <a href="@Url.Action("Index", "Dashboard", new { area = "Admin" })">Trang chủ</a>
            <span>/</span>
            <span>Ca làm việc</span>
        </div>
    </div>
    <div class="page-header-actions">
        <button class="btn-secondary-admin" onclick="location.href='@Url.Action("WeeklySchedule", "VehicleShift", new { area = "Admin" })'">
            <i class="fas fa-calendar-week"></i>
            Lập lịch tuần
        </button>
        <button class="btn-secondary-admin" onclick="location.href='@Url.Action("TimeSheet", "VehicleShift", new { area = "Admin" })'">
            <i class="fas fa-clock"></i>
            Bảng chấm công
        </button>
        <button class="btn-primary-admin" data-bs-toggle="modal" data-bs-target="#addShiftModal">
            <i class="fas fa-plus"></i>
            Mở ca mới
        </button>
    </div>
</div>

<!-- Stats Cards -->
<div class="stat-cards">
    <div class="stat-card">
        <div class="stat-card-icon teal">
            <i class="fas fa-business-time"></i>
        </div>
        <div class="stat-card-info">
            <h3 id="totalShifts">@Model.Count</h3>
            <p>Tổng số ca</p>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-card-icon green">
            <i class="fas fa-user-clock"></i>
        </div>
        <div class="stat-card-info">
            <h3 id="activeShifts">@Model.Count(s => s.TrangThaiCa == 0)</h3>
            <p>Ca đang trực</p>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-card-icon orange">
            <i class="fas fa-check-circle"></i>
        </div>
        <div class="stat-card-info">
            <h3 id="completedShifts">@Model.Count(s => s.TrangThaiCa == 1)</h3>
            <p>Ca đã chốt</p>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-card-icon teal">
            <i class="fas fa-money-bill-wave"></i>
        </div>
        <div class="stat-card-info">
            <h3 id="totalRevenue">@Model.Sum(s => s.TongTienHeThong).ToString("N0") đ</h3>
            <p>Tổng doanh thu hệ thống</p>
        </div>
    </div>
</div>

<!-- Filters & Actions -->
<div class="admin-card">
    <div class="admin-card-header">
        <h3 class="admin-card-title">Danh sách ca làm việc</h3>
        <div class="admin-card-actions">
            <div class="input-group" style="width: 200px;">
                <input type="date" class="form-control" id="filterDate" value="@DateTime.Today.ToString("yyyy-MM-dd")">
                <button class="btn-primary-admin" onclick="filterByDate()">
                    <i class="fas fa-filter"></i>
                </button>
            </div>
            <select class="form-select" id="filterStatus" onchange="filterByStatus()" style="width: 150px;">
                <option value="">Tất cả trạng thái</option>
                <option value="0">Đang trực</option>
                <option value="1">Đã chốt</option>
            </select>
        </div>
    </div>

    <!-- Shifts Table -->
    <div class="table-responsive">
        <table class="table admin-table">
            <thead>
                <tr>
                    <th>Mã ca</th>
                    <th>Nhân viên</th>
                    <th>Giờ nhận ca</th>
                    <th>Giờ giao ca</th>
                    <th>Số giờ làm</th>
                    <th>Tiền đầu ca</th>
                    <th>Tiền HT</th>
                    <th>Tiền bàn giao</th>
                    <th>Chênh lệch</th>
                    <th>Trạng thái</th>
                    <th>Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    @foreach (var shift in Model)
                    {
                        <tr>
                            <td><strong>#@shift.MaCa</strong></td>
                            <td>
                                <div class="d-flex align-items-center">
                                    <div class="employee-avatar">
                                        @shift.TenNhanVien.Substring(0, 1)
                                    </div>
                                    <span>@shift.TenNhanVien</span>
                                </div>
                            </td>
                            <td>@shift.ThoiGianNhanCa?.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@(shift.ThoiGianGiaoCa?.ToString("dd/MM/yyyy HH:mm") ?? "-")</td>
                            <td>@shift.SoGioLam.ToString("F1")h</td>
                            <td>@shift.TienDauCa.ToString("N0") đ</td>
                            <td class="text-info fw-bold">@shift.TongTienHeThong.ToString("N0") đ</td>
                            <td class="text-success fw-bold">@shift.TienMatBanGiao.ToString("N0") đ</td>
                            <td class="@(shift.ChenhLech >= 0 ? "text-success" : "text-danger") fw-bold">
                                @shift.ChenhLech.ToString("N0") đ
                            </td>
                            <td>
                                @if (shift.TrangThaiCa == 0)
                                {
                                    <span class="badge badge-success">
                                        <i class="fas fa-play-circle"></i>
                                        Đang trực
                                    </span>
                                }
                                else if (shift.TrangThaiCa == 1)
                                {
                                    <span class="badge badge-info">
                                        <i class="fas fa-check-circle"></i>
                                        Đã chốt
                                    </span>
                                }
                            </td>
                            <td>
                                <div class="action-buttons">
                                    <button class="btn-icon" onclick="viewShiftDetail(@shift.MaCa)" title="Xem chi tiết">
                                        <i class="fas fa-eye"></i>
                                    </button>
                                    @if (shift.TrangThaiCa == 0)
                                    {
                                        <button class="btn-icon btn-success" onclick="endShift(@shift.MaCa)" title="Chốt ca">
                                            <i class="fas fa-stop-circle"></i>
                                        </button>
                                    }
                                    <button class="btn-icon btn-primary" onclick="printShiftReport(@shift.MaCa)" title="In báo cáo">
                                        <i class="fas fa-print"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="11" class="text-center">
                            <div class="empty-state">
                                <i class="fas fa-inbox"></i>
                                <p>Chưa có ca làm việc nào</p>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Shift Detail Modal -->
<div class="modal fade" id="shiftDetailModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Chi tiết ca làm việc</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="shiftDetailContent">
                <div class="text-center">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Add Shift Modal -->
<div class="modal fade" id="addShiftModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="fas fa-plus-circle"></i>
                    Mở ca làm việc mới
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="addShiftForm">
                    <div class="mb-3">
                        <label class="form-label">Chọn nhân viên <span class="text-danger">*</span></label>
                        <select class="form-select" id="employeeSelect" name="MaNhanVien" required>
                            <option value="">-- Chọn nhân viên --</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Tiền đầu ca <span class="text-danger">*</span></label>
                        <input type="number" class="form-control" name="TienDauCa" value="0" required min="0" step="1000">
                    </div>
                    <div class="alert alert-info">
                        <i class="fas fa-info-circle"></i>
                        Ca làm việc sẽ bắt đầu ngay khi được tạo
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn-secondary-admin" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn-primary-admin" onclick="createShift()">
                    <i class="fas fa-check"></i>
                    Mở ca
                </button>
            </div>
        </div>
    </div>
</div>

<!-- End Shift Modal -->
<div class="modal fade" id="endShiftModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="fas fa-stop-circle"></i>
                    Chốt ca làm việc
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="endShiftForm">
                    <input type="hidden" id="endShiftId" name="MaCa">
                    
                    <div class="shift-summary mb-4">
                        <div class="row">
                            <div class="col-6">
                                <label>Tiền đầu ca:</label>
                                <div class="fw-bold text-primary" id="summaryTienDauCa">0 đ</div>
                            </div>
                            <div class="col-6">
                                <label>Tiền hệ thống:</label>
                                <div class="fw-bold text-info" id="summaryTongTienHeThong">0 đ</div>
                            </div>
                        </div>
                        <div class="row mt-3">
                            <div class="col-12">
                                <label>Tiền cuối ca (tính toán):</label>
                                <div class="fw-bold text-success fs-5" id="summaryTienCuoiCa">0 đ</div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label">Tiền mặt bàn giao <span class="text-danger">*</span></label>
                        <input type="number" class="form-control" id="tienMatBanGiao" name="TienMatBanGiao" required min="0" step="1000" oninput="calculateDifference()">
                    </div>
                    
                    <div class="mb-3">
                        <label>Chênh lệch:</label>
                        <div class="fw-bold fs-5" id="chenhLech">0 đ</div>
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label">Ghi chú bàn giao</label>
                        <textarea class="form-control" name="GhiChuBanGiao" rows="3"></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn-secondary-admin" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn-primary-admin" onclick="confirmEndShift()">
                    <i class="fas fa-check"></i>
                    Chốt ca
                </button>
            </div>
        </div>
    </div>
</div>

<link rel="stylesheet" href="~/css/vehicle-shift.css" />

@section Scripts {
    <script>
        // Load danh sách nhân viên khi mở modal
        $('#addShiftModal').on('show.bs.modal', function() {
            $.get('@Url.Action("GetAvailableEmployees", "VehicleShift", new { area = "Admin" })', function(data) {
                const select = $('#employeeSelect');
                select.empty();
                select.append('<option value="">-- Chọn nhân viên --</option>');
                data.forEach(emp => {
                    select.append(`<option value="${emp.maNhanVien}">${emp.hoTen} (${emp.chucVu})</option>`);
                });
            });
        });

        // Tạo ca mới
        function createShift() {
            const formData = {
                MaNhanVien: parseInt($('#employeeSelect').val()),
                TienDauCa: parseFloat($('input[name="TienDauCa"]').val())
            };

            if (!formData.MaNhanVien) {
                alert('Vui lòng chọn nhân viên');
                return;
            }

            $.ajax({
                url: '@Url.Action("CreateShift", "VehicleShift", new { area = "Admin" })',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(formData),
                success: function(response) {
                    if (response.success) {
                        alert(response.message);
                        location.reload();
                    } else {
                        alert('Lỗi: ' + response.message);
                    }
                },
                error: function() {
                    alert('Có lỗi xảy ra khi tạo ca');
                }
            });
        }

        let currentShiftData = {};
        
        // Mở modal chốt ca
        function endShift(shiftId) {
            $.get('@Url.Action("GetShiftDetail", "VehicleShift", new { area = "Admin" })', { id: shiftId }, function(data) {
                currentShiftData = data;
                $('#endShiftId').val(data.maCa);
                $('#summaryTienDauCa').text(data.tienDauCa.toLocaleString('vi-VN') + ' đ');
                $('#summaryTongTienHeThong').text(data.tongTienHeThong.toLocaleString('vi-VN') + ' đ');
                $('#summaryTienCuoiCa').text((data.tienDauCa + data.tongTienHeThong).toLocaleString('vi-VN') + ' đ');
                $('#tienMatBanGiao').val(data.tienDauCa + data.tongTienHeThong);
                calculateDifference();
                $('#endShiftModal').modal('show');
            });
        }

        // Tính chênh lệch
        function calculateDifference() {
            const tienCuoiCa = currentShiftData.tienDauCa + currentShiftData.tongTienHeThong;
            const tienMatBanGiao = parseFloat($('#tienMatBanGiao').val()) || 0;
            const chenhLech = tienMatBanGiao - tienCuoiCa;
            
            const chenhLechEl = $('#chenhLech');
            chenhLechEl.text(chenhLech.toLocaleString('vi-VN') + ' đ');
            
            if (chenhLech >= 0) {
                chenhLechEl.removeClass('text-danger').addClass('text-success');
            } else {
                chenhLechEl.removeClass('text-success').addClass('text-danger');
            }
        }

        // Xác nhận chốt ca
        function confirmEndShift() {
            const formData = {
                MaCa: parseInt($('#endShiftId').val()),
                TienMatBanGiao: parseFloat($('#tienMatBanGiao').val()),
                GhiChuBanGiao: $('textarea[name="GhiChuBanGiao"]').val()
            };

            $.ajax({
                url: '@Url.Action("EndShift", "VehicleShift", new { area = "Admin" })',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(formData),
                success: function(response) {
                    if (response.success) {
                        alert(response.message);
                        location.reload();
                    } else {
                        alert('Lỗi: ' + response.message);
                    }
                },
                error: function() {
                    alert('Có lỗi xảy ra khi chốt ca');
                }
            });
        }

        // Xem chi tiết ca
        function viewShiftDetail(shiftId) {
            $('#shiftDetailModal').modal('show');
            
            $.get('@Url.Action("GetShiftDetail", "VehicleShift", new { area = "Admin" })', { id: shiftId }, function(data) {
                const statusText = data.trangThaiCa === 0 ? 'Đang trực' : 'Đã chốt';
                const statusClass = data.trangThaiCa === 0 ? 'success' : 'info';
                const chenhLech = data.tienMatBanGiao - (data.tienDauCa + data.tongTienHeThong);
                
                const html = `
                    <div class="shift-detail-card">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="detail-item">
                                    <label>Mã ca:</label>
                                    <strong>#${data.maCa}</strong>
                                </div>
                                <div class="detail-item">
                                    <label>Nhân viên:</label>
                                    <strong>${data.tenNhanVien}</strong>
                                </div>
                                <div class="detail-item">
                                    <label>Thời gian nhận ca:</label>
                                    <span>${new Date(data.thoiGianNhanCa).toLocaleString('vi-VN')}</span>
                                </div>
                                <div class="detail-item">
                                    <label>Thời gian giao ca:</label>
                                    <span>${data.thoiGianGiaoCa ? new Date(data.thoiGianGiaoCa).toLocaleString('vi-VN') : 'Chưa giao ca'}</span>
                                </div>
                                <div class="detail-item">
                                    <label>Trạng thái:</label>
                                    <span class="badge badge-${statusClass}">${statusText}</span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="detail-item">
                                    <label>Tiền đầu ca:</label>
                                    <strong class="text-primary">${data.tienDauCa.toLocaleString('vi-VN')} đ</strong>
                                </div>
                                <div class="detail-item">
                                    <label>Tiền hệ thống:</label>
                                    <strong class="text-info">${data.tongTienHeThong.toLocaleString('vi-VN')} đ</strong>
                                </div>
                                <div class="detail-item">
                                    <label>Tiền bàn giao:</label>
                                    <strong class="text-success">${data.tienMatBanGiao.toLocaleString('vi-VN')} đ</strong>
                                </div>
                                <div class="detail-item">
                                    <label>Chênh lệch:</label>
                                    <strong class="${chenhLech >= 0 ? 'text-success' : 'text-danger'}">${chenhLech.toLocaleString('vi-VN')} đ</strong>
                                </div>
                                <div class="detail-item">
                                    <label>Số xe vào:</label>
                                    <strong>${data.soXeVao}</strong>
                                </div>
                                <div class="detail-item">
                                    <label>Số xe ra:</label>
                                    <strong>${data.soXeRa}</strong>
                                </div>
                            </div>
                        </div>
                        ${data.ghiChuBanGiao ? `
                        <div class="row mt-3">
                            <div class="col-12">
                                <div class="alert alert-info">
                                    <strong>Ghi chú:</strong> ${data.ghiChuBanGiao}
                                </div>
                            </div>
                        </div>
                        ` : ''}
                    </div>
                `;
                
                $('#shiftDetailContent').html(html);
            });
        }

        function filterByDate() {
            const date = $('#filterDate').val();
            if (date) {
                window.location.href = '@Url.Action("Index", "VehicleShift", new { area = "Admin" })?date=' + date;
            }
        }

        function filterByStatus() {
            const status = $('#filterStatus').val();
            const rows = $('tbody tr');
            
            if (!status) {
                rows.show();
                return;
            }
            
            rows.each(function() {
                const badge = $(this).find('.badge');
                const text = badge.text().trim();
                const show = (status === '0' && text.includes('Đang trực')) ||
                             (status === '1' && text.includes('Đã chốt'));
                $(this).toggle(show);
            });
        }

        function printShiftReport(shiftId) {
            window.open('@Url.Action("PrintShiftReport", "VehicleShift", new { area = "Admin" })?id=' + shiftId, '_blank');
        }
    </script>
}
