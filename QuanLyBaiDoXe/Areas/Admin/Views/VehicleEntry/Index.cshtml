    // ========== ALERT MODAL FUNCTIONS ==========
    // Hiển thị modal thông báo lỗi giữa màn hình
    function showAlertModal(message, type = 'error', title = null) {
        const modal = document.getElementById('alertModal');
        const icon = document.getElementById('alertIcon');
        const titleEl = document.getElementById('alertTitle');
        const messageEl = document.getElementById('alertMessage');

        // Set icon và title dựa trên type
        if (type === 'error') {
            icon.innerHTML = '<i class="fas fa-exclamation-circle"></i>';
            icon.className = 'alert-modal-icon error';
            titleEl.textContent = title || 'Lỗi';
        } else if (type === 'warning') {
            icon.innerHTML = '<i class="fas fa-exclamation-triangle"></i>';
            icon.className = 'alert-modal-icon warning';
            titleEl.textContent = title || 'Cảnh báo';
        } else if (type === 'success') {
            icon.innerHTML = '<i class="fas fa-check-circle"></i>';
            icon.className = 'alert-modal-icon success';
            titleEl.textContent = title || 'Thành công';
        }

        messageEl.textContent = message;
        modal.classList.add('show');
    }

    function closeAlertModal() {
        document.getElementById('alertModal').classList.remove('show');
    }

    // ========== PAYMENT MODAL FUNCTIONS ==========
    let pendingPaymentData = null;

    // Hiển thị modal thanh toán từ dữ liệu preview (CHƯA lưu database)
    function showPaymentModalPreview(previewData) {
        pendingPaymentData = {
            maThe: previewData.maThe,
            bienSo: previewData.bienSo,
            tenLoaiXe: previewData.tenLoaiXe,
            thoiGianVao: previewData.thoiGianVao,
            thoiGianRa: previewData.thoiGianRa,
            thoiGianGui: previewData.thoiGianGui,
            tongTien: previewData.tongTien,
            veThangHopLe: previewData.veThangHopLe,
            thongBaoVeThang: previewData.thongBaoVeThang
        };
        
        // Hiển thị thông tin
        document.getElementById('payMaThe').textContent = previewData.maThe || '-';
        document.getElementById('payBienSo').textContent = previewData.bienSo || '-';
        document.getElementById('payLoaiXe').textContent = previewData.tenLoaiXe || 'Chưa phân loại';
        document.getElementById('payThoiGian').textContent = previewData.thoiGianGui || '-';
        
        // Hiển thị giờ vào/ra
        document.getElementById('payGioVao').textContent = previewData.thoiGianVao 
            ? new Date(previewData.thoiGianVao).toLocaleString('vi-VN') 
            : '-';
        document.getElementById('payGioRa').textContent = previewData.thoiGianRa 
            ? new Date(previewData.thoiGianRa).toLocaleString('vi-VN') 
            : 'Vừa xong';
        
        // Hiển thị số tiền
        const tongTien = previewData.tongTien || 0;
        const formattedMoney = new Intl.NumberFormat('vi-VN').format(tongTien) + 'đ';
        document.getElementById('payTongTien').textContent = formattedMoney;
        document.getElementById('momoAmount').textContent = formattedMoney;

        // Hiển thị thông báo vé tháng nếu có
        const veThangNotice = document.getElementById('payVeThangNotice');
        if (veThangNotice) {
            if (previewData.veThangHopLe) {
                veThangNotice.className = 'monthly-ticket-info valid';
                veThangNotice.innerHTML = '<i class="fas fa-check-circle"></i> ' + (previewData.thongBaoVeThang || 'VÉ THÁNG HỢP LỆ - Miễn phí');
                veThangNotice.style.display = 'flex';
            } else if (previewData.thongBaoVeThang) {
                veThangNotice.className = 'monthly-ticket-info warning';
                veThangNotice.innerHTML = '<i class="fas fa-exclamation-triangle"></i> ' + previewData.thongBaoVeThang;
                veThangNotice.style.display = 'flex';
            } else {
                veThangNotice.style.display = 'none';
            }
        }
        
        // Nội dung chuyển khoản MoMo
        document.getElementById('momoContent').textContent = `GUIXE ${previewData.maThe}`;
        
        // Reset về trang chọn phương thức
        document.getElementById('paymentMethodsSection').style.display = 'block';
        document.getElementById('momoQRSection').classList.remove('show');
        
        // Mở modal
        document.getElementById('paymentModal').classList.add('show');
    }

    function closePaymentModal() {
        document.getElementById('paymentModal').classList.remove('show');
        // Không reset pendingPaymentData ở đây để có thể thử lại
    }

    async function showMomoQR() {
        if (!pendingPaymentData) {
            showAlertModal('Không có dữ liệu thanh toán!', 'error', 'Lỗi');
            return;
        }

        // Đóng modal thanh toán và hiển thị loading
        closePaymentModal();
        showNotification('Đang chuyển đến trang thanh toán MoMo...', 'success');

        try {
            // Gọi API tạo thanh toán MoMo
            const response = await fetch('/Admin/VehicleEntry/CreateMoMoPayment', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    maThe: pendingPaymentData.maThe,
                    bienSo: pendingPaymentData.bienSo,
                    hinhAnh: capturedImageData
                })
            });

            const data = await response.json();

            if (data.success && data.payUrl) {
                // Redirect trực tiếp đến trang thanh toán MoMo
                window.location.href = data.payUrl;
            } else {
                // Lỗi từ MoMo
                showAlertModal(data.message || 'Không thể tạo thanh toán MoMo. Vui lòng thử lại!', 'error', 'Lỗi MoMo');
            }
        } catch (err) {
            console.error('MoMo Error:', err);
            showAlertModal('Lỗi kết nối đến MoMo! Vui lòng thử lại.', 'error', 'Lỗi kết nối');
        }
    }

    function backToPaymentMethods() {
        document.getElementById('momoQRSection').classList.remove('show');
        document.getElementById('paymentMethodsSection').style.display = 'block';
    }

    // Xác nhận thanh toán - GỌI API LƯU DATABASE
    async function confirmPayment(method) {
        if (!pendingPaymentData) {
            showAlertModal('Không có dữ liệu thanh toán!', 'error', 'Lỗi');
            return;
        }

        try {
            const response = await fetch('/Admin/VehicleEntry/ConfirmXeRa', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    maThe: pendingPaymentData.maThe,
                    bienSo: pendingPaymentData.bienSo,
                    hinhAnh: capturedImageData,
                    phuongThucThanhToan: method
                })
            });

            const data = await response.json();

            if (data.success) {
                closePaymentModal();
                pendingPaymentData = null;
                
                const methodText = method === 'cash' ? 'tiền mặt' : 'MoMo';
                showNotification(`Xe ra thành công! Thanh toán bằng ${methodText}`, 'success');
                
                resetForm();
                refreshVehiclesList();
                refreshStats();
            } else {
                showAlertModal(data.message, 'error', 'Lỗi thanh toán');
            }
        } catch (err) {
            showAlertModal('Lỗi kết nối server! Vui lòng thử lại.', 'error', 'Lỗi kết nối');
        }
    }

    // Show image modal
    function showImageModal(imageSrc, title, bienSo, time) {
        const modal = document.getElementById('imageModal');
        const modalImage = document.getElementById('modalImage');
        const modalInfo = document.getElementById('modalInfo');

        modalImage.src = imageSrc;
        modalInfo.innerHTML = `<strong>${title}</strong>`;
