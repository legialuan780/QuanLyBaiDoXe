<!-- Work Schedule Modal -->
<div class="modal fade" id="workScheduleModal" tabindex="-1">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="fas fa-calendar-week"></i>
                    Lịch làm việc - <span id="scheduleModalTitle"></span>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <!-- Date Selector -->
                <div class="row mb-4">
                    <div class="col-md-4">
                        <label class="form-label fw-bold">
                            <i class="fas fa-calendar-day"></i>
                            Chọn ngày
                        </label>
                        <input type="date" class="form-control" id="scheduleDate" onchange="loadWorkSchedule()">
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold">
                            <i class="fas fa-user"></i>
                            Lọc theo nhân viên
                        </label>
                        <select class="form-select" id="scheduleEmployeeFilter" onchange="loadWorkSchedule()">
                            <option value="">-- Tất cả nhân viên --</option>
                        </select>
                    </div>
                    <div class="col-md-4 d-flex align-items-end">
                        <button class="btn btn-primary w-100" onclick="openAddScheduleForm()">
                            <i class="fas fa-plus"></i> Thêm lịch làm việc
                        </button>
                    </div>
                </div>

                <!-- Add Schedule Form (Hidden by default) -->
                <div id="addScheduleForm" style="display: none;" class="mb-4 p-3 border rounded bg-light">
                    <h6 class="mb-3"><i class="fas fa-plus-circle"></i> Thêm lịch làm việc mới</h6>
                    <div class="row">
                        <div class="col-md-3 mb-3">
                            <label class="form-label">Nhân viên <span class="text-danger">*</span></label>
                            <select class="form-select" id="newScheduleEmployee" required>
                                <option value="">-- Chọn nhân viên --</option>
                            </select>
                        </div>
                        <div class="col-md-2 mb-3">
                            <label class="form-label">Ngày làm việc <span class="text-danger">*</span></label>
                            <input type="date" class="form-control" id="newScheduleDate" required>
                        </div>
                        <div class="col-md-2 mb-3">
                            <label class="form-label">Giờ bắt đầu <span class="text-danger">*</span></label>
                            <input type="time" class="form-control" id="newScheduleStartTime" value="06:00" required>
                        </div>
                        <div class="col-md-2 mb-3">
                            <label class="form-label">Giờ kết thúc <span class="text-danger">*</span></label>
                            <input type="time" class="form-control" id="newScheduleEndTime" value="14:00" required>
                        </div>
                        <div class="col-md-3 mb-3">
                            <label class="form-label">Loại ca</label>
                            <select class="form-select" id="newScheduleType">
                                <option value="0">Ca thường</option>
                                <option value="1">Tăng ca</option>
                                <option value="2">Ca đêm</option>
                            </select>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-9 mb-3">
                            <label class="form-label">Ghi chú</label>
                            <textarea class="form-control" id="newScheduleNote" rows="2" placeholder="Ghi chú (tùy chọn)"></textarea>
                        </div>
                        <div class="col-md-3 mb-3 d-flex align-items-end gap-2">
                            <button class="btn btn-success flex-fill" onclick="submitAddSchedule()">
                                <i class="fas fa-save"></i> Lưu
                            </button>
                            <button class="btn btn-secondary" onclick="closeAddScheduleForm()">
                                <i class="fas fa-times"></i> Hủy
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Schedule List -->
                <div id="scheduleListContainer">
                    <div class="text-center">
                        <i class="fas fa-spinner fa-spin"></i> Đang tải...
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn-secondary-admin" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

<!-- Request Approval Modal -->
<div class="modal fade" id="requestApprovalModal" tabindex="-1">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="fas fa-tasks"></i>
                    Xét duyệt yêu cầu
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <!-- Filter Tabs -->
                <div class="filter-tabs">
                    <button class="filter-tab active" data-status="0" onclick="filterRequests(0)">
                        <i class="fas fa-clock"></i>
                        Chờ duyệt
                        <span class="count-badge" id="pendingCount">0</span>
                    </button>
                    <button class="filter-tab" data-status="1" onclick="filterRequests(1)">
                        <i class="fas fa-check-circle"></i>
                        Đã duyệt
                        <span class="count-badge" id="approvedCount">0</span>
                    </button>
                    <button class="filter-tab" data-status="2" onclick="filterRequests(2)">
                        <i class="fas fa-times-circle"></i>
                        Từ chối
                        <span class="count-badge" id="rejectedCount">0</span>
                    </button>
                    <button class="filter-tab" data-status="-1" onclick="filterRequests(-1)">
                        <i class="fas fa-list"></i>
                        Tất cả
                        <span class="count-badge" id="totalCount">0</span>
                    </button>
                </div>

                <!-- Requests List -->
                <div id="requestsListContainer">
                    <div class="text-center py-5">
                        <i class="fas fa-spinner fa-spin"></i> Đang tải...
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn-secondary-admin" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

<!-- Request Detail Modal -->
<div class="modal fade" id="requestDetailModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="fas fa-info-circle"></i>
                    Chi tiết yêu cầu
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="requestDetailContent">
                <p class="text-center"><i class="fas fa-spinner fa-spin"></i> Đang tải...</p>
            </div>
            <div class="modal-footer" id="requestDetailFooter">
                <button type="button" class="btn-secondary-admin" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function previousMonth() {
            let month = parseInt($('#selectMonth').val()) - 1;
            let year = parseInt($('#selectYear').val());
            
            if (month < 1) {
                month = 12;
                year--;
            }
            
            window.location.href = '@Url.Action("TimeSheet", "VehicleShift", new { area = "Admin" })?month=' + month + '&year=' + year;
        }

        function nextMonth() {
            let month = parseInt($('#selectMonth').val()) + 1;
            let year = parseInt($('#selectYear').val());
            
            if (month > 12) {
                month = 1;
                year++;
            }
            
            window.location.href = '@Url.Action("TimeSheet", "VehicleShift", new { area = "Admin" })?month=' + month + '&year=' + year;
        }

        function changeMonth() {
            const month = $('#selectMonth').val();
            const year = $('#selectYear').val();
            window.location.href = '@Url.Action("TimeSheet", "VehicleShift", new { area = "Admin" })?month=' + month + '&year=' + year;
        }

        function scrollToToday() {
            const todayCard = document.querySelector('.day-card.today');
            if (todayCard) {
                todayCard.scrollIntoView({ behavior: 'smooth', block: 'center' });
                todayCard.style.transform = 'scale(1.02)';
                setTimeout(() => {
                    todayCard.style.transform = 'scale(1)';
                }, 300);
            } else {
                alert('Hôm nay không có trong tháng đã chọn');
            }
        }

        function viewShiftDetail(shiftId) {
            $('#shiftDetailModal').modal('show');
            $('#shiftDetailContent').html('<p class="text-center"><i class="fas fa-spinner fa-spin"></i> Đang tải...</p>');
            
            $.get('@Url.Action("GetShiftDetail", "VehicleShift", new { area = "Admin" })', 
                { id: shiftId },
                function(data) {
                    if (data) {
                        let html = `
                            <div class="shift-detail">
                                <div class="detail-section">
                                    <h6><i class="fas fa-info-circle"></i> Thông tin chung</h6>
                                    <table class="table table-sm">
                                        <tr>
                                            <th width="30%">Mã ca:</th>
                                            <td><strong>#${data.maCa}</strong></td>
                                        </tr>
                                        <tr>
                                            <th>Nhân viên:</th>
                                            <td>${data.tenNhanVien || 'N/A'}</td>
                                        </tr>
                                        <tr>
                                            <th>Trạng thái:</th>
                                            <td><span class="badge badge-${data.trangThaiCa === 0 ? 'success' : 'info'}">${data.trangThaiCa === 0 ? 'Đang trực' : 'Đã chốt'}</span></td>
                                        </tr>
                                    </table>
                                </div>
                                <div class="detail-section">
                                    <h6><i class="fas fa-clock"></i> Thời gian</h6>
                                    <table class="table table-sm">
                                        <tr>
                                            <th width="30%">Nhận ca:</th>
                                            <td>${data.thoiGianNhanCa ? new Date(data.thoiGianNhanCa).toLocaleString('vi-VN') : 'N/A'}</td>
                                        </tr>
                                        <tr>
                                            <th>Giao ca:</th>
                                            <td>${data.thoiGianGiaoCa ? new Date(data.thoiGianGiaoCa).toLocaleString('vi-VN') : 'Chưa giao ca'}</td>
                                        </tr>
                                        <tr>
                                            <th>Số giờ làm:</th>
                                            <td><strong>${data.soGioLam ? data.soGioLam.toFixed(1) + 'h' : 'N/A'}</strong></td>
                                        </tr>
                                    </table>
                                </div>
                                <div class="detail-section">
                                    <h6><i class="fas fa-money-bill-wave"></i> Tài chính</h6>
                                    <table class="table table-sm">
                                        <tr>
                                            <th width="30%">Tiền đầu ca:</th>
                                            <td>${data.tienDauCa ? data.tienDauCa.toLocaleString('vi-VN') + ' đ' : '0 đ'}</td>
                                        </tr>
                                        <tr>
                                            <th>Doanh thu hệ thống:</th>
                                            <td class="text-success"><strong>${data.tongTienHeThong ? data.tongTienHeThong.toLocaleString('vi-VN') + ' đ' : '0 đ'}</strong></td>
                                        </tr>
                                        <tr>
                                            <th>Tiền cuối ca:</th>
                                            <td>${data.tienCuoiCa ? data.tienCuoiCa.toLocaleString('vi-VN') + ' đ' : '0 đ'}</td>
                                        </tr>
                                        <tr>
                                            <th>Tiền bàn giao:</th>
                                            <td>${data.tienMatBanGiao ? data.tienMatBanGiao.toLocaleString('vi-VN') + ' đ' : '0 đ'}</td>
                                        </tr>
                                        <tr>
                                            <th>Chênh lệch:</th>
                                            <td class="${data.chenhLech > 0 ? 'text-success' : data.chenhLech < 0 ? 'text-danger' : ''}">
                                                <strong>${data.chenhLech ? data.chenhLech.toLocaleString('vi-VN') + ' đ' : '0 đ'}</strong>
                                            </td>
                                        </tr>
                                    </table>
                                </div>
                                ${data.ghiChuBanGiao ? `
                                <div class="detail-section">
                                    <h6><i class="fas fa-sticky-note"></i> Ghi chú</h6>
                                    <p class="mb-0">${data.ghiChuBanGiao}</p>
                                </div>
                                ` : ''}
                            </div>
                        `;
                        $('#shiftDetailContent').html(html);
                    } else {
