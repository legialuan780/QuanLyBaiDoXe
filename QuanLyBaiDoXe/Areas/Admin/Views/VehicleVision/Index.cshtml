                <button type="button" class="btn btn-warning" id="btnToggleMaintenance" onclick="toggleSlotMaintenance()" style="display: none;">
                    <i class="fas fa-tools"></i>
                    <span id="btnMaintenanceText">Đặt bảo trì</span>
                </button>
                <button type="button" class="btn btn-primary" id="btnNavigate" onclick="navigateToSlot()">
                    <i class="fas fa-route"></i>
                    Dẫn đường
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Confirm Maintenance Modal -->
