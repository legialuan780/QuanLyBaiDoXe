@*
    Helper ?? th?ng nh?t hi?n th? icon và màu s?c cho các lo?i s? c?
*@

@functions {
    public static string GetAnomalyIcon(string loaiSuCo)
    {
        return loaiSuCo switch
        {
            "Xe mất thẻ" => "fas fa-id-card-alt",
            "Lỗi barrier" => "fas fa-road-barrier",
            "Lỗi camera" => "fas fa-video-slash",
            "Tranh chấp phí" => "fas fa-hand-holding-usd",
            "Khẩn cấp" => "fas fa-exclamation-triangle",
            _ => "fas fa-flag"
        };
    }

    public static string GetAnomalyColorClass(string loaiSuCo)
    {
        return loaiSuCo switch
        {
            "Xe mất thẻ" => "warning",
            "Lỗi barrier" => "danger",
            "Lỗi camera" => "info",
            "Tranh chấp phí" => "purple",
            "Khấn cấp" => "danger",
            _ => "secondary"
        };
    }

    public static string GetAnomalyBgColor(string loaiSuCo)
    {
        return loaiSuCo switch
        {
            "Xe mất thẻ" => "bg-warning",
            "Lỗi barrier" => "bg-danger",
            "Lỗi camera" => "bg-info",
            "Tranh chấp phí" => "bg-purple",
            "Khẩn cấp" => "bg-danger",
            _ => "bg-secondary"
        };
    }

    public static string GetAnomalyHexColor(string loaiSuCo)
    {
        return loaiSuCo switch
        {
            "Xe mất thẻ" => "#f39c12",
            "Lỗi barrier" => "#e74c3c",
            "Lỗi camera" => "#3498db",
            "Tranh chấp phí" => "#9b59b6",
            "Khẩn cấp" => "#e74c3c",
            _ => "#95a5a6"
        };
    }
}

@*
    CSS cho màu purple (thêm vào n?u ch?a có)
*@
<style>
    .bg-purple {
        background-color: #9b59b6 !important;
    }
    
    .text-purple {
        color: #9b59b6 !important;
    }
    
    .badge.bg-purple {
        color: #fff;
    }
</style>
