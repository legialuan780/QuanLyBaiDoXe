        // Load lịch làm việc
        function loadWorkSchedule() {
            const date = $('#scheduleDate').val();
            const employeeId = $('#scheduleEmployeeFilter').val();
            
            if (!date) {
                $('#scheduleListContainer').html('<div class="alert alert-warning"><i class="fas fa-exclamation-triangle"></i> Vui lòng chọn ngày</div>');
                return;
            }

            // Update title
            const dateObj = new Date(date);
            const dateStr = dateObj.toLocaleDateString('vi-VN', { 
                weekday: 'long', 
                year: 'numeric', 
                month: 'long', 
                day: 'numeric' 
            });
            $('#scheduleModalTitle').text(dateStr);

            $('#scheduleListContainer').html('<div class="text-center"><i class="fas fa-spinner fa-spin"></i> Đang tải...</div>');
            
            $.get('@Url.Action("GetWorkSchedules", "VehicleShift", new { area = "Admin" })', 
                { date: date, employeeId: employeeId },
                function(data) {
                    if (data.success && data.schedules && data.schedules.length > 0) {
                        displayWorkSchedules(data.schedules);
                    } else {
                        $('#scheduleListContainer').html(`
                            <div class="no-schedule">
                                <i class="fas fa-calendar-times"></i>
                                <p>Không có lịch làm việc nào trong ngày này</p>
                            </div>
                        `);
                    }
                }
            ).fail(function() {
                $('#scheduleListContainer').html('<div class="alert alert-danger"><i class="fas fa-times-circle"></i> Lỗi khi tải dữ liệu</div>');
            });
        }

        // Hiển thị danh sách lịch làm việc
        function displayWorkSchedules(schedules) {
            let html = '';
            
            schedules.forEach(schedule => {
                const shiftClass = schedule.loaiCa === 0 ? 'shift-morning' : 
                                 schedule.loaiCa === 1 ? 'shift-afternoon' : 'shift-night';
                
                const shiftIcon = schedule.loaiCa === 0 ? 'fa-sun' : 
                                schedule.loaiCa === 1 ? 'fa-cloud-sun' : 'fa-moon';
                
                const shiftTypeName = schedule.loaiCa === 0 ? 'Ca thường' : 
                                    schedule.loaiCa === 1 ? 'Tăng ca' : 'Ca đêm';
                
                const statusBadge = schedule.trangThai === 1 
                    ? '<span class="badge bg-success">Làm việc</span>' 
                    : '<span class="badge bg-secondary">Nghỉ</span>';

                html += `
                    <div class="schedule-card ${shiftClass}">
                        <div class="schedule-header">
                            <div>
                                <div class="schedule-employee">
                                    <i class="fas fa-user"></i>
                                    ${schedule.tenNhanVien}
                                    ${statusBadge}
                                </div>
                                <div class="schedule-time">
                                    <i class="fas ${shiftIcon}"></i>
                                    <strong>${shiftTypeName}</strong>
                                    <span class="mx-2">|</span>
                                    <i class="fas fa-clock"></i>
                                    ${schedule.gioBatDau} - ${schedule.gioKetThuc}
                                </div>
                                ${schedule.ghiChu ? `<small class="text-muted"><i class="fas fa-sticky-note"></i> ${schedule.ghiChu}</small>` : ''}
                            </div>
                            <div class="schedule-actions">
                                <button class="btn btn-sm btn-warning" onclick="editWorkSchedule(${schedule.maLich})" title="Sửa">
                                    <i class="fas fa-edit"></i>
                                </button>
                                <button class="btn btn-sm btn-danger" onclick="deleteWorkSchedule(${schedule.maLich})" title="Xóa">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                `;
            });
            
            $('#scheduleListContainer').html(html);
        }

        // Mở form thêm lịch
        function openAddScheduleForm() {
            $('#addScheduleForm').slideDown();
            
            // Set ngày mặc định
            const selectedDate = $('#scheduleDate').val();
            if (selectedDate) {
                $('#newScheduleDate').val(selectedDate);
            }
        }

        // Đóng form thêm lịch
        function closeAddScheduleForm() {
            $('#addScheduleForm').slideUp();
            
            // Reset form
            $('#newScheduleEmployee').val('');
            $('#newScheduleDate').val('');
            $('#newScheduleStartTime').val('06:00');
            $('#newScheduleEndTime').val('14:00');
            $('#newScheduleType').val('0');
            $('#newScheduleNote').val('');
        }

        // Submit thêm lịch làm việc
        function submitAddSchedule() {
            const employeeId = $('#newScheduleEmployee').val();
            const date = $('#newScheduleDate').val();
            const startTime = $('#newScheduleStartTime').val();
            const endTime = $('#newScheduleEndTime').val();
            const type = parseInt($('#newScheduleType').val());
            const note = $('#newScheduleNote').val();

            if (!employeeId || !date || !startTime || !endTime) {
                alert('Vui lòng điền đầy đủ thông tin bắt buộc');
                return;
            }

            // Validate time
            if (startTime >= endTime) {
                alert('Giờ kết thúc phải lớn hơn giờ bắt đầu');
                return;
            }

            const data = {
                MaNhanVien: parseInt(employeeId),
                NgayLamViec: date,
                GioBatDau: startTime,
                GioKetThuc: endTime,
                LoaiCa: type,
                TrangThai: 1,
                GhiChu: note
            };

            $.ajax({
                url: '@Url.Action("AddWorkSchedule", "VehicleShift", new { area = "Admin" })',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(data),
                success: function(response) {
                    if (response.success) {
                        alert(response.message || 'Thêm lịch làm việc thành công!');
                        closeAddScheduleForm();
                        loadWorkSchedule();
                    } else {
                        alert('Lỗi: ' + response.message);
                    }
                },
                error: function() {
                    alert('Có lỗi xảy ra khi thêm lịch làm việc');
                }
            });
        }

        // Sửa lịch làm việc
        function editWorkSchedule(scheduleId) {
            // TODO: Implement edit functionality
            alert('Chức năng sửa lịch đang được phát triển');
        }

        // Xóa lịch làm việc
        function deleteWorkSchedule(scheduleId) {
            if (!confirm('Bạn có chắc chắn muốn xóa lịch làm việc này?')) {
                return;
            }

            $.ajax({
                url: '@Url.Action("DeleteWorkSchedule", "VehicleShift", new { area = "Admin" })',
                type: 'POST',
                data: { id: scheduleId },
                success: function(response) {
                    if (response.success) {
                        alert(response.message || 'Xóa lịch làm việc thành công!');
                        loadWorkSchedule();
                    } else {
                        alert('Lỗi: ' + response.message);
                    }
                },
                error: function() {
                    alert('Có lỗi xảy ra khi xóa lịch làm việc');
                }
            });
        }

        // ========== REQUEST APPROVAL FUNCTIONS ==========

        let currentRequestStatus = 0; // Mặc định hiển thị "Chờ duyệt"

        // Mở modal xét duyệt yêu cầu
        function openRequestApprovalModal() {
            $('#requestApprovalModal').modal('show');
            currentRequestStatus = 0;
            loadScheduleRequests();
        }

        // Load danh sách yêu cầu
        function loadScheduleRequests() {
            $('#requestsListContainer').html('<div class="text-center py-5"><i class="fas fa-spinner fa-spin fa-2x"></i><p class="mt-2">Đang tải...</p></div>');
            
            $.get('@Url.Action("GetScheduleRequests", "VehicleShift", new { area = "Admin" })', 
                { status: currentRequestStatus },
                function(data) {
                    if (data.success) {
                        // Update counts
                        $('#pendingCount').text(data.counts.pending || 0);
                        $('#approvedCount').text(data.counts.approved || 0);
                        $('#rejectedCount').text(data.counts.rejected || 0);
                        $('#totalCount').text(data.counts.total || 0);
                        
                        // Update badge on button
                        const pendingCount = data.counts.pending || 0;
                        if (pendingCount > 0) {
                            $('#pendingRequestBadge').text(pendingCount).show();
                        } else {
                            $('#pendingRequestBadge').hide();
                        }
                        
                        // Display requests
                        if (data.requests && data.requests.length > 0) {
                            displayScheduleRequests(data.requests);
                        } else {
                            $('#requestsListContainer').html(`
                                <div class="no-requests">
                                    <i class="fas fa-inbox"></i>
                                    <p>Không có yêu cầu nào</p>
                                </div>
                            `);
                        }
                    } else {
                        $('#requestsListContainer').html(`
                            <div class="alert alert-danger">
                                <i class="fas fa-exclamation-triangle"></i>
                                ${data.message || 'Lỗi khi tải dữ liệu'}
                            </div>
                        `);
                    }
                }
            ).fail(function() {
                $('#requestsListContainer').html(`
                    <div class="alert alert-danger">
                        <i class="fas fa-times-circle"></i>
                        Lỗi khi tải dữ liệu yêu cầu
                    </div>
                `);
            });
        }

        // Filter requests by status
        function filterRequests(status) {
            currentRequestStatus = status;
            
            // Update active tab
            $('.filter-tab').removeClass('active');
            $(`.filter-tab[data-status="${status}"]`).addClass('active');
            
            // Reload requests
            loadScheduleRequests();
        }

        // Hiển thị danh sách yêu cầu
        function displayScheduleRequests(requests) {
            let html = '';
            
            requests.forEach(request => {
                const requestTypeClass = request.loaiYeuCau === 0 ? 'request-time-off' : 
                                       request.loaiYeuCau === 1 ? 'request-shift-change' : 'request-time-change';
                
                const requestTypeIcon = request.loaiYeuCau === 0 ? 'fa-calendar-times' : 
                                      request.loaiYeuCau === 1 ? 'fa-exchange-alt' : 'fa-clock';
                
                const requestTypeName = request.loaiYeuCau === 0 ? 'Xin nghỉ' : 
                                      request.loaiYeuCau === 1 ? 'Đổi ca' : 'Đổi giờ';
                
                const requestTypeColor = request.loaiYeuCau === 0 ? 'danger' : 
                                       request.loaiYeuCau === 1 ? 'info' : 'warning';
                
                let statusBadge = '';
                let statusClass = '';
                
                if (request.trangThaiDuyet === 0) {
                    statusBadge = '<span class="badge bg-warning">Chờ duyệt</span>';
                } else if (request.trangThaiDuyet === 1) {
                    statusBadge = '<span class="badge bg-success">Đã duyệt</span>';
                    statusClass = 'approved';
                } else if (request.trangThaiDuyet === 2) {
                    statusBadge = '<span class="badge bg-danger">Từ chối</span>';
                    statusClass = 'rejected';
                } else if (request.trangThaiDuyet === 3) {
                    statusBadge = '<span class="badge bg-secondary">Đã hủy</span>';
                }

                const requestDate = new Date(request.ngayYeuCau);
                const formattedDate = requestDate.toLocaleString('vi-VN');

                html += `
                    <div class="request-card ${requestTypeClass} ${statusClass}">
                        <div class="request-header">
                            <div>
                                <div class="request-employee">
                                    <i class="fas fa-user-circle"></i>
                                    ${request.tenNhanVien}
                                    <span class="request-type-badge bg-${requestTypeColor} text-white">
                                        <i class="fas ${requestTypeIcon}"></i> ${requestTypeName}
                                    </span>
                                    ${statusBadge}
                                </div>
                            </div>
                        </div>
                        
                        <div class="request-body">
                            <div class="request-info-row">
                                <i class="fas fa-calendar"></i>
                                <strong>Ngày yêu cầu:</strong>
                                <span>${formattedDate}</span>
                            </div>
                            
                            ${request.ngayLamMoi ? `
                            <div class="request-info-row">
                                <i class="fas fa-calendar-day"></i>
                                <strong>Ngày làm mới:</strong>
                                <span>${new Date(request.ngayLamMoi).toLocaleDateString('vi-VN')}</span>
                            </div>
                            ` : ''}
                            
                            ${request.gioBatDauMoi && request.gioKetThucMoi ? `
                            <div class="request-info-row">
                                <i class="fas fa-clock"></i>
                                <strong>Giờ làm mới:</strong>
                                <span>${request.gioBatDauMoi} - ${request.gioKetThucMoi}</span>
                            </div>
                            ` : ''}
                            
                            ${request.lyDo ? `
                            <div class="request-info-row">
                                <i class="fas fa-comment"></i>
                                <strong>Lý do:</strong>
                                <span>${request.lyDo}</span>
                            </div>
                            ` : ''}
                            
                            ${request.tenNhanVienDuyet ? `
                            <div class="request-info-row">
                                <i class="fas fa-user-check"></i>
                                <strong>Người duyệt:</strong>
                                <span>${request.tenNhanVienDuyet}</span>
                            </div>
                            ` : ''}
                            
                            ${request.ghiChuDuyet ? `
                            <div class="request-info-row">
                                <i class="fas fa-sticky-note"></i>
                                <strong>Ghi chú duyệt:</strong>
                                <span>${request.ghiChuDuyet}</span>
                            </div>
                            ` : ''}
                        </div>
                        
                        <div class="request-footer">
                            <div class="request-meta">
                                <small class="text-muted">
                                    <i class="fas fa-hashtag"></i> Mã: ${request.maDangKy}
                                </small>
                            </div>
                            <div class="request-actions">
                                <button class="btn btn-sm btn-info" onclick="viewRequestDetail(${request.maDangKy})" title="Xem chi tiết">
                                    <i class="fas fa-eye"></i> Chi tiết
                                </button>
                                ${request.trangThaiDuyet === 0 ? `
                                    <button class="btn btn-sm btn-success" onclick="approveRequest(${request.maDangKy})" title="Duyệt">
                                        <i class="fas fa-check"></i> Duyệt
                                    </button>
                                    <button class="btn btn-sm btn-danger" onclick="rejectRequest(${request.maDangKy})" title="Từ chối">
                                        <i class="fas fa-times"></i> Từ chối
                                    </button>
                                ` : ''}
                            </div>
                        </div>
                    </div>
                `;
            });
            
            $('#requestsListContainer').html(html);
        }

        // Xem chi tiết yêu cầu
        function viewRequestDetail(requestId) {
            $('#requestDetailModal').modal('show');
            $('#requestDetailContent').html('<p class="text-center py-4"><i class="fas fa-spinner fa-spin"></i> Đang tải...</p>');
            
            $.get('@Url.Action("GetRequestDetail", "VehicleShift", new { area = "Admin" })', 
                { id: requestId },
                function(data) {
                    if (data.success && data.request) {
                        displayRequestDetail(data.request);
                    } else {
                        $('#requestDetailContent').html(`
                            <div class="alert alert-danger">
                                <i class="fas fa-exclamation-triangle"></i>
                                ${data.message || 'Không tìm thấy thông tin yêu cầu'}
                            </div>
                        `);
                    }
                }
            ).fail(function() {
                $('#requestDetailContent').html(`
                    <div class="alert alert-danger">
                        <i class="fas fa-times-circle"></i>
                        Lỗi khi tải dữ liệu
                    </div>
                `);
            });
        }

        // Hiển thị chi tiết yêu cầu
        function displayRequestDetail(request) {
            const requestTypeName = request.loaiYeuCau === 0 ? 'Xin nghỉ' : 
                                  request.loaiYeuCau === 1 ? 'Đổi ca' : 'Đổi giờ';
            
            const statusText = request.trangThaiDuyet === 0 ? 'Chờ duyệt' :
                             request.trangThaiDuyet === 1 ? 'Đã duyệt' :
                             request.trangThaiDuyet === 2 ? 'Từ chối' : 'Đã hủy';
            
            const statusClass = request.trangThaiDuyet === 0 ? 'warning' :
                              request.trangThaiDuyet === 1 ? 'success' :
                              request.trangThaiDuyet === 2 ? 'danger' : 'secondary';

            let html = `
                <div class="row mb-3">
                    <div class="col-md-6">
                        <h6 class="text-muted mb-2">Thông tin chung</h6>
                        <table class="table table-sm table-borderless">
                            <tr>
                                <td width="40%" class="fw-bold">Mã yêu cầu:</td>
                                <td>#${request.maDangKy}</td>
                            </tr>
                            <tr>
                                <td class="fw-bold">Nhân viên:</td>
                                <td>${request.tenNhanVien}</td>
                            </tr>
                            <tr>
                                <td class="fw-bold">Loại yêu cầu:</td>
                                <td><span class="badge bg-info">${requestTypeName}</span></td>
                            </tr>
                            <tr>
                                <td class="fw-bold">Trạng thái:</td>
                                <td><span class="badge bg-${statusClass}">${statusText}</span></td>
                            </tr>
                            <tr>
                                <td class="fw-bold">Ngày yêu cầu:</td>
                                <td>${new Date(request.ngayYeuCau).toLocaleString('vi-VN')}</td>
                            </tr>
                        </table>
                    </div>
                    
                    <div class="col-md-6">
                        <h6 class="text-muted mb-2">Thông tin thay đổi</h6>
                        <table class="table table-sm table-borderless">
                            ${request.ngayLamMoi ? `
                            <tr>
                                <td width="40%" class="fw-bold">Ngày làm mới:</td>
                                <td>${new Date(request.ngayLamMoi).toLocaleDateString('vi-VN')}</td>
                            </tr>
                            ` : ''}
                            ${request.gioBatDauMoi ? `
                            <tr>
                                <td class="fw-bold">Giờ bắt đầu mới:</td>
                                <td>${request.gioBatDauMoi}</td>
                            </tr>
                            ` : ''}
                            ${request.gioKetThucMoi ? `
                            <tr>
                                <td class="fw-bold">Giờ kết thúc mới:</td>
                                <td>${request.gioKetThucMoi}</td>
                            </tr>
                            ` : ''}
                            ${!request.ngayLamMoi && !request.gioBatDauMoi ? `
                            <tr>
                                <td colspan="2" class="text-muted fst-italic">Không có thay đổi</td>
                            </tr>
                            ` : ''}
                        </table>
                    </div>
                </div>
                
                ${request.lyDo ? `
                <div class="mb-3">
                    <h6 class="text-muted mb-2">Lý do</h6>
                    <div class="alert alert-light">
                        <i class="fas fa-comment"></i> ${request.lyDo}
                    </div>
                </div>
                ` : ''}
                
                ${request.tenNhanVienDuyet || request.ghiChuDuyet ? `
                <div class="mb-3">
                    <h6 class="text-muted mb-2">Thông tin duyệt</h6>
                    <table class="table table-sm table-borderless">
                        ${request.tenNhanVienDuyet ? `
                        <tr>
                            <td width="20%" class="fw-bold">Người duyệt:</td>
                            <td>${request.tenNhanVienDuyet}</td>
                        </tr>
                        ` : ''}
                        ${request.thoiGianDuyet ? `
                        <tr>
                            <td class="fw-bold">Thời gian duyệt:</td>
                            <td>${new Date(request.thoiGianDuyet).toLocaleString('vi-VN')}</td>
                        </tr>
                        ` : ''}
                        ${request.ghiChuDuyet ? `
                        <tr>
                            <td class="fw-bold">Ghi chú:</td>
                            <td>${request.ghiChuDuyet}</td>
                        </tr>
                        ` : ''}
                    </table>
                </div>
                ` : ''}
            `;
            
            $('#requestDetailContent').html(html);
            
            // Update footer buttons
            if (request.trangThaiDuyet === 0) {
                $('#requestDetailFooter').html(`
                    <button type="button" class="btn-secondary-admin" data-bs-dismiss="modal">Đóng</button>
                    <button type="button" class="btn btn-success" onclick="approveRequestFromDetail(${request.maDangKy})">
                        <i class="fas fa-check"></i> Duyệt yêu cầu
                    </button>
                    <button type="button" class="btn btn-danger" onclick="rejectRequestFromDetail(${request.maDangKy})">
                        <i class="fas fa-times"></i> Từ chối
                    </button>
                `);
            } else {
                $('#requestDetailFooter').html(`
                    <button type="button" class="btn-secondary-admin" data-bs-dismiss="modal">Đóng</button>
                `);
            }
        }

        // Duyệt yêu cầu
        function approveRequest(requestId) {
            if (!confirm('Bạn có chắc chắn muốn duyệt yêu cầu này?')) {
                return;
            }

            const note = prompt('Ghi chú (tùy chọn):');
            
            $.ajax({
                url: '@Url.Action("ApproveRequest", "VehicleShift", new { area = "Admin" })',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({ 
                    RequestId: requestId,
                    Note: note 
                }),
                success: function(response) {
                    if (response.success) {
                        alert(response.message || 'Duyệt yêu cầu thành công!');
                        loadScheduleRequests();
                    } else {
                        alert('Lỗi: ' + response.message);
                    }
                },
                error: function() {
                    alert('Có lỗi xảy ra khi duyệt yêu cầu');
                }
            });
        }

        // Từ chối yêu cầu
        function rejectRequest(requestId) {
            const reason = prompt('Vui lòng nhập lý do từ chối:');
            
            if (!reason) {
                alert('Vui lòng nhập lý do từ chối');
                return;
            }

            $.ajax({
                url: '@Url.Action("RejectRequest", "VehicleShift", new { area = "Admin" })',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({ 
                    RequestId: requestId,
                    Note: reason 
                }),
                success: function(response) {
                    if (response.success) {
                        alert(response.message || 'Từ chối yêu cầu thành công!');
                        loadScheduleRequests();
                    } else {
                        alert('Lỗi: ' + response.message);
                    }
                },
                error: function() {
                    alert('Có lỗi xảy ra khi từ chối yêu cầu');
                }
            });
        }

        // Duyệt yêu cầu từ modal chi tiết
        function approveRequestFromDetail(requestId) {
            $('#requestDetailModal').modal('hide');
            approveRequest(requestId);
        }

        // Từ chối yêu cầu từ modal chi tiết
        function rejectRequestFromDetail(requestId) {
            $('#requestDetailModal').modal('hide');
            rejectRequest(requestId);
        }

        // Load pending count on page load
        $(document).ready(function() {
            // Existing code...
            
            // Load pending request count
            $.get('@Url.Action("GetPendingRequestCount", "VehicleShift", new { area = "Admin" })', 
                function(data) {
                    if (data.success && data.count > 0) {
                        $('#pendingRequestBadge').text(data.count).show();
                    }
                }
            );
        });
    </script>
}
