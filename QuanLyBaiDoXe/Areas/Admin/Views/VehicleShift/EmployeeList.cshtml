        function editEmployee() {
            // Lấy dữ liệu từ currentEmployeeData (đã load từ detail)
            if (!currentEmployeeData.employee) {
                alert('Vui lòng xem chi tiết nhân viên trước khi chỉnh sửa!');
                return;
            }

            const emp = currentEmployeeData.employee;

            // Đóng detail modal và mở edit modal
            $('#employeeDetailModal').modal('hide');

            // Populate form với dữ liệu hiện tại
            $('#editMaNhanVien').val(emp.maNhanVien);
            $('#editHoTen').val(emp.hoTen);
            $('#editChucVu').val(emp.chucVu);
            $('#editGioiTinh').val(emp.gioiTinh || '');
            $('#editSoDienThoai').val(emp.soDienThoai || '');
            $('#editDiaChi').val(emp.diaChi || '');
            $('#editTrangThaiLamViec').prop('checked', emp.trangThaiLamViec);

            // Format dates for input[type="date"]
            if (emp.ngaySinh) {
                const ngaySinh = new Date(emp.ngaySinh);
                $('#editNgaySinh').val(ngaySinh.toISOString().split('T')[0]);
            } else {
                $('#editNgaySinh').val('');
            }

            if (emp.ngayVaoLam) {
                const ngayVaoLam = new Date(emp.ngayVaoLam);
                $('#editNgayVaoLam').val(ngayVaoLam.toISOString().split('T')[0]);
            } else {
                $('#editNgayVaoLam').val('');
            }

            // Show edit modal
            $('#editEmployeeModal').modal('show');
        }

        function saveEmployeeChanges() {
            // Validate form
            if (!$('#editEmployeeForm')[0].checkValidity()) {
                $('#editEmployeeForm')[0].reportValidity();
                return;
            }

            // Prepare data
            const formData = {
                MaNhanVien: parseInt($('#editMaNhanVien').val()),
                HoTen: $('#editHoTen').val().trim(),
                ChucVu: parseInt($('#editChucVu').val()),
                GioiTinh: $('#editGioiTinh').val() || null,
                SoDienThoai: $('#editSoDienThoai').val() || null,
                DiaChi: $('#editDiaChi').val() || null,
                NgaySinh: $('#editNgaySinh').val() || null,
                NgayVaoLam: $('#editNgayVaoLam').val() || null,
                TrangThaiLamViec: $('#editTrangThaiLamViec').is(':checked')
            };

            // Validate required fields
            if (!formData.HoTen) {
                alert('Vui lòng nhập họ tên nhân viên!');
                return;
            }

            // Confirm before save
            if (!confirm('Bạn có chắc chắn muốn lưu thay đổi thông tin nhân viên này?')) {
                return;
            }

            // Show loading
            const saveBtn = $('button[onclick="saveEmployeeChanges()"]');
            const originalText = saveBtn.html();
            saveBtn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Đang lưu...');

            // Send AJAX request
            $.ajax({
                url: '@Url.Action("UpdateEmployee", "VehicleShift", new { area = "Admin" })',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(formData),
                success: function(response) {
                    saveBtn.prop('disabled', false).html(originalText);
                    
                    if (response.success) {
                        alert(response.message);
                        $('#editEmployeeModal').modal('hide');
                        location.reload(); // Reload để cập nhật danh sách
                    } else {
                        alert('Lỗi: ' + response.message);
                    }
                },
                error: function(xhr, status, error) {
                    saveBtn.prop('disabled', false).html(originalText);
                    alert('Có lỗi xảy ra khi cập nhật: ' + error);
                }
            });
        }

