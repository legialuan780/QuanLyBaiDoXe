@model QuanLyBaiDoXe.ViewModels.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Quên mật khẩu";
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/login.css" />
</head>
<body>
    <div class="login-wrapper">
        <div class="login-left">
            <div class="overlay">
            </div>
        </div>
        <div class="login-right">
            <div class="content">
                <div class="text-center mb-4">
                    <i class="fas fa-key fa-3x text-primary"></i>
                </div>
                <h2 class="welcome">Quên mật khẩu</h2>
                <p class="hint">Nhập email để nhận mã OTP đặt lại mật khẩu</p>

                <form asp-action="ForgotPassword" asp-controller="Account" method="post" class="login-form">
                    @Html.AntiForgeryToken()
                    
                    <div class="mb-3">
                        <label class="form-label">Email</label>
                        <div class="input d-flex align-items-center">
                            <span class="icon">📧</span>
                            <input asp-for="Email" class="form-control border-0" type="email" placeholder="Nhập email của bạn" autofocus />
                        </div>
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                    
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="fas fa-paper-plane me-2"></i>Gửi mã OTP
                    </button>

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger mt-3" role="alert">
                            @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                            {
                                <div>@err.ErrorMessage</div>
                            }
                        </div>
                    }
                </form>

                <div class="mt-4 p-3 bg-light rounded">
                    <h6><i class="fas fa-info-circle me-2 text-primary"></i>Hướng dẫn:</h6>
                    <ul class="text-start small text-muted mb-0">
                        <li>Nhập email đã đăng ký tài khoản</li>
                        <li>Mã OTP 6 số sẽ được gửi đến email</li>
                        <li>Mã OTP có hiệu lực trong <strong>5 phút</strong></li>
                    </ul>
                </div>
                
                <div class="text-center mt-4">
                    <a asp-controller="Account" asp-action="Login" class="text-decoration-none">
                        <i class="fas fa-arrow-left me-1"></i> Quay lại đăng nhập
                    </a>
                </div>

                <div class="text-center mt-3">
                    <small class="text-muted">
                        Hệ thống Quản lý Bãi Đỗ Xe - &copy; 2024
                    </small>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
