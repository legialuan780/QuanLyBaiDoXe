                            <option value="monthly">Báo cáo tháng</option>
                            <option value="custom">Tùy chỉnh</option>
                            <option value="occupancy">Báo cáo công suất</option>
                            <option value="revenue">Báo cáo doanh thu</option>
                            <option value="vehicle">Báo cáo phương tiện</option>
                            <option value="employee">Báo cáo nhân viên</option>
                        </select>
                    </div>

                    <!-- Date Range -->
                    <div class="row mb-4" id="dateRangeSection">
