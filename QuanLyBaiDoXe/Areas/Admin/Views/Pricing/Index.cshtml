@model QuanLyBaiDoXe.Areas.Admin.ViewModels.PricingViewModel
@{
    ViewData["Title"] = "Cấu hình bảng giá";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" />
    <link rel="stylesheet" href="~/css/pricing.css" asp-append-version="true" />
}

<div class="page-header">
    <div>
        <h1 class="page-title">Cấu hình bảng giá</h1>
        <div class="breadcrumb">
            <a href="@Url.Action("Index", "Dashboard", new { area = "Admin" })">Trang chủ</a>
            <span>/</span>
            <span>Cấu hình bảng giá</span>
        </div>
    </div>
    <div style="display: flex; gap: 10px;">
        <button class="btn-primary-admin" onclick="Pricing.openAddModal()">
            <i class="fas fa-plus"></i> Thêm cấu hình giá
        </button>
    </div>
</div>

<!-- Thống kê -->
<div class="stat-cards">
    <div class="stat-card">
        <div class="stat-card-icon teal">
            <i class="fas fa-cogs"></i>
        </div>
        <div class="stat-card-info">
            <h3 id="statTotalConfigs">@Model.TotalConfigs</h3>
            <p>Tổng cấu hình</p>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-card-icon green">
            <i class="fas fa-star"></i>
        </div>
        <div class="stat-card-info">
            <h3 id="statActiveConfigs">@Model.TotalActiveConfigs</h3>
            <p>Cấu hình ưu tiên</p>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-card-icon blue">
            <i class="fas fa-car"></i>
        </div>
        <div class="stat-card-info">
            <h3 id="statVehicleTypes">@Model.TotalVehicleTypes</h3>
            <p>Loại xe</p>
        </div>
    </div>
</div>

<!-- Danh sách cấu hình giá -->
<div class="admin-card">
    <div class="admin-card-header">
        <h3 class="admin-card-title">
            <i class="fas fa-list"></i> Danh sách cấu hình giá
        </h3>
    </div>

    <div class="admin-card-body">
        <table id="pricingTable" class="table table-hover" style="width:100%">
            <thead>
                <tr>
                    <th style="width: 50px;">STT</th>
                    <th>Tên cấu hình</th>
                    <th>Loại xe</th>
                    <th>Thời gian áp dụng</th>
                    <th style="width: 100px;">Số block</th>
                    <th style="width: 100px;">Ưu tiên</th>
                    <th style="width: 180px;">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                <!-- DataTables will populate this -->
            </tbody>
        </table>
    </div>
</div>

<!-- Modal Thêm cấu hình giá -->
<div class="modal-overlay" id="addModal">
    <div class="modal-content modal-lg">
        <div class="modal-header">
            <h3 class="modal-title">Thêm cấu hình giá mới</h3>
            <button class="modal-close" onclick="Pricing.closeModal('addModal')">&times;</button>
        </div>
        <form id="addForm">
            <div class="modal-body">
                <div class="form-row">
                    <div class="form-group">
                        <label>Tên cấu hình <span class="required">*</span></label>
                        <input type="text" id="addTenCauHinh" name="tenCauHinh" required placeholder="VD: Giá ban ngày xe máy" />
                    </div>
                    <div class="form-group">
                        <label>Loại xe <span class="required">*</span></label>
                        <select id="addMaLoaiXe" name="maLoaiXe" required>
                            <option value="">-- Chọn loại xe --</option>
                            @foreach (var vt in Model.VehicleTypes)
                            {
                                <option value="@vt.MaLoaiXe">@vt.TenLoaiXe</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label>Giờ bắt đầu</label>
                        <input type="time" id="addGioBatDau" name="gioBatDau" />
                    </div>
                    <div class="form-group">
                        <label>Giờ kết thúc</label>
                        <input type="time" id="addGioKetThuc" name="gioKetThuc" />
                    </div>
                </div>
                <div class="form-group">
                    <label class="checkbox-label">
                        <input type="checkbox" id="addIsUuTien" name="isUuTien" />
                        <span>Ưu tiên áp dụng</span>
                    </label>
                </div>

                <div class="pricing-blocks-section">
                    <div class="section-header">
                        <h4><i class="fas fa-cubes"></i> Chi tiết block thời gian</h4>
                        <button type="button" class="btn-add-block" onclick="Pricing.addBlock('add')">
                            <i class="fas fa-plus"></i> Thêm block
                        </button>
                    </div>
                    <div id="addBlocksContainer" class="blocks-container">
                        <!-- Blocks sẽ được thêm động ở đây -->
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn-cancel" onclick="Pricing.closeModal('addModal')">Hủy</button>
                <button type="submit" class="btn-submit">Thêm cấu hình</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal Sửa cấu hình giá -->
<div class="modal-overlay" id="editModal">
    <div class="modal-content modal-lg">
        <div class="modal-header">
            <h3 class="modal-title">Chỉnh sửa cấu hình giá</h3>
            <button class="modal-close" onclick="Pricing.closeModal('editModal')">&times;</button>
        </div>
        <form id="editForm">
            <input type="hidden" id="editMaCauHinh" name="maCauHinh" />
            <div class="modal-body">
                <div class="form-row">
                    <div class="form-group">
                        <label>Tên cấu hình <span class="required">*</span></label>
                        <input type="text" id="editTenCauHinh" name="tenCauHinh" required placeholder="VD: Giá ban ngày xe máy" />
                    </div>
                    <div class="form-group">
                        <label>Loại xe <span class="required">*</span></label>
                        <select id="editMaLoaiXe" name="maLoaiXe" required>
                            <option value="">-- Chọn loại xe --</option>
                            @foreach (var vt in Model.VehicleTypes)
                            {
                                <option value="@vt.MaLoaiXe">@vt.TenLoaiXe</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label>Giờ bắt đầu</label>
                        <input type="time" id="editGioBatDau" name="gioBatDau" />
                    </div>
                    <div class="form-group">
                        <label>Giờ kết thúc</label>
                        <input type="time" id="editGioKetThuc" name="gioKetThuc" />
                    </div>
                </div>
                <div class="form-group">
                    <label class="checkbox-label">
                        <input type="checkbox" id="editIsUuTien" name="isUuTien" />
                        <span>Ưu tiên áp dụng</span>
                    </label>
                </div>

                <div class="pricing-blocks-section">
                    <div class="section-header">
                        <h4><i class="fas fa-cubes"></i> Chi tiết block thời gian</h4>
                        <button type="button" class="btn-add-block" onclick="Pricing.addBlock('edit')">
                            <i class="fas fa-plus"></i> Thêm block
                        </button>
                    </div>
                    <div id="editBlocksContainer" class="blocks-container">
                        <!-- Blocks sẽ được thêm động ở đây -->
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn-cancel" onclick="Pricing.closeModal('editModal')">Hủy</button>
                <button type="submit" class="btn-submit">Cập nhật</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal Chi tiết cấu hình giá -->
<div class="modal-overlay" id="detailModal">
    <div class="modal-content modal-lg">
        <div class="modal-header">
            <h3 class="modal-title">Chi tiết cấu hình giá</h3>
            <button class="modal-close" onclick="Pricing.closeModal('detailModal')">&times;</button>
        </div>
        <div class="modal-body">
            <div class="detail-section">
                <div class="detail-row">
                    <span class="detail-label">Tên cấu hình:</span>
                    <span class="detail-value" id="detailTenCauHinh"></span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Loại xe:</span>
                    <span class="detail-value" id="detailLoaiXe"></span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Thời gian áp dụng:</span>
                    <span class="detail-value" id="detailThoiGian"></span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Ưu tiên:</span>
                    <span class="detail-value" id="detailUuTien"></span>
                </div>
            </div>
            <div class="detail-blocks-section">
                <h4><i class="fas fa-cubes"></i> Chi tiết block thời gian</h4>
                <table class="detail-table">
                    <thead>
                        <tr>
                            <th>Block</th>
                            <th>Số phút</th>
                            <th>Giá tiền</th>
                            <th>Lũy tiến</th>
                        </tr>
                    </thead>
                    <tbody id="detailBlocksTable">
                        <!-- Blocks sẽ được thêm động ở đây -->
                    </tbody>
                </table>
            </div>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn-cancel" onclick="Pricing.closeModal('detailModal')">Đóng</button>
        </div>
    </div>
</div>

<!-- Modal Xác nhận xóa -->
<div class="modal-overlay" id="deleteModal">
    <div class="modal-content modal-sm">
        <div class="modal-header">
            <h3 class="modal-title">Xác nhận xóa</h3>
            <button class="modal-close" onclick="Pricing.closeModal('deleteModal')">&times;</button>
        </div>
        <div class="modal-body">
            <p>Bạn có chắc chắn muốn xóa cấu hình giá "<span id="deleteConfigName"></span>"?</p>
            <p class="warning-text"><i class="fas fa-exclamation-triangle"></i> Hành động này không thể hoàn tác!</p>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn-cancel" onclick="Pricing.closeModal('deleteModal')">Hủy</button>
            <button type="button" class="btn-danger" id="confirmDeleteBtn">Xóa</button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
    <script src="~/js/pricing.js" asp-append-version="true"></script>
}
