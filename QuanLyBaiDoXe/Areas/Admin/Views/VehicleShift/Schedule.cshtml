@model List<QuanLyBaiDoXe.Areas.Admin.ViewModels.ScheduleViewModel>

@{
    ViewData["Title"] = "Lịch làm việc";
    var selectedDate = (DateTime)ViewBag.SelectedDate;
}

<!-- Page Header -->
<div class="page-header">
    <div>
        <h1 class="page-title">
            <i class="fas fa-calendar-alt"></i>
            Lịch làm việc
        </h1>
        <div class="breadcrumb">
            <a href="@Url.Action("Index", "Dashboard", new { area = "Admin" })">Trang chủ</a>
            <span>/</span>
            <a href="@Url.Action("Index", "VehicleShift", new { area = "Admin" })">Ca làm việc</a>
            <span>/</span>
            <span>Lịch làm việc</span>
        </div>
    </div>
    <div class="page-header-actions">
        <button class="btn-secondary-admin" onclick="location.href='@Url.Action("EmployeeList", "VehicleShift", new { area = "Admin" })'">
            <i class="fas fa-users"></i>
            Danh sách nhân viên
        </button>
        <button class="btn-primary-admin" data-bs-toggle="modal" data-bs-target="#addScheduleModal">
            <i class="fas fa-plus"></i>
            Thêm lịch
        </button>
    </div>
</div>

<!-- Calendar Navigation -->
<div class="admin-card">
    <div class="calendar-navigation">
        <button class="btn-secondary-admin" onclick="previousDay()">
            <i class="fas fa-chevron-left"></i>
            Hôm qua
        </button>
        <div class="calendar-title">
            <h4>
                <i class="fas fa-calendar-day"></i>
                @selectedDate.ToString("dddd, dd/MM/yyyy", new System.Globalization.CultureInfo("vi-VN"))
            </h4>
            <input type="date" class="form-control" id="selectDate" value="@selectedDate.ToString("yyyy-MM-dd")" onchange="goToDate()">
        </div>
        <button class="btn-secondary-admin" onclick="nextDay()">
            Ngày mai
            <i class="fas fa-chevron-right"></i>
        </button>
    </div>
</div>

<!-- Timeline Schedule -->
<div class="admin-card">
    <div class="admin-card-header">
        <h3 class="admin-card-title">
            <i class="fas fa-clock"></i>
            Lịch làm việc theo giờ
        </h3>
        <div class="admin-card-actions">
            <button class="btn-secondary-admin" onclick="exportSchedule()">
                <i class="fas fa-file-excel"></i>
                Xuất Excel
            </button>
            <button class="btn-primary-admin" onclick="printSchedule()">
                <i class="fas fa-print"></i>
                In lịch
            </button>
        </div>
    </div>

    <div class="timeline-container">
        <!-- Timeline Header (Hours) -->
        <div class="timeline-header">
            <div class="timeline-employee-header">Nhân viên</div>
            <div class="timeline-hours-header">
                @for (int hour = 0; hour < 24; hour++)
                {
                    <div class="timeline-hour-cell" style="left: calc(@(hour * 100.0 / 24)%)">
                        <span>@hour:00</span>
                    </div>
                }
            </div>
        </div>

        <!-- Timeline Body -->
        <div class="timeline-body">
            @{
                var currentDateSchedule = DateOnly.FromDateTime(selectedDate);
                var previousDate = currentDateSchedule.AddDays(-1);
                
                // Lấy tất cả nhân viên có lịch trong ngày hiện tại hoặc ca đêm từ ngày trước
                var relevantSchedules = Model.Where(s => 
                    s.NgayLamViec == currentDateSchedule || 
                    (s.NgayLamViec == previousDate && s.CaLamViec == 3)
                ).ToList();
                
                var employees = relevantSchedules
                    .GroupBy(s => new { s.MaNhanVien, s.TenNhanVien })
                    .OrderBy(g => g.Key.TenNhanVien)
                    .ToList();
            }

            @if (employees.Any())
            {
                @foreach (var emp in employees)
                {
                    var empSchedules = emp.ToList();
                    
                    <div class="timeline-row">
                        <div class="timeline-employee-cell">
                            <div class="employee-info">
                                <div class="employee-avatar">@emp.Key.TenNhanVien.Substring(0, 1)</div>
                                <div class="employee-details">
                                    <strong>@emp.Key.TenNhanVien</strong>
                                    <small>NV@emp.Key.MaNhanVien.ToString("D4")</small>
                                </div>
                            </div>
                        </div>
                        
                        <div class="timeline-schedule-cell">
                            <!-- Grid lines for hours -->
                            @for (int hour = 0; hour < 24; hour++)
                            {
                                <div class="timeline-hour-line" style="left: calc(@(hour * 100.0 / 24)%)"></div>
                            }
                            
                            
                            
                            <!-- Shift bars -->
                            @foreach (var schedule in empSchedules)
                            {
                                var shiftClass = "";
                                var shiftIcon = "";
                                var caLamViec = schedule.CaLamViec ?? 0;
                                
                                var isNightShiftFromPreviousDay = schedule.NgayLamViec == previousDate && caLamViec == 3;
                                var isNightShiftOfCurrentDay = schedule.NgayLamViec == currentDateSchedule && caLamViec == 3;
                                
                                switch (caLamViec)
                                {
                                    case 1: // Ca sáng 6h-14h
                                        var startHour1 = 6.0;
                                        var duration1 = 8.0;
                                        shiftClass = "shift-morning";
                                        shiftIcon = "fa-sun";
                                        
                                        var leftPosition1 = (startHour1 / 24.0) * 100;
                                        var width1 = (duration1 / 24.0) * 100;
                                        
                                        <div class="shift-bar @shiftClass" 
                                             style="left: @leftPosition1%; width: @width1%"
                                             onclick="viewScheduleDetail(@schedule.MaLich)"
                                             title="Ca sáng (6h-14h)">
                                            <div class="shift-bar-content">
                                                <i class="fas @shiftIcon"></i>
                                                <span class="shift-bar-text">@emp.Key.TenNhanVien - Ca @caLamViec</span>
                                                @if (!string.IsNullOrEmpty(schedule.GhiChu))
                                                {
                                                    <i class="fas fa-sticky-note shift-note-icon" title="@schedule.GhiChu"></i>
                                                }
                                            </div>
                                        </div>
                                        break;
                                        
                                    case 2: // Ca chiều 14h-22h
                                        var startHour2 = 14.0;
                                        var duration2 = 8.0;
                                        shiftClass = "shift-afternoon";
                                        shiftIcon = "fa-cloud-sun";
                                        
                                        var leftPosition2 = (startHour2 / 24.0) * 100;
                                        var width2 = (duration2 / 24.0) * 100;
                                        
                                        <div class="shift-bar @shiftClass" 
                                             style="left: @leftPosition2%; width: @width2%"
                                             onclick="viewScheduleDetail(@schedule.MaLich)"
                                             title="Ca chiều (14h-22h)">
                                            <div class="shift-bar-content">
                                                <i class="fas @shiftIcon"></i>
                                                <span class="shift-bar-text">@emp.Key.TenNhanVien - Ca @caLamViec</span>
                                                @if (!string.IsNullOrEmpty(schedule.GhiChu))
                                                {
                                                    <i class="fas fa-sticky-note shift-note-icon" title="@schedule.GhiChu"></i>
                                                }
                                            </div>
                                        </div>
                                        break;
                                        
                                    case 3: // Ca đêm 22h-6h (next day)
                                        shiftClass = "shift-night";
                                        shiftIcon = "fa-moon";
                                        
                                        if (isNightShiftFromPreviousDay)
                                        {
                                            // Hiển thị phần tiếp theo của ca đêm hôm qua (0h-6h)
                                            var startHour3a = 0.0;
                                            var duration3a = 6.0;
                                            var leftPosition3a = (startHour3a / 24.0) * 100;
                                            var width3a = (duration3a / 24.0) * 100;
                                            
                                            <div class="shift-bar @shiftClass" 
                                                 style="left: @leftPosition3a%; width: @width3a%"
                                                 onclick="viewScheduleDetail(@schedule.MaLich)"
                                                 title="Ca đêm (tiếp) (0h-6h)">
                                                <div class="shift-bar-content">
                                                    <i class="fas @shiftIcon"></i>
                                                    <span class="shift-bar-text">@emp.Key.TenNhanVien - Ca @caLamViec</span>
                                                    @if (!string.IsNullOrEmpty(schedule.GhiChu))
                                                    {
                                                        <i class="fas fa-sticky-note shift-note-icon" title="@schedule.GhiChu"></i>
                                                    }
                                                </div>
                                            </div>
                                        }
                                        
                                        if (isNightShiftOfCurrentDay)
                                        {
                                            // Hiển thị phần đầu của ca đêm hôm nay (22h-24h)
                                            var startHour3b = 22.0;
                                            var duration3b = 2.0;
                                            var leftPosition3b = (startHour3b / 24.0) * 100;
                                            var width3b = (duration3b / 24.0) * 100;
                                            
                                            <div class="shift-bar @shiftClass" 
                                                 style="left: @leftPosition3b%; width: @width3b%"
                                                 onclick="viewScheduleDetail(@schedule.MaLich)"
                                                 title="Ca đêm (22h-6h)">
                                                <div class="shift-bar-content">
                                                    <i class="fas @shiftIcon"></i>
                                                    <span class="shift-bar-text">@emp.Key.TenNhanVien - Ca @caLamViec</span>
                                                    @if (!string.IsNullOrEmpty(schedule.GhiChu))
                                                    {
                                                        <i class="fas fa-sticky-note shift-note-icon" title="@schedule.GhiChu"></i>
                                                    }
                                                </div>
                                            </div>
                                        }
                                        break;
                                }
                            }
                            
                            
                            @if (!empSchedules.Any())
                            {
                                <button class="btn-add-shift-timeline" onclick="addShiftQuick(@emp.Key.MaNhanVien, '@currentDateSchedule.ToString("yyyy-MM-dd")')">
                                    <i class="fas fa-plus"></i>
                                    <span>Thêm ca</span>
                                </button>
                            }
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="empty-state-timeline">
                    <i class="fas fa-calendar-times"></i>
                    <p>Chưa có lịch làm việc nào trong ngày này</p>
                    <button class="btn-primary-admin" data-bs-toggle="modal" data-bs-target="#addScheduleModal">
                        <i class="fas fa-plus"></i>
                        Thêm lịch làm việc
                    </button>
                </div>
            }
        </div>
    </div>
</div>

<!-- Statistics Summary -->
<div class="admin-card">
    <div class="schedule-stats">
        <h5>
            <i class="fas fa-chart-bar"></i>
            Thống kê ngày @selectedDate.ToString("dd/MM/yyyy")
        </h5>
        <div class="stats-grid">
            @{
                var currentDateOnly = DateOnly.FromDateTime(selectedDate);
                var todaySchedules = Model.Where(s => s.NgayLamViec == currentDateOnly).ToList();
                var shift1Count = todaySchedules.Count(s => s.CaLamViec == 1);
                var shift2Count = todaySchedules.Count(s => s.CaLamViec == 2);
                var shift3Count = todaySchedules.Count(s => s.CaLamViec == 3);
            }
            <div class="stat-item">
                <div class="stat-icon shift-morning">
                    <i class="fas fa-sun"></i>
                </div>
                <div class="stat-info">
                    <strong>@shift1Count</strong>
                    <span>Ca sáng (6h-14h)</span>
                </div>
            </div>
            <div class="stat-item">
                <div class="stat-icon shift-afternoon">
                    <i class="fas fa-cloud-sun"></i>
                </div>
                <div class="stat-info">
                    <strong>@shift2Count</strong>
                    <span>Ca chiều (14h-22h)</span>
                </div>
            </div>
            <div class="stat-item">
                <div class="stat-icon shift-night">
                    <i class="fas fa-moon"></i>
                </div>
                <div class="stat-info">
                    <strong>@shift3Count</strong>
                    <span>Ca đêm (22h-6h)</span>
                </div>
            </div>
            <div class="stat-item">
                <div class="stat-icon stat-total">
                    <i class="fas fa-users"></i>
                </div>
                <div class="stat-info">
                    <strong>@todaySchedules.Count</strong>
                    <span>Tổng ca làm việc</span>
                </div>
            </div>
        </div>
    </div>
</div>
        <div class="legend-items">
            <div class="legend-item">
                <span class="shift-badge shift-1"><i class="fas fa-sun"></i> Ca 1</span>
                <span>Ca sáng (6h-14h)</span>
            </div>
            <div class="legend-item">
                <span class="shift-badge shift-2"><i class="fas fa-cloud-sun"></i> Ca 2</span>
                <span>Ca chiều (14h-22h)</span>
            </div>
            <div class="legend-item">
                <span class="shift-badge shift-3"><i class="fas fa-moon"></i> Ca 3</span>
                <span>Ca đêm (22h-6h)</span>
            </div>
        </div>
    </div>
</div>

<!-- Add Schedule Modal -->
<div class="modal fade" id="addScheduleModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="fas fa-calendar-plus"></i>
                    Thêm lịch làm việc
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="addScheduleForm">
                    <div class="mb-3">
                        <label class="form-label">Nhân viên <span class="text-danger">*</span></label>
                        <select class="form-select" id="scheduleEmployeeSelect" name="MaNhanVien" required>
                            <option value="">-- Chọn nhân viên --</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Ngày làm việc <span class="text-danger">*</span></label>
                        <input type="date" class="form-control" id="scheduleDate" name="NgayLamViec" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Ca làm việc <span class="text-danger">*</span></label>
                        <select class="form-select" name="CaLamViec" required>
                            <option value="">-- Chọn ca --</option>
                            <option value="1">Ca 1 - Ca sáng (6h-14h)</option>
                            <option value="2">Ca 2 - Ca chiều (14h-22h)</option>
                            <option value="3">Ca 3 - Ca đêm (22h-6h)</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Ghi chú</label>
                        <textarea class="form-control" name="GhiChu" rows="2"></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn-secondary-admin" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn-primary-admin" onclick="saveSchedule()">
                    <i class="fas fa-check"></i>
                    Thêm lịch
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Schedule Detail Modal -->
<div class="modal fade" id="scheduleDetailModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="fas fa-info-circle"></i>
                    Chi tiết lịch làm việc
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="scheduleDetailContent">
                <!-- Content will be loaded here -->
            </div>
            <div class="modal-footer">
                <button type="button" class="btn-danger-admin" onclick="deleteCurrentSchedule()">
                    <i class="fas fa-trash"></i>
                    Xóa
                </button>
                <button type="button" class="btn-secondary-admin" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

<link rel="stylesheet" href="~/css/vehicle-shift.css" />

@section Scripts {
    <script>
        let currentScheduleId = null;

        // Load danh sách nhân viên khi mở modal
        $('#addScheduleModal').on('show.bs.modal', function() {
            $.get('@Url.Action("GetAvailableEmployees", "VehicleShift", new { area = "Admin" })', function(data) {
                const select = $('#scheduleEmployeeSelect');
                select.empty();
                select.append('<option value="">-- Chọn nhân viên --</option>');
                data.forEach(emp => {
                    select.append(`<option value="${emp.maNhanVien}">${emp.hoTen} (${emp.chucVu})</option>`);
                });
            });
            
            // Set ngày mặc định là ngày hiện tại
            $('#scheduleDate').val('@selectedDate.ToString("yyyy-MM-dd")');
        });

        function previousDay() {
            const currentDate = new Date('@selectedDate.ToString("yyyy-MM-dd")');
            currentDate.setDate(currentDate.getDate() - 1);
            window.location.href = '@Url.Action("Schedule", "VehicleShift", new { area = "Admin" })?date=' + currentDate.toISOString().split('T')[0];
        }

        function nextDay() {
            const currentDate = new Date('@selectedDate.ToString("yyyy-MM-dd")');
            currentDate.setDate(currentDate.getDate() + 1);
            window.location.href = '@Url.Action("Schedule", "VehicleShift", new { area = "Admin" })?date=' + currentDate.toISOString().split('T')[0];
        }

        function goToDate() {
            const date = $('#selectDate').val();
            window.location.href = '@Url.Action("Schedule", "VehicleShift", new { area = "Admin" })?date=' + date;
        }

        function addShiftQuick(employeeId, date) {
            $('#scheduleEmployeeSelect').val(employeeId);
            $('#scheduleDate').val(date);
            $('#addScheduleModal').modal('show');
        }

        function saveSchedule() {
            const form = $('#addScheduleForm');
            
            // Validate form
            if (!form[0].checkValidity()) {
                form[0].reportValidity();
                return;
            }

            const formData = {
                MaNhanVien: parseInt($('select[name="MaNhanVien"]').val()),
                NgayLamViec: $('input[name="NgayLamViec"]').val(),
                CaLamViec: parseInt($('select[name="CaLamViec"]').val()),
                GhiChu: $('textarea[name="GhiChu"]').val()
            };

            $.ajax({
                url: '@Url.Action("AddSchedule", "VehicleShift", new { area = "Admin" })',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(formData),
                success: function(response) {
                    if (response.success) {
                        alert(response.message);
                        location.reload();
                    } else {
                        alert('Lỗi: ' + response.message);
                    }
                },
                error: function() {
                    alert('Có lỗi xảy ra khi thêm lịch');
                }
            });
        }

        function viewScheduleDetail(scheduleId) {
            currentScheduleId = scheduleId;
            $('#scheduleDetailModal').modal('show');
            
            // Load schedule details
            $('#scheduleDetailContent').html('<p class="text-center"><i class="fas fa-spinner fa-spin"></i> Đang tải...</p>');
            
            // You can implement API to get schedule detail here
            setTimeout(() => {
                $('#scheduleDetailContent').html(`
                    <div class="alert alert-info">
                        <strong>Mã lịch:</strong> #${scheduleId}<br>
                        <p class="mt-2">Chi tiết lịch làm việc sẽ được hiển thị ở đây</p>
                    </div>
                `);
            }, 500);
        }

        function deleteCurrentSchedule() {
            if (!currentScheduleId) return;
            
            if (!confirm('Bạn có chắc chắn muốn xóa lịch này?')) return;
            
            $.post('@Url.Action("DeleteSchedule", "VehicleShift", new { area = "Admin" })', 
                { id: currentScheduleId }, 
                function(response) {
                    if (response.success) {
                        alert(response.message);
                        location.reload();
                    } else {
                        alert('Lỗi: ' + response.message);
                    }
                }
            );
        }

        function exportSchedule() {
            window.location.href = '@Url.Action("ExportSchedule", "VehicleShift", new { area = "Admin" })?date=@selectedDate.ToString("yyyy-MM-dd")';
        }

        function printSchedule() {
            window.print();
        }
    </script>
}
