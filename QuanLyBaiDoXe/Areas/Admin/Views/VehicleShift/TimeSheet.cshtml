</style>

<link rel="stylesheet" href="~/css/vehicle-shift.css" />

@section Scripts {
    <script>
        function previousMonth() {
            let month = parseInt($('#selectMonth').val()) - 1;
            let year = parseInt($('#selectYear').val());
            
            if (month < 1) {
                month = 12;
                year--;
            }
            
            window.location.href = '@Url.Action("TimeSheet", "VehicleShift", new { area = "Admin" })?month=' + month + '&year=' + year;
        }

        function nextMonth() {
            let month = parseInt($('#selectMonth').val()) + 1;
            let year = parseInt($('#selectYear').val());
            
            if (month > 12) {
                month = 1;
                year++;
            }
            
            window.location.href = '@Url.Action("TimeSheet", "VehicleShift", new { area = "Admin" })?month=' + month + '&year=' + year;
        }

        function changeMonth() {
            const month = $('#selectMonth').val();
            const year = $('#selectYear').val();
            window.location.href = '@Url.Action("TimeSheet", "VehicleShift", new { area = "Admin" })?month=' + month + '&year=' + year;
        }

        function scrollToToday() {
            const todayCard = document.querySelector('.day-card.today');
            if (todayCard) {
                todayCard.scrollIntoView({ behavior: 'smooth', block: 'center' });
                todayCard.style.transform = 'scale(1.02)';
                setTimeout(() => {
                    todayCard.style.transform = 'scale(1)';
                }, 300);
            } else {
                alert('Hôm nay không có trong tháng đã chọn');
            }
        }

        function viewShiftDetail(shiftId) {
            $('#shiftDetailModal').modal('show');
            $('#shiftDetailContent').html('<p class="text-center"><i class="fas fa-spinner fa-spin"></i> Đang tải...</p>');
            
            $.get('@Url.Action("GetShiftDetail", "VehicleShift", new { area = "Admin" })', 
                { id: shiftId },
                function(data) {
                    if (data) {
                        let html = `
                            <div class="shift-detail">
                                <div class="detail-section">
                                    <h6><i class="fas fa-info-circle"></i> Thông tin chung</h6>
                                    <table class="table table-sm">
                                        <tr>
                                            <th width="30%">Mã ca:</th>
                                            <td><strong>#${data.maCa}</strong></td>
                                        </tr>
                                        <tr>
                                            <th>Nhân viên:</th>
                                            <td>${data.tenNhanVien || 'N/A'}</td>
                                        </tr>
                                        <tr>
                                            <th>Trạng thái:</th>
                                            <td><span class="badge badge-${data.trangThaiCa === 0 ? 'success' : 'info'}">${data.trangThaiCa === 0 ? 'Đang trực' : 'Đã chốt'}</span></td>
                                        </tr>
                                    </table>
                                </div>
                                <div class="detail-section">
                                    <h6><i class="fas fa-clock"></i> Thời gian</h6>
                                    <table class="table table-sm">
                                        <tr>
                                            <th width="30%">Nhận ca:</th>
                                            <td>${data.thoiGianNhanCa ? new Date(data.thoiGianNhanCa).toLocaleString('vi-VN') : 'N/A'}</td>
                                        </tr>
                                        <tr>
                                            <th>Giao ca:</th>
                                            <td>${data.thoiGianGiaoCa ? new Date(data.thoiGianGiaoCa).toLocaleString('vi-VN') : 'Chưa giao ca'}</td>
                                        </tr>
                                        <tr>
                                            <th>Số giờ làm:</th>
                                            <td><strong>${data.soGioLam ? data.soGioLam.toFixed(1) + 'h' : 'N/A'}</strong></td>
                                        </tr>
                                    </table>
                                </div>
                                <div class="detail-section">
                                    <h6><i class="fas fa-money-bill-wave"></i> Tài chính</h6>
                                    <table class="table table-sm">
                                        <tr>
                                            <th width="30%">Tiền đầu ca:</th>
                                            <td>${data.tienDauCa ? data.tienDauCa.toLocaleString('vi-VN') + ' đ' : '0 đ'}</td>
                                        </tr>
                                        <tr>
                                            <th>Doanh thu hệ thống:</th>
                                            <td class="text-success"><strong>${data.tongTienHeThong ? data.tongTienHeThong.toLocaleString('vi-VN') + ' đ' : '0 đ'}</strong></td>
                                        </tr>
                                        <tr>
                                            <th>Tiền cuối ca:</th>
                                            <td>${data.tienCuoiCa ? data.tienCuoiCa.toLocaleString('vi-VN') + ' đ' : '0 đ'}</td>
                                        </tr>
                                        <tr>
                                            <th>Tiền bàn giao:</th>
                                            <td>${data.tienMatBanGiao ? data.tienMatBanGiao.toLocaleString('vi-VN') + ' đ' : '0 đ'}</td>
                                        </tr>
                                        <tr>
                                            <th>Chênh lệch:</th>
                                            <td class="${data.chenhLech > 0 ? 'text-success' : data.chenhLech < 0 ? 'text-danger' : ''}">
                                                <strong>${data.chenhLech ? data.chenhLech.toLocaleString('vi-VN') + ' đ' : '0 đ'}</strong>
                                            </td>
                                        </tr>
                                    </table>
                                </div>
                                ${data.ghiChuBanGiao ? `
                                <div class="detail-section">
                                    <h6><i class="fas fa-sticky-note"></i> Ghi chú</h6>
                                    <p class="mb-0">${data.ghiChuBanGiao}</p>
                                </div>
                                ` : ''}
                            </div>
                        `;
                        $('#shiftDetailContent').html(html);
                    } else {
                        $('#shiftDetailContent').html('<p class="text-center text-danger">Không tìm thấy thông tin ca làm việc</p>');
                    }
                }
            ).fail(function() {
                $('#shiftDetailContent').html('<p class="text-center text-danger">Lỗi khi tải dữ liệu</p>');
            });
        }

        function closeShift(shiftId) {
            if (!confirm('Bạn có chắc chắn muốn chốt ca này?')) {
                return;
            }

            $.ajax({
                url: '@Url.Action("CloseShift", "VehicleShift", new { area = "Admin" })',
                type: 'POST',
                data: { shiftId: shiftId },
                success: function(response) {
                    if (response.success) {
                        alert('Chốt ca thành công!');
                        location.reload();
                    } else {
                        alert('Lỗi: ' + response.message);
                    }
                },
                error: function() {
                    alert('Có lỗi xảy ra khi chốt ca');
                }
            });
        }

        function exportTimeSheet() {
            const month = $('#selectMonth').val();
            const year = $('#selectYear').val();
            window.location.href = '@Url.Action("ExportTimeSheet", "VehicleShift", new { area = "Admin" })?month=' + month + '&year=' + year;
        }

        function printTimeSheet() {
            window.print();
        }

        // Mở modal lập ca
        function openCreateShiftModal() {
            $('#createShiftModal').modal('show');
            
            // Set ngày mặc định là hôm nay
            const today = new Date().toISOString().split('T')[0];
            $('#shiftDate').val(today);
            
            // Load danh sách nhân viên
            loadEmployeesForShift();
        }

        // Mở modal sửa ca ngày
        function openEditDayShifts(date) {
            $('#editDayShiftsModal').modal('show');
            $('#editDayDate').val(date);
            
            // Format ngày để hiển thị
            const dateObj = new Date(date);
            const dateStr = dateObj.toLocaleDateString('vi-VN', { 
                weekday: 'long', 
                year: 'numeric', 
                month: 'long', 
                day: 'numeric' 
            });
            $('#editDayTitle').text(dateStr);
            
            // Load ca của ngày đó
            loadDayShifts(date);
        }

        // Mở modal xem chi tiết ngày
        function viewDayDetail(date) {
            $('#viewDayDetailModal').modal('show');
            
            // Format ngày để hiển thị
            const dateObj = new Date(date);
            const dateStr = dateObj.toLocaleDateString('vi-VN', { 
                weekday: 'long', 
                year: 'numeric', 
                month: 'long', 
                day: 'numeric' 
            });
            $('#viewDayTitle').text(dateStr);
            
            // Load chi tiết ngày
            loadDayDetail(date);
        }

        // Load chi tiết tất cả ca trong ngày
        function loadDayDetail(date) {
            $('#viewDayContent').html('<p class="text-center"><i class="fas fa-spinner fa-spin"></i> Đang tải...</p>');
            
            $.get('@Url.Action("GetDayShifts", "VehicleShift", new { area = "Admin" })', 
                { date: date },
                function(data) {
                    if (data && data.length > 0) {
                        displayDayDetail(data);
                    } else {
                        $('#viewDayContent').html('<div class="alert alert-warning"><i class="fas fa-exclamation-triangle"></i> Không có ca nào trong ngày này</div>');
                    }
                }
            ).fail(function() {
                $('#viewDayContent').html('<div class="alert alert-danger"><i class="fas fa-times-circle"></i> Lỗi khi tải dữ liệu</div>');
            });
        }

        // Hiển thị chi tiết ngày
        function displayDayDetail(shifts) {
            let totalHours = 0;
            let totalRevenue = 0;
            let activeShifts = 0;
            let completedShifts = 0;

            shifts.forEach(shift => {
                if (shift.trangThaiCa === 0) activeShifts++;
                if (shift.trangThaiCa === 1) completedShifts++;
                
                if (shift.thoiGianNhanCa && shift.thoiGianGiaoCa) {
                    const start = new Date(shift.thoiGianNhanCa);
                    const end = new Date(shift.thoiGianGiaoCa);
                    totalHours += (end - start) / (1000 * 60 * 60);
                }
                
                totalRevenue += shift.tongTienHeThong || 0;
            });

            let html = `
                <div class="row mb-4">
                    <div class="col-md-3">
                        <div class="stat-box">
                            <div class="stat-icon bg-primary">
                                <i class="fas fa-clipboard-list"></i>
                            </div>
                            <div class="stat-info">
                                <h4>${shifts.length}</h4>
                                <p>Tổng ca</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="stat-box">
                            <div class="stat-icon bg-success">
                                <i class="fas fa-user-clock"></i>
                            </div>
                            <div class="stat-info">
                                <h4>${activeShifts}</h4>
                                <p>Đang trực</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="stat-box">
                            <div class="stat-icon bg-info">
                                <i class="fas fa-clock"></i>
                            </div>
                            <div class="stat-info">
                                <h4>${totalHours.toFixed(1)}h</h4>
                                <p>Tổng giờ</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="stat-box">
                            <div class="stat-icon bg-warning">
                                <i class="fas fa-money-bill-wave"></i>
                            </div>
                            <div class="stat-info">
                                <h4>${totalRevenue.toLocaleString('vi-VN')} đ</h4>
                                <p>Doanh thu</p>
                            </div>
                        </div>
                    </div>
                </div>

                <h6 class="mb-3"><i class="fas fa-list"></i> Danh sách ca làm việc</h6>
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Ca</th>
                                <th>Nhân viên</th>
                                <th>Giờ vào</th>
                                <th>Giờ ra</th>
                                <th>Số giờ</th>
                                <th>Tiền đầu ca</th>
                                <th>Doanh thu</th>
                                <th>Trạng thái</th>
                                <th>Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
            `;

            shifts.forEach(shift => {
                const shiftTime = new Date(shift.thoiGianNhanCa);
                const hour = shiftTime.getHours();
                let shiftType = '';
                
                if (hour >= 6 && hour < 14) {
                    shiftType = '<span class="badge bg-warning">Ca Sáng</span>';
                } else if (hour >= 14 && hour < 22) {
                    shiftType = '<span class="badge bg-primary">Ca Chiều</span>';
                } else {
                    shiftType = '<span class="badge bg-info">Ca Đêm</span>';
                }

                const status = shift.trangThaiCa === 0 
                    ? '<span class="badge bg-success">Đang trực</span>' 
                    : '<span class="badge bg-secondary">Đã chốt</span>';

                let workHours = 0;
                if (shift.thoiGianNhanCa && shift.thoiGianGiaoCa) {
                    const start = new Date(shift.thoiGianNhanCa);
                    const end = new Date(shift.thoiGianGiaoCa);
                    workHours = (end - start) / (1000 * 60 * 60);
                }

                html += `
                    <tr>
                        <td>${shiftType}<br><small class="text-muted">#${shift.maCa}</small></td>
                        <td><strong>${shift.tenNhanVien || 'N/A'}</strong></td>
                        <td>${shift.thoiGianNhanCa ? new Date(shift.thoiGianNhanCa).toLocaleTimeString('vi-VN', {hour: '2-digit', minute: '2-digit'}) : '--:--'}</td>
                        <td>${shift.thoiGianGiaoCa ? new Date(shift.thoiGianGiaoCa).toLocaleTimeString('vi-VN', {hour: '2-digit', minute: '2-digit'}) : '--:--'}</td>
                        <td>${workHours.toFixed(1)}h</td>
                        <td>${(shift.tienDauCa || 0).toLocaleString('vi-VN')} đ</td>
                        <td class="text-success"><strong>${(shift.tongTienHeThong || 0).toLocaleString('vi-VN')} đ</strong></td>
                        <td>${status}</td>
                        <td>
                            <button class="btn btn-sm btn-info" onclick="viewShiftDetail(${shift.maCa})">
                                <i class="fas fa-eye"></i>
                            </button>
                        </td>
                    </tr>
                `;
            });

            html += `
                        </tbody>
                    </table>
                </div>
            `;

            $('#viewDayContent').html(html);
        }

        // In báo cáo ngày
        function printDayDetail() {
            window.print();
        }

        // Load các ca của ngày
        function loadDayShifts(date) {
            $('#editShiftsContainer').html('<p class="text-center"><i class="fas fa-spinner fa-spin"></i> Đang tải...</p>');
            
            $.get('@Url.Action("GetDayShifts", "VehicleShift", new { area = "Admin" })', 
                { date: date },
                function(data) {
                    if (data && data.length > 0) {
                        displayEditShiftsForm(data);
                    } else {
                        $('#editShiftsContainer').html('<div class="alert alert-warning"><i class="fas fa-exclamation-triangle"></i> Không có ca nào trong ngày này</div>');
                    }
                }
            ).fail(function() {
                $('#editShiftsContainer').html('<div class="alert alert-danger"><i class="fas fa-times-circle"></i> Lỗi khi tải dữ liệu</div>');
            });
        }

        // Hiển thị form sửa ca
        function displayEditShiftsForm(shifts) {
            let html = '<div class="alert alert-info"><i class="fas fa-info-circle"></i> Sửa thông tin các ca trong ngày. Ca đã chốt không thể thay đổi nhân viên.</div>';
            
            // Load danh sách nhân viên trước
            $.get('@Url.Action("GetAvailableEmployees", "VehicleShift", new { area = "Admin" })', 
                function(employees) {
                    shifts.forEach((shift, index) => {
                        const shiftTime = new Date(shift.thoiGianNhanCa);
                        const hour = shiftTime.getHours();
                        let shiftName = '';
                        let shiftIcon = '';
                        let shiftColor = '';
                        
                        if (hour >= 6 && hour < 14) {
                            shiftName = 'Ca Sáng (6:00 - 14:00)';
                            shiftIcon = 'fa-sun';
                            shiftColor = 'warning';
                        } else if (hour >= 14 && hour < 22) {
                            shiftName = 'Ca Chiều (14:00 - 22:00)';
                            shiftIcon = 'fa-cloud-sun';
                            shiftColor = 'primary';
                        } else {
                            shiftName = 'Ca Đêm (22:00 - 6:00)';
                            shiftIcon = 'fa-moon';
                            shiftColor = 'info';
                        }
                        
                        const isCompleted = shift.trangThaiCa === 1;
                        const disabledClass = isCompleted ? 'disabled' : '';
                        
                        html += `
                            <div class="shift-edit-section mb-4">
                                <input type="hidden" class="edit-shift-id" value="${shift.maCa}">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <h6>
                                        <i class="fas ${shiftIcon} text-${shiftColor}"></i>
                                        <strong>${shiftName}</strong>
                                        ${isCompleted ? '<span class="badge badge-secondary ms-2">Đã chốt</span>' : '<span class="badge badge-warning ms-2">Đang trực</span>'}
                                    </h6>
                                    ${!isCompleted ? `<button type="button" class="btn btn-sm btn-danger" onclick="deleteShift(${shift.maCa})"><i class="fas fa-trash"></i> Xóa ca</button>` : ''}
                                </div>
                                <div class="row">
                                    <div class="col-md-4 mb-3">
                                        <label class="form-label">Nhân viên</label>
                                        <select class="form-select edit-shift-employee" data-shift-id="${shift.maCa}" ${isCompleted ? 'disabled' : ''}>
                                            <option value="">-- Chọn nhân viên --</option>
                                            ${employees.map(emp => `<option value="${emp.maNhanVien}" ${emp.maNhanVien === shift.maNhanVien ? 'selected' : ''}>${emp.hoTen} - ${emp.chucVu}</option>`).join('')}
                                        </select>
                                    </div>
                                    <div class="col-md-4 mb-3">
                                        <label class="form-label">Tiền đầu ca</label>
                                        <input type="number" class="form-control edit-shift-cash" data-shift-id="${shift.maCa}" value="${shift.tienDauCa || 0}" min="0" step="1000" ${isCompleted ? 'disabled' : ''}>
                                    </div>
                                    <div class="col-md-4 mb-3">
                                        <label class="form-label">Trạng thái</label>
                                        <input type="text" class="form-control" value="${isCompleted ? 'Đã chốt' : 'Đang trực'}" disabled>
                                    </div>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">Ghi chú</label>
                                    <textarea class="form-control edit-shift-note" data-shift-id="${shift.maCa}" rows="2" ${isCompleted ? 'disabled' : ''}>${shift.ghiChuBanGiao || ''}</textarea>
                                </div>
                            </div>
                            ${index < shifts.length - 1 ? '<hr>' : ''}
                        `;
                    });
                    
                    $('#editShiftsContainer').html(html);
                }
            );
        }

        // Xóa một ca
        function deleteShift(shiftId) {
            if (!confirm('Bạn có chắc chắn muốn xóa ca này?')) {
                return;
            }

            $.ajax({
                url: '@Url.Action("DeleteShift", "VehicleShift", new { area = "Admin" })',
                type: 'POST',
                data: { shiftId: shiftId },
                success: function(response) {
                    if (response.success) {
                        alert('Xóa ca thành công!');
                        const date = $('#editDayDate').val();
                        loadDayShifts(date);
                    } else {
                        alert('Lỗi: ' + response.message);
                    }
                },
                error: function() {
                    alert('Có lỗi xảy ra khi xóa ca');
                }
            });
        }

        // Xóa tất cả ca trong ngày
        function confirmDeleteDayShifts() {
            if (!confirm('Bạn có chắc chắn muốn xóa TẤT CẢ ca trong ngày này?')) {
                return;
            }

            const date = $('#editDayDate').val();
            
            $.ajax({
                url: '@Url.Action("DeleteDayShifts", "VehicleShift", new { area = "Admin" })',
                type: 'POST',
                data: { date: date },
                success: function(response) {
                    if (response.success) {
                        alert('Đã xóa tất cả ca trong ngày!');
                        $('#editDayShiftsModal').modal('hide');
                        location.reload();
                    } else {
                        alert('Lỗi: ' + response.message);
                    }
                },
                error: function() {
                    alert('Có lỗi xảy ra khi xóa ca');
                }
            });
        }

        // Lưu thay đổi ca
        function submitUpdateDayShifts() {
            const updates = [];
            
            $('.edit-shift-id').each(function() {
                const shiftId = $(this).val();
                const employee = $(`.edit-shift-employee[data-shift-id="${shiftId}"]`).val();
                const cash = $(`.edit-shift-cash[data-shift-id="${shiftId}"]`).val();
                const note = $(`.edit-shift-note[data-shift-id="${shiftId}"]`).val();
                
                updates.push({
                    MaCa: parseInt(shiftId),
                    MaNhanVien: employee ? parseInt(employee) : null,
                    TienDauCa: parseFloat(cash) || 0,
                    GhiChuBanGiao: note || ''
                });
            });

            if (updates.length === 0) {
                alert('Không có ca nào để cập nhật');
                return;
            }

            $.ajax({
                url: '@Url.Action("UpdateDayShifts", "VehicleShift", new { area = "Admin" })',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({ Updates: updates }),
                success: function(response) {
                    if (response.success) {
                        alert('Cập nhật ca thành công!');
                        $('#editDayShiftsModal').modal('hide');
                        location.reload();
                    } else {
                        alert('Lỗi: ' + response.message);
                    }
                },
                error: function() {
                    alert('Có lỗi xảy ra khi cập nhật ca');
                }
            });
        }

        // Load danh sách nhân viên có thể làm ca
        function loadEmployeesForShift() {
            $.get('@Url.Action("GetAvailableEmployees", "VehicleShift", new { area = "Admin" })', 
                function(data) {
                    let options = '<option value="">-- Chọn nhân viên --</option>';
                    let managerOptions = '<option value="">-- Chọn nhân viên quản lý --</option>';
                    
                    data.forEach(emp => {
                        options += `<option value="${emp.maNhanVien}">${emp.hoTen} - ${emp.chucVu}</option>`;
                        managerOptions += `<option value="${emp.maNhanVien}">${emp.hoTen} - ${emp.chucVu}</option>`;
                    });
                    
                    $('#morningEmployee, #afternoonEmployee, #nightEmployee').html(options);
                    $('#managerEmployee').html(managerOptions);
                }
            ).fail(function() {
                alert('Lỗi khi tải danh sách nhân viên');
            });
        }

        // Submit tạo ca làm việc
        function submitCreateShifts() {
            const date = $('#shiftDate').val();
            if (!date) {
                alert('Vui lòng chọn ngày làm việc');
                return;
            }

            // Kiểm tra ít nhất một ca có nhân viên
            const morningEmp = $('#morningEmployee').val();
            const afternoonEmp = $('#afternoonEmployee').val();
            const nightEmp = $('#nightEmployee').val();

            if (!morningEmp && !afternoonEmp && !nightEmp) {
                alert('Vui lòng chọn ít nhất một nhân viên cho một ca');
                return;
            }

            // Chuẩn bị dữ liệu
            const shifts = [];

            // Ca sáng (6:00 - 14:00)
            if (morningEmp) {
                shifts.push({
                    MaNhanVien: parseInt(morningEmp),
                    ThoiGianNhanCa: `${date} 06:00:00`,
                    TienDauCa: parseFloat($('#morningCash').val()) || 0,
                    GhiChuBanGiao: $('#morningNote').val() || 'Ca sáng'
                });
            }

            // Ca chiều (14:00 - 22:00)
            if (afternoonEmp) {
                shifts.push({
                    MaNhanVien: parseInt(afternoonEmp),
                    ThoiGianNhanCa: `${date} 14:00:00`,
                    TienDauCa: parseFloat($('#afternoonCash').val()) || 0,
                    GhiChuBanGiao: $('#afternoonNote').val() || 'Ca chiều'
                });
            }

            // Ca đêm (22:00 - 6:00 ngày hôm sau)
            if (nightEmp) {
                shifts.push({
                    MaNhanVien: parseInt(nightEmp),
                    ThoiGianNhanCa: `${date} 22:00:00`,
                    TienDauCa: parseFloat($('#nightCash').val()) || 0,
                    GhiChuBanGiao: $('#nightNote').val() || 'Ca đêm'
                });
            }

            // Hiển thị loading
            const submitBtn = $('#btnSubmitShifts')[0];
            const originalText = submitBtn.innerHTML;
            submitBtn.disabled = true;
            submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Đang tạo...';

            // Gửi request
            $.ajax({
                url: '@Url.Action("CreateMultipleShifts", "VehicleShift", new { area = "Admin" })',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({ Shifts: shifts }),
                success: function(response) {
                    if (response.success) {
                        alert(response.message || 'Tạo ca làm việc thành công!');
                        $('#createShiftModal').modal('hide');
                        
                        // Reset form
                        $('#createShiftForm')[0].reset();
                        
                        // Reload trang
                        location.reload();
                    } else {
                        alert('Lỗi: ' + response.message);
                        submitBtn.disabled = false;
                        submitBtn.innerHTML = originalText;
                    }
                },
                error: function(xhr, status, error) {
                    alert('Có lỗi xảy ra khi tạo ca: ' + error);
                    submitBtn.disabled = false;
                    submitBtn.innerHTML = originalText;
                }
            });
        }

        // Auto scroll to today on page load
        $(document).ready(function() {
            setTimeout(function() {
                const todayCard = document.querySelector('.day-card.today');
                if (todayCard) {
                    todayCard.scrollIntoView({ behavior: 'smooth', block: 'center' });
                }
            }, 500);
        });
    </script>
}
