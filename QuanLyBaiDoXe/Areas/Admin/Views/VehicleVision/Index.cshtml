    function updateReportOptions() {
        const reportType = document.getElementById('reportType').value;
        const startDate = document.getElementById('reportStartDate');
        const endDate = document.getElementById('reportEndDate');
        const today = new Date();
        
        switch(reportType) {
            case 'daily':
                startDate.value = today.toISOString().split('T')[0];
                endDate.value = today.toISOString().split('T')[0];
                startDate.disabled = true;
                endDate.disabled = true;
                break;
            case 'weekly':
                const weekStart = new Date(today);
                weekStart.setDate(today.getDate() - today.getDay() + 1); // Monday
                const weekEnd = new Date(weekStart);
                weekEnd.setDate(weekStart.getDate() + 6);
                startDate.value = weekStart.toISOString().split('T')[0];
                endDate.value = weekEnd.toISOString().split('T')[0];
                startDate.disabled = true;
                endDate.disabled = true;
                break;
            case 'monthly':
                const monthStart = new Date(today.getFullYear(), today.getMonth(), 1);
                const monthEnd = new Date(today.getFullYear(), today.getMonth() + 1, 0);
                startDate.value = monthStart.toISOString().split('T')[0];
                endDate.value = monthEnd.toISOString().split('T')[0];
                startDate.disabled = true;
                endDate.disabled = true;
                break;
            default:
                startDate.disabled = false;
                endDate.disabled = false;
                break;
        }
        
        updateReportSummary();
    }
    
    function updateReportSummary() {
        const reportType = document.getElementById('reportType').value;
        const startDate = document.getElementById('reportStartDate').value;
        const endDate = document.getElementById('reportEndDate').value;
        const summaryText = document.getElementById('summaryText');
        
        const reportNames = {
            'daily': 'Báo cáo ngày',
            'weekly': 'Báo cáo tuần',
            'monthly': 'Báo cáo tháng',
            'custom': 'Báo cáo tùy chỉnh',
            'occupancy': 'Báo cáo công suất',
            'revenue': 'Báo cáo doanh thu',
            'vehicle': 'Báo cáo phương tiện',
            'employee': 'Báo cáo nhân viên'
        };
        
        let summary = reportNames[reportType] || 'Báo cáo';
        
        if (startDate && endDate) {
            const start = new Date(startDate);
            const end = new Date(endDate);
            
            if (startDate === endDate) {
                summary += ` - ${start.toLocaleDateString('vi-VN')}`;
            } else {
                summary += ` - Từ ${start.toLocaleDateString('vi-VN')} đến ${end.toLocaleDateString('vi-VN')}`;
            }
        }
        
        summaryText.textContent = summary;
    }
    
