@model QuanLyBaiDoXe.ViewModels.ResetPasswordViewModel
@{
    ViewData["Title"] = "Đặt lại mật khẩu";
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/login.css" />
    <style>
        .password-requirements {
            font-size: 12px;
            margin-top: 8px;
        }
        .password-requirements .requirement {
            display: flex;
            align-items: center;
            gap: 6px;
            margin-bottom: 4px;
        }
        .password-requirements .requirement i {
            font-size: 10px;
        }
    </style>
</head>
<body>
    <div class="login-wrapper">
        <div class="login-left">
            <div class="overlay">
            </div>
        </div>
        <div class="login-right">
            <div class="content">
                <div class="text-center mb-4">
                    <i class="fas fa-check-circle fa-3x text-success"></i>
                </div>
                <h2 class="welcome">Đặt lại mật khẩu</h2>
                <p class="hint">Xác thực thành công! Nhập mật khẩu mới cho tài khoản</p>

                <div class="alert alert-success mb-3">
                    <i class="fas fa-envelope me-2"></i>
                    Tài khoản: <strong>@Model.Email</strong>
                </div>

                <form asp-action="ResetPassword" asp-controller="Account" method="post" class="login-form" id="resetPasswordForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Token" />
                    <input type="hidden" asp-for="Email" />
                    
                    <div class="mb-3">
                        <label class="form-label">Mật khẩu mới <span class="text-danger">*</span></label>
                        <div class="input d-flex align-items-center position-relative">
                            <span class="icon">🔒</span>
                            <input asp-for="NewPassword" class="form-control border-0" type="password" placeholder="Nhập mật khẩu mới" autofocus id="newPasswordField" />
                            <button type="button" class="btn btn-link btn-sm position-absolute" style="right: 5px; text-decoration: none;" onclick="togglePasswordVisibility('newPasswordField', 'newPasswordToggleIcon')">
                                <i class="fas fa-eye" id="newPasswordToggleIcon"></i>
                            </button>
                        </div>
                        <span asp-validation-for="NewPassword" class="text-danger"></span>
                        
                        <!-- Password strength indicator -->
                        <div class="mt-2">
                            <div class="progress" style="height: 4px;">
                                <div id="passwordStrengthBar" class="progress-bar" role="progressbar" style="width: 0%"></div>
                            </div>
                            <small id="passwordStrengthText" class="text-muted"></small>
                        </div>
                        
                        <!-- Password requirements -->
                        <div class="password-requirements">
                            <div class="text-muted mb-1"><strong>Mật khẩu phải có:</strong></div>
                            <div class="requirement text-muted" id="req-length">
                                <i class="fas fa-circle"></i> Ít nhất 8 ký tự
                            </div>
                            <div class="requirement text-muted" id="req-uppercase">
                                <i class="fas fa-circle"></i> Ít nhất 1 chữ in hoa (A-Z)
                            </div>
                            <div class="requirement text-muted" id="req-lowercase">
                                <i class="fas fa-circle"></i> Ít nhất 1 chữ thường (a-z)
                            </div>
                            <div class="requirement text-muted" id="req-number">
                                <i class="fas fa-circle"></i> Ít nhất 1 chữ số (0-9)
                            </div>
                            <div class="requirement text-muted" id="req-special">
                                <i class="fas fa-circle"></i> Ít nhất 1 ký tự đặc biệt (@@$!%*?&amp;#...)
                            </div>
                        </div>
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label">Xác nhận mật khẩu <span class="text-danger">*</span></label>
                        <div class="input d-flex align-items-center position-relative">
                            <span class="icon">🔒</span>
                            <input asp-for="ConfirmPassword" class="form-control border-0" type="password" placeholder="Nhập lại mật khẩu mới" id="confirmPasswordField" />
                            <button type="button" class="btn btn-link btn-sm position-absolute" style="right: 5px; text-decoration: none;" onclick="togglePasswordVisibility('confirmPasswordField', 'confirmPasswordToggleIcon')">
                                <i class="fas fa-eye" id="confirmPasswordToggleIcon"></i>
                            </button>
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                        <div id="passwordMatch" class="mt-2"></div>
                    </div>
                    
                    <button type="submit" class="btn btn-primary w-100" id="submitBtn">
                        <i class="fas fa-save me-2"></i>Đặt lại mật khẩu
                    </button>

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger mt-3" role="alert">
                            @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                            {
                                <div>@err.ErrorMessage</div>
                            }
                        </div>
                    }
                </form>

                <div class="text-center mt-3">
                    <small class="text-muted">
                        Hệ thống Quản lý Bãi Đỗ Xe - &copy; 2024
                    </small>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    
    <script>
        $(document).ready(function () {
            // Password validation functions
            function checkPasswordRequirements(password) {
                const requirements = {
                    length: password.length >= 8,
                    uppercase: /[A-Z]/.test(password),
                    lowercase: /[a-z]/.test(password),
                    number: /\d/.test(password),
                    special: /[@@$!%*?&#^()_\-+=~`{}\[\]:;"'<>,.\/\\|]/.test(password)
                };

                // Update requirement indicators
                updateRequirement('req-length', requirements.length);
                updateRequirement('req-uppercase', requirements.uppercase);
                updateRequirement('req-lowercase', requirements.lowercase);
                updateRequirement('req-number', requirements.number);
                updateRequirement('req-special', requirements.special);

                // Calculate strength
                const metCount = Object.values(requirements).filter(Boolean).length;
                let strength = 0;
                let strengthText = '';
                let strengthColor = '';

                if (metCount === 5) {
                    strength = 100;
                    strengthText = 'Mạnh';
                    strengthColor = '#28a745';
                } else if (metCount === 4) {
                    strength = 75;
                    strengthText = 'Khá tốt';
                    strengthColor = '#87DF2C';
                } else if (metCount === 3) {
                    strength = 50;
                    strengthText = 'Trung bình';
                    strengthColor = '#ffc107';
                } else if (metCount > 0) {
                    strength = 25;
                    strengthText = 'Yếu';
                    strengthColor = '#dc3545';
                }

                $('#passwordStrengthBar').css('width', strength + '%').css('background-color', strengthColor);
                $('#passwordStrengthText').text(strengthText).css('color', strengthColor);

                return Object.values(requirements).every(Boolean);
            }

            function updateRequirement(id, met) {
                const element = $('#' + id);
                if (met) {
                    element.removeClass('text-muted').addClass('text-success');
                    element.find('i').removeClass('fa-circle').addClass('fa-check-circle');
                } else {
                    element.removeClass('text-success').addClass('text-muted');
                    element.find('i').removeClass('fa-check-circle').addClass('fa-circle');
                }
            }

            function checkPasswordMatch() {
                const password = $('#newPasswordField').val();
                const confirmPassword = $('#confirmPasswordField').val();
                const matchDiv = $('#passwordMatch');

                if (confirmPassword.length > 0) {
                    if (password === confirmPassword) {
                        matchDiv.html('<small class="text-success"><i class="fas fa-check-circle"></i> Mật khẩu khớp</small>');
                    } else {
                        matchDiv.html('<small class="text-danger"><i class="fas fa-times-circle"></i> Mật khẩu không khớp</small>');
                    }
                } else {
                    matchDiv.html('');
                }
            }

            // Password field validation
            $('#newPasswordField').on('input', function () {
                const password = $(this).val();
                checkPasswordRequirements(password);
                checkPasswordMatch();
            });

            $('#confirmPasswordField').on('input', function () {
                checkPasswordMatch();
            });

            // Form validation
            $('#resetPasswordForm').on('submit', function (e) {
                const password = $('#newPasswordField').val();
                const confirmPassword = $('#confirmPasswordField').val();

                // Check password requirements
                if (!checkPasswordRequirements(password)) {
                    e.preventDefault();
                    alert('Mật khẩu chưa đáp ứng đủ các yêu cầu. Vui lòng kiểm tra lại.');
                    return false;
                }

                // Check password match
                if (password !== confirmPassword) {
                    e.preventDefault();
                    alert('Mật khẩu xác nhận không khớp. Vui lòng kiểm tra lại.');
                    return false;
                }

                $('#submitBtn').prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-2"></span>Đang xử lý...');
            });
        });

        // Toggle password visibility function
        function togglePasswordVisibility(fieldId, iconId) {
            const field = document.getElementById(fieldId);
            const icon = document.getElementById(iconId);
            
            if (field.type === 'password') {
                field.type = 'text';
                icon.classList.remove('fa-eye');
                icon.classList.add('fa-eye-slash');
            } else {
                field.type = 'password';
                icon.classList.remove('fa-eye-slash');
                icon.classList.add('fa-eye');
            }
        }
    </script>
</body>
</html>
