@model QuanLyBaiDoXe.Areas.Admin.ViewModels.VehicleUserViewModel
@{
    ViewData["Title"] = "Chỉnh sửa người dùng";
}

<!-- Page Header -->
<div class="page-header">
    <div>
        <h1 class="page-title">Chỉnh sửa người dùng</h1>
        <div class="breadcrumb">
            <a href="@Url.Action("Index", "Dashboard", new { area = "Admin" })">Trang chủ</a>
            <span>/</span>
            <a href="@Url.Action("Index")">Quản lý người dùng</a>
            <span>/</span>
            <span>Chỉnh sửa</span>
        </div>
    </div>
    <div>
        <a href="@Url.Action("Index")" class="btn-secondary-admin">
            <i class="fas fa-arrow-left"></i>
            Quay lại
        </a>
    </div>
</div>

<!-- Form Card -->
<div class="admin-card">
    <div class="admin-card-header">
        <h3 class="admin-card-title">Thông tin người dùng</h3>
    </div>
    <div class="admin-card-body">
        <form asp-action="Edit" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="MaTaiKhoan" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="TenDangNhap" class="form-label">
                        <i class="fas fa-user"></i> Tên đăng nhập <span class="text-danger">*</span>
                    </label>
                    <input asp-for="TenDangNhap" class="form-control" placeholder="Nhập tên đăng nhập" />
                    <span asp-validation-for="TenDangNhap" class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="Email" class="form-label">
                        <i class="fas fa-envelope"></i> Email
                    </label>
                    <input asp-for="Email" class="form-control" placeholder="Nhập email" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
            </div>

            <div class="alert alert-warning">
                <i class="fas fa-exclamation-triangle"></i>
                <strong>Lưu ý:</strong> Chỉ nhập mật khẩu mới nếu bạn muốn thay đổi mật khẩu. Để trống nếu không muốn thay đổi.
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="MatKhau" class="form-label">
                        <i class="fas fa-lock"></i> Mật khẩu mới (tùy chọn)
                    </label>
                    <div class="input-group">
                        <input asp-for="MatKhau" type="password" class="form-control" placeholder="Để trống nếu không đổi mật khẩu" id="password" />
                        <button class="btn btn-outline-secondary" type="button" onclick="VehicleUser.togglePassword('password')">
                            <i class="fas fa-eye" id="password-icon"></i>
                        </button>
                    </div>
                    <span asp-validation-for="MatKhau" class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="XacNhanMatKhau" class="form-label">
                        <i class="fas fa-lock"></i> Xác nhận mật khẩu mới
                    </label>
                    <div class="input-group">
                        <input asp-for="XacNhanMatKhau" type="password" class="form-control" placeholder="Nhập lại mật khẩu mới" id="confirmPassword" />
                        <button class="btn btn-outline-secondary" type="button" onclick="VehicleUser.togglePassword('confirmPassword')">
                            <i class="fas fa-eye" id="confirmPassword-icon"></i>
                        </button>
                    </div>
                    <span asp-validation-for="XacNhanMatKhau" class="text-danger"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="QuyenHan" class="form-label">
                        <i class="fas fa-user-shield"></i> Quyền hạn <span class="text-danger">*</span>
                    </label>
                    <select asp-for="QuyenHan" class="form-select">
                        <option value="">-- Chọn quyền hạn --</option>
                        <option value="Admin">Admin</option>
                        <option value="Nhân viên">Nhân viên</option>
                        <option value="Khách hàng">Khách hàng</option>
                    </select>
                    <span asp-validation-for="QuyenHan" class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="TrangThai" class="form-label">
                        <i class="fas fa-toggle-on"></i> Trạng thái
                    </label>
                    <div class="form-check form-switch">
                        <input asp-for="TrangThai" class="form-check-input" type="checkbox" />
                        <label class="form-check-label" asp-for="TrangThai">
                            Kích hoạt tài khoản
                        </label>
                    </div>
                </div>
            </div>

            <div class="alert alert-info">
                <i class="fas fa-info-circle"></i>
                <strong>Phân quyền:</strong> 
                <ul class="mb-0 mt-2">
                    <li><strong>Admin:</strong> Có toàn quyền quản lý hệ thống</li>
                    <li><strong>Nhân viên:</strong> Quản lý vận hành bãi xe, soát vé</li>
                    <li><strong>Khách hàng:</strong> Sử dụng dịch vụ gửi xe, đặt chỗ</li>
                </ul>
            </div>

            <hr class="my-4" />

            <div class="text-end">
                <a href="@Url.Action("Index")" class="btn-secondary-admin">
                    <i class="fas fa-times"></i> Hủy
                </a>
                <button type="submit" class="btn-primary-admin">
                    <i class="fas fa-save"></i> Cập nhật
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        const VehicleUser = {
            togglePassword: function(fieldId) {
                const field = document.getElementById(fieldId);
                const icon = document.getElementById(fieldId + '-icon');
                
                if (field.type === 'password') {
                    field.type = 'text';
                    icon.classList.remove('fa-eye');
                    icon.classList.add('fa-eye-slash');
                } else {
                    field.type = 'password';
                    icon.classList.remove('fa-eye-slash');
                    icon.classList.add('fa-eye');
                }
            }
        };
    </script>
}
