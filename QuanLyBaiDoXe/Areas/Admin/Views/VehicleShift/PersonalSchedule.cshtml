@model QuanLyBaiDoXe.Areas.Admin.ViewModels.PersonalScheduleViewModel

@{
    ViewData["Title"] = "L?ch cá nhân - " + Model.Employee.HoTen;
    var currentDate = DateTime.Today;
}

<!-- Page Header -->
<div class="page-header">
    <div>
        <h1 class="page-title">
            <i class="fas fa-calendar-week"></i>
            L?ch cá nhân - @Model.Employee.HoTen
        </h1>
        <div class="breadcrumb">
            <a href="@Url.Action("Index", "Dashboard", new { area = "Admin" })">Trang ch?</a>
            <span>/</span>
            <a href="@Url.Action("Index", "VehicleShift", new { area = "Admin" })">Ca làm vi?c</a>
            <span>/</span>
            <a href="@Url.Action("EmployeeList", "VehicleShift", new { area = "Admin" })">Nhân viên</a>
            <span>/</span>
            <span>L?ch cá nhân</span>
        </div>
    </div>
    <div class="page-header-actions">
        <button class="btn-secondary-admin" onclick="navigateWeek(-1)">
            <i class="fas fa-chevron-left"></i>
            Tu?n tr??c
        </button>
        <button class="btn-primary-admin" onclick="navigateWeek(0)">
            <i class="fas fa-calendar-day"></i>
            Tu?n này
        </button>
        <button class="btn-secondary-admin" onclick="navigateWeek(1)">
            Tu?n sau
            <i class="fas fa-chevron-right"></i>
        </button>
    </div>
</div>

<!-- Employee Info Card -->
<div class="admin-card">
    <div class="admin-card-body">
        <div class="employee-info-header">
            <div class="employee-avatar-xlarge">
                @Model.Employee.HoTen.Substring(0, 1)
            </div>
            <div class="employee-info-details">
                <h3>@Model.Employee.HoTen</h3>
                <p class="employee-id">Mã NV: <strong>@("NV" + Model.Employee.MaNhanVien.ToString("D4"))</strong></p>
                <div class="employee-meta">
                    <span class="badge badge-primary">@Model.Employee.ChucVuText</span>
                    @if (Model.Employee.TrangThaiLamViec)
                    {
                        <span class="badge badge-success"><i class="fas fa-circle"></i> ?ang làm vi?c</span>
                    }
                    else
                    {
                        <span class="badge badge-secondary"><i class="fas fa-circle"></i> ?ã ngh? vi?c</span>
                    }
                </div>
                @if (!string.IsNullOrEmpty(Model.Employee.SoDienThoai))
                {
                    <p class="employee-contact"><i class="fas fa-phone"></i> @Model.Employee.SoDienThoai</p>
                }
            </div>
            <div class="week-info">
                <h4>Tu?n @GetWeekNumber(Model.WeekStart)</h4>
                <p class="week-range">
                    @Model.WeekStart.ToString("dd/MM/yyyy") - @Model.WeekEnd.ToString("dd/MM/yyyy")
                </p>
            </div>
        </div>
    </div>
</div>

<!-- Stats Cards -->
<div class="stat-cards">
    <div class="stat-card">
        <div class="stat-card-icon blue">
            <i class="fas fa-calendar-check"></i>
        </div>
        <div class="stat-card-info">
            <h3>@Model.TotalScheduledShifts</h3>
            <p>Ca ?ã x?p l?ch</p>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-card-icon green">
            <i class="fas fa-user-clock"></i>
        </div>
        <div class="stat-card-info">
            <h3>@Model.TotalActualShifts</h3>
            <p>Ca ?ã làm</p>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-card-icon orange">
            <i class="fas fa-clock"></i>
        </div>
        <div class="stat-card-info">
            <h3>@Model.TotalWorkHours.ToString("F1")h</h3>
            <p>T?ng gi? làm</p>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-card-icon teal">
            <i class="fas fa-money-bill-wave"></i>
        </div>
        <div class="stat-card-info">
            <h3>@(Model.TotalRevenue >= 1000000 ? $"{(Model.TotalRevenue / 1000000):F1}M" : Model.TotalRevenue.ToString("N0"))</h3>
            <p>Doanh thu tu?n</p>
        </div>
    </div>
</div>

<!-- Weekly Schedule Calendar -->
<div class="admin-card">
    <div class="admin-card-header">
        <h3 class="admin-card-title">L?ch làm vi?c trong tu?n</h3>
    </div>
    <div class="admin-card-body">
        <div class="weekly-calendar">
            @for (int i = 0; i < 7; i++)
            {
                var date = Model.WeekStart.AddDays(i);
                var isToday = date.Date == currentDate;
                var scheduledShift = Model.ScheduledShifts.FirstOrDefault(s => s.NgayLamViec.HasValue && s.NgayLamViec.Value.ToDateTime(TimeOnly.MinValue) == date);
                var actualShifts = Model.ActualShifts.Where(s => s.ThoiGianNhanCa.HasValue && s.ThoiGianNhanCa.Value.Date == date).ToList();
                var hasSchedule = scheduledShift != null;
                var hasActual = actualShifts.Any();

                <div class="day-card @(isToday ? "today" : "") @(hasSchedule ? "has-schedule" : "")">
                    <div class="day-card-header">
                        <div class="day-name">@date.ToString("dddd", new System.Globalization.CultureInfo("vi-VN"))</div>
                        <div class="day-date">@date.ToString("dd/MM")</div>
                        @if (isToday)
                        {
                            <span class="badge badge-primary badge-sm">Hôm nay</span>
                        }
                    </div>
                    <div class="day-card-body">
                        @if (hasSchedule)
                        {
                            <div class="scheduled-shift">
                                <div class="shift-icon">
                                    <i class="fas fa-calendar-alt"></i>
                                </div>
                                <div class="shift-info">
                                    <strong>@scheduledShift.TenCa</strong>
                                    @if (!string.IsNullOrEmpty(scheduledShift.GhiChu))
                                    {
                                        <p class="shift-note">@scheduledShift.GhiChu</p>
                                    }
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="no-schedule">
                                <i class="fas fa-calendar-times"></i>
                                <p>Không có l?ch</p>
                            </div>
                        }

                        @if (hasActual)
                        {
                            <div class="actual-shifts">
                                <div class="section-title">
                                    <i class="fas fa-check-circle text-success"></i>
                                    <span>?ã làm</span>
                                </div>
                                @foreach (var shift in actualShifts)
                                {
                                    <div class="shift-item @(shift.TrangThaiCa == 1 ? "completed" : "active")">
                                        <div class="shift-time">
                                            <i class="fas fa-clock"></i>
                                            @shift.ThoiGianNhanCa?.ToString("HH:mm") 
                                            @if (shift.ThoiGianGiaoCa.HasValue)
                                            {
                                                <span>- @shift.ThoiGianGiaoCa?.ToString("HH:mm")</span>
                                            }
                                            else
                                            {
                                                <span class="badge badge-warning badge-sm">?ang tr?c</span>
                                            }
                                        </div>
                                        <div class="shift-stats">
                                            <span><i class="fas fa-hourglass-half"></i> @shift.SoGioLam.ToString("F1")h</span>
                                            @if (shift.TrangThaiCa == 1)
                                            {
                                                <span><i class="fas fa-money-bill"></i> @shift.TongTienHeThong.ToString("N0") VN?</span>
                                            }
                                        </div>
                                        @if (!string.IsNullOrEmpty(shift.GhiChuBanGiao))
                                        {
                                            <p class="shift-note-small">@shift.GhiChuBanGiao</p>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<!-- Shift History Table -->
<div class="admin-card">
    <div class="admin-card-header">
        <h3 class="admin-card-title">Chi ti?t các ca làm vi?c</h3>
    </div>
    <div class="admin-card-body">
        @if (Model.ActualShifts.Any())
        {
            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Ngày</th>
                            <th>Gi? nh?n ca</th>
                            <th>Gi? giao ca</th>
                            <th>S? gi?</th>
                            <th>Doanh thu</th>
                            <th>Tr?ng thái</th>
                            <th>Ghi chú</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var shift in Model.ActualShifts)
                        {
                            <tr>
                                <td>@shift.ThoiGianNhanCa?.ToString("dd/MM/yyyy")</td>
                                <td>@shift.ThoiGianNhanCa?.ToString("HH:mm")</td>
                                <td>
                                    @if (shift.ThoiGianGiaoCa.HasValue)
                                    {
                                        @shift.ThoiGianGiaoCa?.ToString("HH:mm")
                                    }
                                    else
                                    {
                                        <span class="text-muted">--:--</span>
                                    }
                                </td>
                                <td>@shift.SoGioLam.ToString("F1") gi?</td>
                                <td>@shift.TongTienHeThong.ToString("N0") VN?</td>
                                <td>
                                    @if (shift.TrangThaiCa == 0)
                                    {
                                        <span class="badge badge-warning">?ang tr?c</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-success">?ã ch?t</span>
                                    }
                                </td>
                                <td>@(shift.GhiChuBanGiao ?? "-")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-state">
                <i class="fas fa-calendar-times"></i>
                <p>Ch?a có ca làm vi?c nào trong tu?n này</p>
            </div>
        }
    </div>
</div>

@section Styles {
    <style>
        .employee-info-header {
            display: flex;
            align-items: center;
            gap: 20px;
        }

        .employee-avatar-xlarge {
            width: 80px;
            height: 80px;
            border-radius: 50%;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 32px;
            font-weight: bold;
            flex-shrink: 0;
        }

        .employee-info-details {
            flex: 1;
        }

        .employee-info-details h3 {
            margin: 0 0 5px 0;
            font-size: 24px;
            color: #2d3748;
        }

        .employee-id {
            margin: 0 0 10px 0;
            color: #718096;
            font-size: 14px;
        }

        .employee-meta {
            display: flex;
            gap: 8px;
            margin-bottom: 10px;
        }

        .employee-contact {
            margin: 5px 0 0 0;
            color: #4a5568;
            font-size: 14px;
        }

        .week-info {
            text-align: right;
        }

        .week-info h4 {
            margin: 0 0 5px 0;
            color: #2d3748;
            font-size: 20px;
        }

        .week-range {
            margin: 0;
            color: #718096;
            font-size: 14px;
        }

        .weekly-calendar {
            display: grid;
            grid-template-columns: repeat(7, 1fr);
            gap: 15px;
        }

        .day-card {
            background: white;
            border: 2px solid #e2e8f0;
            border-radius: 12px;
            overflow: hidden;
            transition: all 0.3s ease;
        }

        .day-card.today {
            border-color: #4299e1;
            box-shadow: 0 0 0 3px rgba(66, 153, 225, 0.1);
        }

        .day-card.has-schedule {
            border-color: #48bb78;
        }

        .day-card-header {
            background: #f7fafc;
            padding: 12px;
            text-align: center;
            border-bottom: 1px solid #e2e8f0;
        }

        .day-card.today .day-card-header {
            background: linear-gradient(135deg, #4299e1 0%, #3182ce 100%);
            color: white;
        }

        .day-name {
            font-weight: 600;
            font-size: 12px;
            text-transform: uppercase;
            margin-bottom: 4px;
        }

        .day-date {
            font-size: 18px;
            font-weight: bold;
        }

        .day-card-body {
            padding: 12px;
            min-height: 150px;
        }

        .scheduled-shift {
            display: flex;
            align-items: start;
            gap: 10px;
            padding: 10px;
            background: #f0fff4;
            border-left: 3px solid #48bb78;
            border-radius: 6px;
            margin-bottom: 10px;
        }

        .shift-icon {
            color: #48bb78;
            font-size: 18px;
        }

        .shift-info strong {
            display: block;
            color: #2d3748;
            font-size: 13px;
            margin-bottom: 4px;
        }

        .shift-note {
            margin: 0;
            color: #718096;
            font-size: 11px;
        }

        .no-schedule {
            text-align: center;
            padding: 20px 10px;
            color: #a0aec0;
        }

        .no-schedule i {
            font-size: 24px;
            margin-bottom: 8px;
            display: block;
        }

        .no-schedule p {
            margin: 0;
            font-size: 12px;
        }

        .actual-shifts {
            margin-top: 10px;
        }

        .section-title {
            display: flex;
            align-items: center;
            gap: 6px;
            font-size: 11px;
            font-weight: 600;
            color: #4a5568;
            margin-bottom: 8px;
            text-transform: uppercase;
        }

        .shift-item {
            padding: 8px;
            background: #edf2f7;
            border-radius: 6px;
            margin-bottom: 6px;
        }

        .shift-item.completed {
            background: #f0f9ff;
            border-left: 3px solid #3182ce;
        }

        .shift-item.active {
            background: #fef5e7;
            border-left: 3px solid #f59e0b;
        }

        .shift-time {
            font-size: 12px;
            font-weight: 600;
            color: #2d3748;
            margin-bottom: 4px;
        }

        .shift-time i {
            color: #718096;
            margin-right: 4px;
        }

        .shift-stats {
            display: flex;
            gap: 10px;
            font-size: 11px;
            color: #4a5568;
        }

        .shift-stats span {
            display: flex;
            align-items: center;
            gap: 4px;
        }

        .shift-note-small {
            margin: 6px 0 0 0;
            font-size: 10px;
            color: #718096;
            font-style: italic;
        }

        .badge-sm {
            font-size: 10px;
            padding: 2px 6px;
        }

        @@media (max-width: 1400px) {
            .weekly-calendar {
                grid-template-columns: repeat(4, 1fr);
            }
        }

        @@media (max-width: 992px) {
            .weekly-calendar {
                grid-template-columns: repeat(3, 1fr);
            }
        }

        @@media (max-width: 768px) {
            .weekly-calendar {
                grid-template-columns: repeat(2, 1fr);
            }

            .employee-info-header {
                flex-direction: column;
                text-align: center;
            }

            .week-info {
                text-align: center;
            }
        }

        @@media (max-width: 576px) {
            .weekly-calendar {
                grid-template-columns: 1fr;
            }
        }
    </style>
}

@section Scripts {
    <script>
        function navigateWeek(direction) {
            const currentStart = new Date('@Model.WeekStart.ToString("yyyy-MM-dd")');
            let newDate;

            if (direction === 0) {
                newDate = new Date();
            } else {
                newDate = new Date(currentStart);
                newDate.setDate(currentStart.getDate() + (direction * 7));
            }

            const employeeId = @Model.Employee.MaNhanVien;
            const url = '@Url.Action("PersonalSchedule", "VehicleShift", new { area = "Admin" })' +
                `?employeeId=${employeeId}&year=${newDate.getFullYear()}&month=${newDate.getMonth() + 1}&day=${newDate.getDate()}`;

            window.location.href = url;
        }
    </script>
}

@functions {
    int GetWeekNumber(DateTime date)
    {
        var culture = new System.Globalization.CultureInfo("vi-VN");
        var calendar = culture.Calendar;
        var dateTimeFormat = culture.DateTimeFormat;
        return calendar.GetWeekOfYear(date, dateTimeFormat.CalendarWeekRule, dateTimeFormat.FirstDayOfWeek);
    }
}
