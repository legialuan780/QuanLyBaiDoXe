    function updateChartStatistics(data) {
        // Find peak entry time
        const maxEntry = Math.max(...data.entry);
        const peakEntryIndex = data.entry.indexOf(maxEntry);
        document.getElementById('peakEntryTime').textContent = data.labels[peakEntryIndex];
        document.getElementById('peakEntryCount').textContent = maxEntry + ' xe';

        // Find peak exit time
        const maxExit = Math.max(...data.exit);
        const peakExitIndex = data.exit.indexOf(maxExit);
        document.getElementById('peakExitTime').textContent = data.labels[peakExitIndex];
        document.getElementById('peakExitCount').textContent = maxExit + ' xe';

        // Calculate average occupancy
        const avgOcc = Math.round(data.occupancy.reduce((a, b) => a + b, 0) / data.occupancy.length / 80 * 100);
        document.getElementById('avgOccupancy').textContent = avgOcc + '%';

        // Calculate total vehicles
        const totalVehicles = data.entry.reduce((a, b) => a + b, 0);
        document.getElementById('totalVehicles').textContent = totalVehicles;
    }

