    function filterEmployees() {
            const position = $('#filterPosition').val();
            const status = $('#filterStatus').val();
            
            $('.employee-card').each(function() {
                const cardPosition = $(this).data('position').toString();
                const cardStatus = $(this).data('status');
                
                let showCard = true;
                
                if (position && cardPosition !== position) {
                    showCard = false;
                }
                
                if (status && cardStatus !== status) {
                    showCard = false;
                }
                
                if (showCard) {
                    $(this).show();
                } else {
                    $(this).hide();
                }
            });
        }

        function searchEmployees() {
            const searchText = $('#searchEmployee').val().toLowerCase();
            
            $('.employee-card').each(function() {
                const searchData = $(this).data('search');
                
                if (searchData.includes(searchText)) {
                    $(this).show();
                } else {
                    $(this).hide();
                }
            });
        }

        // Thêm nhân viên mới
        function createEmployee() {
            // Validate form
            if (!$('#addEmployeeForm')[0].checkValidity()) {
                $('#addEmployeeForm')[0].reportValidity();
                return;
            }

            // Prepare data
            const formData = {
                HoTen: $('#addHoTen').val().trim(),
                ChucVu: parseInt($('#addChucVu').val()),
                GioiTinh: $('#addGioiTinh').val() || null,
                SoDienThoai: $('#addSoDienThoai').val() || null,
                DiaChi: $('#addDiaChi').val() || null,
                NgaySinh: $('#addNgaySinh').val() || null,
                NgayVaoLam: $('#addNgayVaoLam').val() || null,
                TrangThaiLamViec: $('#addTrangThaiLamViec').is(':checked')
            };

            // Validate required fields
            if (!formData.HoTen) {
                alert('Vui lòng nhập họ tên nhân viên!');
                return;
            }

            if (!formData.ChucVu && formData.ChucVu !== 0) {
                alert('Vui lòng chọn chức vụ!');
                return;
            }

            // Confirm before save
            if (!confirm('Bạn có chắc chắn muốn thêm nhân viên này?')) {
                return;
            }

            // Show loading
            const saveBtn = $('button[onclick="createEmployee()"]');
            const originalText = saveBtn.html();
            saveBtn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Đang thêm...');

            // Send AJAX request
            $.ajax({
                url: '@Url.Action("CreateEmployee", "VehicleShift", new { area = "Admin" })',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(formData),
                success: function(response) {
                    saveBtn.prop('disabled', false).html(originalText);
                    
                    if (response.success) {
                        alert(response.message);
                        $('#addEmployeeModal').modal('hide');
                        location.reload(); // Reload để cập nhật danh sách
                    } else {
                        alert('Lỗi: ' + response.message);
