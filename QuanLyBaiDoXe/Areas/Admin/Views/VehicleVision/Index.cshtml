        // Call API to generate report
        const reportData = {
            reportType: reportType,
            startDate: startDate,
            endDate: endDate,
            exportFormat: exportFormat,
            options: options
        };
        
        // Simulate API call
        setTimeout(() => {
            // In real implementation, call actual API
            fetch('@Url.Action("GenerateReport", "VehicleVision", new { area = "Admin" })', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(reportData)
            })
            .then(response => response.blob())
            .then(blob => {
                // Create download link
                const url = window.URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.href = url;
                
                const fileExtension = {
                    'pdf': 'pdf',
                    'excel': 'xlsx',
                    'word': 'docx'
                };
                
                a.download = `BaoCao_BaiDoXe_${new Date().getTime()}.${fileExtension[exportFormat]}`;
                document.body.appendChild(a);
                a.click();
                document.body.removeChild(a);
                window.URL.revokeObjectURL(url);
                
                showNotification('success', 'Thành công', 'Báo cáo đã được tải xuống');
                
                // Close modal
                const modal = bootstrap.Modal.getInstance(document.getElementById('reportModal'));
                if (modal) {
                    modal.hide();
                }
            })
            .catch(error => {
                console.error('Error generating report:', error);
                showNotification('error', 'Lỗi', 'Không thể tạo báo cáo: ' + error.message);
            });
        }, 1500);
    }

</script>
