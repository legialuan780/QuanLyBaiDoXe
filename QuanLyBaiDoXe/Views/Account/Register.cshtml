@model QuanLyBaiDoXe.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Register";
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/login.css" />
    <style>
        .form-control.is-invalid { border-color: #dc3545; }
        .form-control.is-valid { border-color: #28a745; }
        
        .validation-icon {
            position: absolute;
            right: 10px;
            top: 50%;
            transform: translateY(-50%);
            display: none;
            font-size: 14px;
        }
        
        .input-wrapper { position: relative; }
        .spinner-border-sm { width: 0.9rem; height: 0.9rem; }

        .info-box {
            background: #e7f3ff;
            border-left: 4px solid #2196F3;
            padding: 12px 15px;
            margin-bottom: 20px;
            border-radius: 4px;
        }

        .info-box p {
            margin: 0;
            font-size: 13px;
            color: #0d47a1;
        }
    </style>
</head>
<body>
    <div class="login-wrapper">
        <div class="login-left">
            <div class="overlay">
             
            </div>
        </div>
        <div class="login-right register-right">
            <div class="content">
                <br />
                <h2 class="welcome">Đăng ký tài khoản</h2>
                <p class="hint">Tạo tài khoản khách hàng mới</p>

                <div class="info-box">
                    <p>👤 Bạn đang đăng ký tài khoản <strong>KHÁCH HÀNG</strong> để sử dụng dịch vụ gửi xe</p>
                </div>

                <form asp-action="Register" asp-controller="Account" method="post" class="login-form" id="registerForm">
                    @Html.AntiForgeryToken()

                    <div class="row">
                        <!-- Tên đăng nhập -->
                        <div class="col-12 mb-3">
                            <label asp-for="Username" class="form-label">Tên đăng nhập <span class="text-danger">*</span></label>
                            <div class="input-wrapper">
                                <div class="input d-flex align-items-center">
                                    <span class="icon">👤</span>
                                    <input asp-for="Username" class="form-control border-0" placeholder="Nhập tên đăng nhập" />
                                    <span class="validation-icon" id="usernameIcon"></span>
                                </div>
                            </div>
                            <span asp-validation-for="Username" class="text-danger small"></span>
                        </div>

                        <!-- Email -->
                        <div class="col-12 mb-3">
                            <label asp-for="Email" class="form-label">Email <span class="text-danger">*</span></label>
                            <div class="input-wrapper">
                                <div class="input d-flex align-items-center">
                                    <span class="icon">📧</span>
                                    <input asp-for="Email" class="form-control border-0" type="email" placeholder="example@email.com" />
                                    <span class="validation-icon" id="emailIcon"></span>
                                </div>
                            </div>
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <!-- Mật khẩu -->
                        <div class="col-md-6 mb-3">
                            <label asp-for="Password" class="form-label">Mật khẩu <span class="text-danger">*</span></label>
                            <div class="input d-flex align-items-center">
                                <span class="icon">🔒</span>
                                <input asp-for="Password" class="form-control border-0" type="password" placeholder="********" />
                            </div>
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <!-- Xác nhận mật khẩu -->
                        <div class="col-md-6 mb-3">
                            <label asp-for="ConfirmPassword" class="form-label">Xác nhận mật khẩu <span class="text-danger">*</span></label>
                            <div class="input d-flex align-items-center">
                                <span class="icon">🔒</span>
                                <input asp-for="ConfirmPassword" class="form-control border-0" type="password" placeholder="********" />
                            </div>
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>

                        <!-- Họ tên -->
                        <div class="col-12 mb-3">
                            <label asp-for="FullName" class="form-label">Họ và tên <span class="text-danger">*</span></label>
                            <div class="input d-flex align-items-center">
                                <span class="icon">📝</span>
                                <input asp-for="FullName" class="form-control border-0" placeholder="Nguyễn Văn A" />
                            </div>
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>

                        <!-- Số điện thoại -->
                        <div class="col-md-6 mb-3">
                            <label asp-for="PhoneNumber" class="form-label">Số điện thoại <span class="text-danger">*</span></label>
                            <div class="input-wrapper">
                                <div class="input d-flex align-items-center">
                                    <span class="icon">📱</span>
                                    <input asp-for="PhoneNumber" class="form-control border-0" placeholder="0912345678" />
                                    <span class="validation-icon" id="phoneIcon"></span>
                                </div>
                            </div>
                            <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                        </div>

                        <!-- CCCD -->
                        <div class="col-md-6 mb-3">
                            <label asp-for="CCCD" class="form-label">CCCD/CMND</label>
                            <div class="input-wrapper">
                                <div class="input d-flex align-items-center">
                                    <span class="icon">🪪</span>
                                    <input asp-for="CCCD" class="form-control border-0" placeholder="001234567890" />
                                    <span class="validation-icon" id="cccdIcon"></span>
                                </div>
                            </div>
                            <span asp-validation-for="CCCD" class="text-danger small"></span>
                        </div>

                        <!-- Địa chỉ -->
                        <div class="col-12 mb-3">
                            <label asp-for="Address" class="form-label">Địa chỉ</label>
                            <div class="input d-flex align-items-center">
                                <span class="icon">🏠</span>
                                <input asp-for="Address" class="form-control border-0" placeholder="123 Đường ABC, Quận XYZ" />
                            </div>
                            <span asp-validation-for="Address" class="text-danger small"></span>
                        </div>

                        <!-- Biển số xe -->
                        <div class="col-12 mb-3">
                            <label asp-for="LicensePlate" class="form-label">Biển số xe mặc định</label>
                            <div class="input d-flex align-items-center">
                                <span class="icon">🚗</span>
                                <input asp-for="LicensePlate" class="form-control border-0" placeholder="29A-12345" />
                            </div>
                            <span asp-validation-for="LicensePlate" class="text-danger small"></span>
                            <small class="text-muted d-block mt-1" style="font-size: 11px;">Có thể để trống và cập nhật sau</small>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary w-100" id="submitBtn">ĐĂNG KÝ</button>

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger mt-2" role="alert">
                            @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                            {
                                <div>@err.ErrorMessage</div>
                            }
                        </div>
                    }
                </form>

                <div class="register text-center">
                    Đã có tài khoản? <a asp-controller="Account" asp-action="Login">Đăng nhập ngay</a>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>

    <script>
        $(document).ready(function () {
            let usernameTimeout;
            let emailTimeout;
            let phoneTimeout;
            let cccdTimeout;

            // Kiểm tra tên đăng nhập
            $('#Username').on('input', function () {
                clearTimeout(usernameTimeout);
                const username = $(this).val().trim();
                const icon = $('#usernameIcon');

                if (username.length < 3) {
                    icon.hide();
                    return;
                }

                icon.html('<span class="spinner-border spinner-border-sm text-primary"></span>').show();

                usernameTimeout = setTimeout(function () {
                    $.ajax({
                        url: '@Url.Action("CheckUsername", "Account")',
                        type: 'GET',
                        data: { username: username },
                        success: function (response) {
                            if (response.available) {
                                icon.html('<span class="text-success">✓</span>');
                                $('#Username').removeClass('is-invalid').addClass('is-valid');
                            } else {
                                icon.html('<span class="text-danger">✗</span>');
                                $('#Username').removeClass('is-valid').addClass('is-invalid');
                            }
                        },
                        error: function () {
                            icon.hide();
                        }
                    });
                }, 500);
            });

            // Kiểm tra email
            $('#Email').on('input', function () {
                clearTimeout(emailTimeout);
                const email = $(this).val().trim();
                const icon = $('#emailIcon');

                // Check if email field is valid using HTML5 validation
                if (!this.validity.valid || email.length < 5) {
                    icon.hide();
                    return;
                }

                icon.html('<span class="spinner-border spinner-border-sm text-primary"></span>').show();

                emailTimeout = setTimeout(function () {
                    $.ajax({
                        url: '@Url.Action("CheckEmail", "Account")',
                        type: 'GET',
                        data: { email: email },
                        success: function (response) {
                            if (response.available) {
                                icon.html('<span class="text-success">✓</span>');
                                $('#Email').removeClass('is-invalid').addClass('is-valid');
                            } else {
                                icon.html('<span class="text-danger">✗</span>');
                                $('#Email').removeClass('is-valid').addClass('is-invalid');
                            }
                        },
                        error: function () {
                            icon.hide();
                        }
                    });
                }, 500);
            });

            // Kiểm tra số điện thoại
            $('#PhoneNumber').on('input', function () {
                clearTimeout(phoneTimeout);
                const phone = $(this).val().trim();
                const icon = $('#phoneIcon');

                if (phone.length < 10) {
                    icon.hide();
                    return;
                }

                icon.html('<span class="spinner-border spinner-border-sm text-primary"></span>').show();

                phoneTimeout = setTimeout(function () {
                    $.ajax({
                        url: '@Url.Action("CheckPhoneNumber", "Account")',
                        type: 'GET',
                        data: { phoneNumber: phone },
                        success: function (response) {
                            if (response.available) {
                                icon.html('<span class="text-success">✓</span>');
                                $('#PhoneNumber').removeClass('is-invalid').addClass('is-valid');
                            } else {
                                icon.html('<span class="text-danger">✗</span>');
                                $('#PhoneNumber').removeClass('is-valid').addClass('is-invalid');
                            }
                        },
                        error: function () {
                            icon.hide();
                        }
                    });
                }, 500);
            });

            // Kiểm tra CCCD
            $('#CCCD').on('input', function () {
                clearTimeout(cccdTimeout);
                const cccd = $(this).val().trim();
                const icon = $('#cccdIcon');

                if (cccd.length < 9) {
                    icon.hide();
                    return;
                }

                icon.html('<span class="spinner-border spinner-border-sm text-primary"></span>').show();

                cccdTimeout = setTimeout(function () {
                    $.ajax({
                        url: '@Url.Action("CheckCCCD", "Account")',
                        type: 'GET',
                        data: { cccd: cccd },
                        success: function (response) {
                            if (response.available) {
                                icon.html('<span class="text-success">✓</span>');
                                $('#CCCD').removeClass('is-invalid').addClass('is-valid');
                            } else {
                                icon.html('<span class="text-danger">✗</span>');
                                $('#CCCD').removeClass('is-valid').addClass('is-invalid');
                            }
                        },
                        error: function () {
                            icon.hide();
                        }
                    });
                }, 500);
            });

            // Chuyển biển số xe thành chữ hoa
            $('#LicensePlate').on('input', function () {
                $(this).val($(this).val().toUpperCase());
            });

            // Form validation
            $('#registerForm').on('submit', function (e) {
                if (!$(this).valid()) {
                    e.preventDefault();
                    return false;
                }

                $('#submitBtn').prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-2"></span>Đang xử lý...');
            });
        });
    </script>
</body>
</html>
